<%
  const fecha = (d) => new Date(d).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' });
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-slate-100">
  <%- include('../partials/nav') %>

  <main class="max-w-3xl mx-auto px-4 py-8">
    <%- include('../partials/flash') %>

    <a href="/riesgos" class="text-sm text-indigo-600 hover:underline">&larr; Volver al listado</a>

    <div class="mt-2 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-800"><%= riesgo.amenaza %></h1>
        <p class="mt-1 text-sm text-slate-500">
          Actividad: <a href="/rat/<%= riesgo.actividad.id %>" class="text-indigo-600 hover:underline"><%= riesgo.actividad.nombre %></a>
        </p>
      </div>
      <div class="flex gap-2">
        <a href="/riesgos/<%= riesgo.id %>/editar" class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">Editar</a>
        <% if (user.rol === 'ADMIN') { %>
          <form action="/riesgos/<%= riesgo.id %>/eliminar" method="POST"
                onsubmit="return confirm('¿Eliminar este riesgo? Esta acción no se puede deshacer.')">
            <button type="submit" class="rounded-lg border border-red-300 bg-white px-4 py-2 text-red-600 hover:bg-red-50 transition">Eliminar</button>
          </form>
        <% } %>
      </div>
    </div>

    <section class="mt-6 bg-white rounded-2xl shadow p-6">
      <h2 class="text-lg font-semibold text-slate-800">Valoración</h2>
      <dl class="mt-4 grid gap-4 sm:grid-cols-3">
        <div>
          <dt class="text-sm font-medium text-slate-500">Probabilidad</dt>
          <dd class="mt-1 text-slate-800"><%= probabilidades[riesgo.probabilidad] %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-500">Impacto</dt>
          <dd class="mt-1 text-slate-800"><%= impactos[riesgo.impacto] %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-500">Nivel de riesgo</dt>
          <dd class="mt-1"><%- include('../partials/nivel-badge', { nivel: riesgo.nivel_riesgo, nivelEtiquetas: niveles }) %></dd>
        </div>
      </dl>
    </section>

    <section class="mt-6 bg-white rounded-2xl shadow p-6">
      <h2 class="text-lg font-semibold text-slate-800">Medidas mitigadoras</h2>
      <p class="mt-3 whitespace-pre-line <%= riesgo.medidas_mitigadoras ? 'text-slate-800' : 'text-slate-400 italic' %>"><%= riesgo.medidas_mitigadoras || 'Sin medidas definidas todavía.' %></p>
    </section>

    <p class="mt-6 text-xs text-slate-400">
      Creado el <%= fecha(riesgo.created_at) %> · Última modificación el <%= fecha(riesgo.updated_at) %>
    </p>
  </main>
</body>
</html>
