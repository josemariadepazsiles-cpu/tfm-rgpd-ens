<%
  // Construye la query string omitiendo los parámetros vacíos
  const qs = (p) => { const u = new URLSearchParams(Object.entries(p).filter(([, v]) => v)).toString(); return u ? '?' + u : ''; };
  const filtros = [{ valor: '', texto: 'Todos', total }].concat(
    Object.entries(niveles).map(([valor, texto]) => ({ valor, texto, total: totales[valor] }))
  );
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Riesgos' }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">Evaluación de riesgos</h1>
        <p class="subtitulo-pagina">Riesgos asociados a las actividades de tratamiento</p>
      </div>
      <a href="/riesgos/nuevo" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Nuevo riesgo
      </a>
    </div>

    <div class="mt-6">
      <%- include('../partials/filtro-sistema', { accion: '/riesgos', sistemas, sistema, conservar: { nivel } }) %>
    </div>

    <nav class="mt-4 flex flex-wrap gap-2" aria-label="Filtrar por nivel de riesgo">
      <% filtros.forEach((f) => { %>
        <a href="/riesgos<%= qs({ nivel: f.valor, sistema }) %>"
           class="rounded-full px-3 py-1 text-sm ring-1 ring-inset <%= nivel === f.valor ? (f.valor ? nivelClases[f.valor] + ' font-semibold' : 'bg-indigo-600 text-white ring-indigo-600') : 'bg-white text-slate-600 ring-slate-300 hover:bg-slate-50' %>">
          <%= f.texto %> <span class="opacity-70">(<%= f.total %>)</span>
        </a>
      <% }) %>
    </nav>

    <div class="mt-4 tabla-contenedor">
      <% if (riesgos.length === 0) { %>
        <p class="p-8 text-center text-slate-500">
          No hay riesgos<%= nivel ? ' de nivel ' + niveles[nivel].toLowerCase() : '' %><%= sistema ? ' con el sistema seleccionado' : '' %>.
        </p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Actividad</th>
              <th>Amenaza</th>
              <th>Sistema</th>
              <th>Probabilidad</th>
              <th>Impacto</th>
              <th>Nivel de riesgo</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% riesgos.forEach((r) => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3">
                  <a href="/rat/<%= r.actividad.id %>" class="text-indigo-600 hover:underline"><%= r.actividad.nombre %></a>
                  <span class="block text-xs text-slate-400"><%= r.actividad.responsable.nombre %></span>
                </td>
                <td class="px-4 py-3 text-slate-800 max-w-xs"><p class="line-clamp-2"><%= r.amenaza %></p></td>
                <td class="px-4 py-3"><%- include('../partials/sistema-celda', { s: r.sistema }) %></td>
                <td class="px-4 py-3 text-slate-600"><%= probabilidades[r.probabilidad] %></td>
                <td class="px-4 py-3 text-slate-600"><%= impactos[r.impacto] %></td>
                <td class="px-4 py-3"><%- include('../partials/nivel-badge', { nivel: r.nivel_riesgo, nivelEtiquetas: niveles }) %></td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a href="/riesgos/<%= r.id %>" class="btn btn-secondary btn-sm"><%- icono('eye', 'h-3.5 w-3.5') %>Ver</a>
                  <a href="/riesgos/<%= r.id %>/editar" class="ml-1 btn btn-primary btn-sm"><%- icono('pencil', 'h-3.5 w-3.5') %>Editar</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</body>
</html>
