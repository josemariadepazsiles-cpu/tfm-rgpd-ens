<%
  const inputClase = 'mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500';
  const accion = riesgo.id ? '/riesgos/' + riesgo.id : '/riesgos';
  const volver = riesgo.id ? '/riesgos/' + riesgo.id : (riesgo.actividad_id ? '/rat/' + riesgo.actividad_id : '/riesgos');
  const estado = {
    probabilidad: riesgo.probabilidad || '',
    impacto: riesgo.impacto || '',
    matriz,
    clases: nivelClases,
    etiquetas: niveles,
  };
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-slate-100">
  <%- include('../partials/nav') %>

  <main class="max-w-3xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-slate-800"><%= title %></h1>
      <a href="<%= volver %>" class="text-sm text-indigo-600 hover:underline">Cancelar</a>
    </div>

    <% if (errores.length) { %>
      <ul class="mt-6 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 list-disc list-inside" role="alert">
        <% errores.forEach((e) => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <% if (actividades.length === 0) { %>
      <div class="mt-6 rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
        Primero necesitas una actividad de tratamiento. <a href="/rat/nueva" class="font-medium underline">Crear actividad</a>
      </div>
    <% } %>

    <form action="<%= accion %>" method="POST" class="mt-6 space-y-6"
          x-data='<%= JSON.stringify(estado) %>'>
      <fieldset class="bg-white rounded-2xl shadow p-6 space-y-4">
        <legend class="float-left w-full mb-2 text-lg font-semibold text-slate-800">Riesgo</legend>
        <div class="clear-both">
          <label for="actividad_id" class="block text-sm font-medium text-slate-700">Actividad de tratamiento</label>
          <select id="actividad_id" name="actividad_id" required class="<%= inputClase %>">
            <option value="" disabled <%= riesgo.actividad_id ? '' : 'selected' %>>Selecciona una actividad</option>
            <% actividades.forEach((a) => { %>
              <option value="<%= a.id %>" <%= riesgo.actividad_id === a.id ? 'selected' : '' %>><%= a.nombre %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="amenaza" class="block text-sm font-medium text-slate-700">Amenaza</label>
          <textarea id="amenaza" name="amenaza" rows="2" required class="<%= inputClase %>"
                    placeholder="Ej.: Acceso no autorizado a los datos de nóminas"><%= riesgo.amenaza || '' %></textarea>
        </div>
      </fieldset>

      <fieldset class="bg-white rounded-2xl shadow p-6 space-y-4">
        <legend class="float-left w-full mb-2 text-lg font-semibold text-slate-800">Valoración</legend>
        <div class="clear-both grid gap-4 sm:grid-cols-2">
          <div>
            <label for="probabilidad" class="block text-sm font-medium text-slate-700">Probabilidad</label>
            <select id="probabilidad" name="probabilidad" required x-model="probabilidad" class="<%= inputClase %>">
              <option value="" disabled>Selecciona</option>
              <% Object.entries(probabilidades).forEach(([valor, etiqueta]) => { %>
                <option value="<%= valor %>" <%= riesgo.probabilidad === valor ? 'selected' : '' %>><%= etiqueta %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label for="impacto" class="block text-sm font-medium text-slate-700">Impacto</label>
            <select id="impacto" name="impacto" required x-model="impacto" class="<%= inputClase %>">
              <option value="" disabled>Selecciona</option>
              <% Object.entries(impactos).forEach(([valor, etiqueta]) => { %>
                <option value="<%= valor %>" <%= riesgo.impacto === valor ? 'selected' : '' %>><%= etiqueta %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div>
          <span class="block text-sm font-medium text-slate-700">Nivel de riesgo (calculado)</span>
          <div class="mt-1 flex items-center gap-3 rounded-lg bg-slate-50 border border-slate-200 px-3 py-2">
            <template x-if="probabilidad && impacto">
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset"
                    :class="clases[matriz[probabilidad][impacto]]"
                    x-text="etiquetas[matriz[probabilidad][impacto]]"></span>
            </template>
            <span class="text-sm text-slate-500" x-show="!(probabilidad && impacto)">Selecciona probabilidad e impacto</span>
          </div>
        </div>

        <details class="text-sm">
          <summary class="cursor-pointer text-indigo-600">Ver matriz de riesgo</summary>
          <table class="mt-3 text-center text-xs">
            <thead>
              <tr>
                <th class="px-2 py-1 text-left text-slate-500">Probabilidad \ Impacto</th>
                <% Object.values(impactos).forEach((i) => { %><th class="px-2 py-1 text-slate-600"><%= i %></th><% }) %>
              </tr>
            </thead>
            <tbody>
              <% Object.entries(probabilidades).forEach(([p, pEtiqueta]) => { %>
                <tr>
                  <th class="px-2 py-1 text-left text-slate-600"><%= pEtiqueta %></th>
                  <% Object.keys(impactos).forEach((i) => { %>
                    <td class="p-1">
                      <span class="block rounded px-3 py-1 font-semibold ring-1 ring-inset <%= nivelClases[matriz[p][i]] %>"
                            :class="probabilidad === '<%= p %>' && impacto === '<%= i %>' && 'outline-2 outline-offset-1 outline-slate-800'">
                        <%= niveles[matriz[p][i]] %>
                      </span>
                    </td>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </details>
      </fieldset>

      <fieldset class="bg-white rounded-2xl shadow p-6 space-y-4">
        <legend class="float-left w-full mb-2 text-lg font-semibold text-slate-800">Tratamiento del riesgo</legend>
        <div class="clear-both">
          <label for="medidas_mitigadoras" class="block text-sm font-medium text-slate-700">Medidas mitigadoras</label>
          <textarea id="medidas_mitigadoras" name="medidas_mitigadoras" rows="3" class="<%= inputClase %>"
                    placeholder="Ej.: Control de acceso por roles, registro de accesos, cifrado…"><%= riesgo.medidas_mitigadoras || '' %></textarea>
        </div>
      </fieldset>

      <div class="flex justify-end gap-3">
        <a href="<%= volver %>" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-700 hover:bg-slate-50">Cancelar</a>
        <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700 transition">
          <%= riesgo.id ? 'Guardar cambios' : 'Crear riesgo' %>
        </button>
      </div>
    </form>
  </main>
</body>
</html>
