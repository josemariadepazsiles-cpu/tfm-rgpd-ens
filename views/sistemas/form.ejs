<%
  const inputClase = 'input';
  const accion = sistema.id ? '/sistemas/' + sistema.id : '/sistemas';
  const volver = sistema.id ? '/sistemas/' + sistema.id : '/sistemas';
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'Sistemas de información', href: '/sistemas' }, { texto: title }] }) %>
    <div class="flex items-center justify-between">
      <h1 class="titulo-pagina"><%= title %></h1>
    </div>

    <% if (errores.length) { %>
      <ul class="mt-6 rounded-xl border border-red-200 bg-red-50/60 px-4 py-3 text-sm text-red-800 list-disc list-inside space-y-0.5" role="alert">
        <% errores.forEach((e) => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <form action="<%= accion %>" method="POST" class="mt-6 card p-6 space-y-4"
          x-data="{ crear: <%= sistema.crear_evaluacion ? 'true' : 'false' %> }">
      <div>
        <label for="nombre" class="label">Nombre del sistema</label>
        <input maxlength="200" id="nombre" name="nombre" type="text" required value="<%= sistema.nombre || '' %>" class="<%= inputClase %>"
               placeholder="Ej.: Sistema de receta electrónica, Sistema de laboratorio, Web colegial">
      </div>
      <div>
        <label for="tipo_sistema" class="label">Tipo de sistema <span class="font-normal text-slate-400">(opcional)</span></label>
        <input id="tipo_sistema" name="tipo_sistema" type="text" maxlength="100" list="tipos-sistema" value="<%= sistema.tipo_sistema || '' %>" class="<%= inputClase %>"
               placeholder="Ej.: Aplicación clínica">
        <datalist id="tipos-sistema">
          <option value="Aplicación clínica"></option>
          <option value="Web corporativa"></option>
          <option value="Sistema de gestión interna"></option>
        </datalist>
        <p class="ayuda">Texto libre para clasificar el sistema.</p>
      </div>
      <div>
        <label for="descripcion" class="label">Descripción <span class="font-normal text-slate-400">(opcional)</span></label>
        <textarea maxlength="5000" id="descripcion" name="descripcion" rows="3" class="<%= inputClase %>"><%= sistema.descripcion || '' %></textarea>
      </div>
      <div>
        <label for="categoria_general" class="label">Categoría general ENS <span class="font-normal text-slate-400">(opcional)</span></label>
        <select id="categoria_general" name="categoria_general" class="<%= inputClase %>">
          <option value="">Sin definir</option>
          <% Object.entries(categorias).forEach(([valor, etiqueta]) => { %>
            <option value="<%= valor %>" <%= sistema.categoria_general === valor ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
        <p class="ayuda">Categoría del sistema según el ENS (RD 311/2022). Es informativa: cada evaluación incluye todo el catálogo de controles.</p>
      </div>

      <% if (!sistema.id) { %>
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 space-y-3">
          <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700">
            <input type="checkbox" name="crear_evaluacion" x-model="crear" class="check"
                   <%= sistema.crear_evaluacion ? 'checked' : '' %>>
            Crear ya su primera evaluación con el catálogo de controles estándar
          </label>
          <div x-show="crear" x-cloak>
            <label for="nombre_evaluacion" class="label">Nombre de la evaluación</label>
            <input maxlength="200" id="nombre_evaluacion" name="nombre_evaluacion" type="text" value="<%= nombreSugerido %>" class="<%= inputClase %>">
          </div>
        </div>
      <% } %>

      <div class="flex justify-end gap-3 pt-2">
        <a href="<%= volver %>" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          <%= sistema.id ? 'Guardar cambios' : 'Crear sistema' %>
        </button>
      </div>
    </form>
  </main>
  <%- include('../partials/pie') %>
</body>
</html>
