<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'ENS' }, { texto: 'Sistemas ENS' }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">Sistemas ENS</h1>
        <p class="subtitulo-pagina">Sistemas de información de la organización y sus evaluaciones del Esquema Nacional de Seguridad</p>
      </div>
      <% if (user.rol === 'ADMIN') { %>
        <div class="flex flex-wrap gap-2">
          <a href="/controles" class="btn btn-secondary"><%- icono('list-checks', 'h-4 w-4') %>Catálogo de controles</a>
          <a href="/sistemas/nuevo" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Nuevo sistema</a>
        </div>
      <% } %>
    </div>

    <div class="mt-6 tabla-contenedor">
      <% if (sistemas.length === 0) { %>
        <p class="p-8 text-center text-slate-500">Todavía no hay sistemas registrados.</p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Sistema</th>
              <th>Categoría general</th>
              <th>Controles</th>
              <th>Implementación global</th>
              <th>Última evaluación</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% sistemas.forEach((s) => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3">
                  <a href="/sistemas/<%= s.id %>" class="font-medium text-slate-800 hover:text-indigo-600 hover:underline"><%= s.nombre %></a>
                  <% if (s.descripcion) { %><p class="text-xs text-slate-500 line-clamp-1 max-w-xs"><%= s.descripcion %></p><% } %>
                </td>
                <td class="px-4 py-3"><%- include('../partials/categoria-badge', { categoria: s.categoria_general }) %></td>
                <td class="px-4 py-3 text-slate-600 whitespace-nowrap">
                  <% if (s.global) { %>
                    <%= s.global.aplicables %> aplicables
                    <% if (s.global.noAplica) { %><span class="block text-xs text-slate-400">de <%= s.global.total %> (<%= s.global.noAplica %> no aplic.)</span><% } %>
                  <% } else { %>
                    <%= totalControles %>
                  <% } %>
                </td>
                <td class="px-4 py-3">
                  <% if (s.global) { %>
                    <%- include('../partials/barra-global', { global: s.global }) %>
                  <% } else { %>
                    <span class="text-slate-400 italic">Sin evaluar</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-slate-600">
                  <% if (s.ultima) { %>
                    <a href="/evaluaciones/<%= s.ultima.id %>" class="text-indigo-600 hover:underline"><%= s.ultima.nombre %></a>
                    <span class="block text-xs text-slate-400"><%= s._count.evaluaciones %> evaluación(es)</span>
                  <% } else { %>
                    <span class="text-slate-400 italic">Ninguna</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <% if (s.ultima) { %>
                    <a href="/evaluaciones/<%= s.ultima.id %>" class="btn btn-primary btn-sm"><%- icono('list-checks', 'h-3.5 w-3.5') %>Checklist</a>
                  <% } %>
                  <a href="/sistemas/<%= s.id %>" class="ml-1 btn btn-secondary btn-sm"><%- icono('layers', 'h-3.5 w-3.5') %>Evaluaciones</a>
                  <a href="/sistemas/<%= s.id %>/historial" class="ml-1 btn btn-secondary btn-sm"><%- icono('history', 'h-3.5 w-3.5') %>Histórico</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
    <p class="mt-3 text-xs text-slate-500">La implementación global y los controles aplicables corresponden a la última evaluación de cada sistema; los controles «No aplicable» no cuentan.</p>
  </main>
</body>
</html>
