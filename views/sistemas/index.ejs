<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-slate-100">
  <%- include('../partials/nav') %>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Sistemas ENS</h1>
        <p class="text-sm text-slate-500">Sistemas de información de la organización y sus evaluaciones del Esquema Nacional de Seguridad</p>
      </div>
      <% if (user.rol === 'ADMIN') { %>
        <div class="flex flex-wrap gap-2">
          <a href="/controles" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-700 hover:bg-slate-50 transition">Catálogo de controles</a>
          <a href="/sistemas/nuevo" class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">+ Nuevo sistema</a>
        </div>
      <% } %>
    </div>

    <div class="mt-6 bg-white rounded-2xl shadow overflow-x-auto">
      <% if (sistemas.length === 0) { %>
        <p class="p-8 text-center text-slate-500">Todavía no hay sistemas registrados.</p>
      <% } else { %>
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-600">
            <tr>
              <th class="px-4 py-3 font-medium">Sistema</th>
              <th class="px-4 py-3 font-medium">Categoría general</th>
              <th class="px-4 py-3 font-medium">Controles</th>
              <th class="px-4 py-3 font-medium">Implementación global</th>
              <th class="px-4 py-3 font-medium">Última evaluación</th>
              <th class="px-4 py-3 font-medium text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% sistemas.forEach((s) => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3">
                  <a href="/sistemas/<%= s.id %>" class="font-medium text-slate-800 hover:text-indigo-600 hover:underline"><%= s.nombre %></a>
                  <% if (s.descripcion) { %><p class="text-xs text-slate-500 line-clamp-1 max-w-xs"><%= s.descripcion %></p><% } %>
                </td>
                <td class="px-4 py-3"><%- include('../partials/categoria-badge', { categoria: s.categoria_general }) %></td>
                <td class="px-4 py-3 text-slate-600 whitespace-nowrap">
                  <% if (s.global) { %>
                    <%= s.global.aplicables %> aplicables
                    <% if (s.global.noAplica) { %><span class="block text-xs text-slate-400">de <%= s.global.total %> (<%= s.global.noAplica %> no aplic.)</span><% } %>
                  <% } else { %>
                    <%= totalControles %>
                  <% } %>
                </td>
                <td class="px-4 py-3">
                  <% if (s.global) { %>
                    <%- include('../partials/barra-global', { global: s.global }) %>
                  <% } else { %>
                    <span class="text-slate-400 italic">Sin evaluar</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-slate-600">
                  <% if (s.ultima) { %>
                    <a href="/evaluaciones/<%= s.ultima.id %>" class="text-indigo-600 hover:underline"><%= s.ultima.nombre %></a>
                    <span class="block text-xs text-slate-400"><%= s._count.evaluaciones %> evaluación(es)</span>
                  <% } else { %>
                    <span class="text-slate-400 italic">Ninguna</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <% if (s.ultima) { %>
                    <a href="/evaluaciones/<%= s.ultima.id %>" class="rounded-lg bg-indigo-600 px-3 py-1 text-white hover:bg-indigo-700">Checklist</a>
                  <% } %>
                  <a href="/sistemas/<%= s.id %>" class="ml-1 rounded-lg border border-slate-300 px-3 py-1 text-slate-700 hover:bg-slate-100">Evaluaciones</a>
                  <a href="/sistemas/<%= s.id %>/historial" class="ml-1 rounded-lg border border-slate-300 px-3 py-1 text-slate-700 hover:bg-slate-100">Histórico</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
    <p class="mt-3 text-xs text-slate-500">La implementación global y los controles aplicables corresponden a la última evaluación de cada sistema; los controles «No aplicable» no cuentan.</p>
  </main>
</body>
</html>
