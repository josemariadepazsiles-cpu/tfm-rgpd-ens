<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'ENS' }, { texto: 'Sistemas ENS', href: '/sistemas' }, { texto: sistema.nombre }] }) %>
    <%- include('../partials/flash') %>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="titulo-pagina"><%= sistema.nombre %></h1>
          <% if (sistema.categoria_general) { %>
            <span class="text-sm text-slate-500">Categoría general:</span>
            <%- include('../partials/categoria-badge', { categoria: sistema.categoria_general }) %>
          <% } %>
        </div>
        <% if (sistema.descripcion) { %><p class="mt-1 text-slate-600 whitespace-pre-line"><%= sistema.descripcion %></p><% } %>
        <p class="ayuda">
          Creado el <%= fechaHora(sistema.created_at) %><%= sistema.creado_por ? ' por ' + sistema.creado_por.nombre : '' %>
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/sistemas/<%= sistema.id %>/historial" class="btn btn-secondary"><%- icono('history', 'h-4 w-4') %>Ver histórico</a>
        <a href="/declaraciones?sistema=<%= sistema.id %>" class="btn btn-secondary"><%- icono('file-badge', 'h-4 w-4') %>Declaraciones</a>
        <% if (user.rol === 'ADMIN') { %>
          <a href="/sistemas/<%= sistema.id %>/editar" class="btn btn-secondary"><%- icono('pencil', 'h-4 w-4') %>Editar</a>
          <form action="/sistemas/<%= sistema.id %>/eliminar" method="POST" data-nombre="<%= sistema.nombre %>"
                onsubmit="return confirm('¿Eliminar el sistema «' + this.dataset.nombre + '»? Se borrarán sus <%= evaluaciones.length %> evaluaciones y todo su histórico. Esta acción no se puede deshacer.')">
            <button type="submit" class="btn btn-danger"><%- icono('trash-2', 'h-4 w-4') %>Eliminar</button>
          </form>
        <% } %>
      </div>
    </div>

    <% if (user.rol === 'ADMIN') { %>
      <form action="/sistemas/<%= sistema.id %>/evaluaciones" method="POST"
            class="mt-6 card p-6 flex flex-wrap items-end gap-4">
        <div class="flex-1 min-w-56">
          <label for="nombre" class="label">Nueva evaluación</label>
          <input id="nombre" name="nombre" type="text" required value="<%= nombreSugerido %>"
                 class="input">
        </div>
        <% if (evaluaciones.length) { %>
          <label class="inline-flex items-center gap-2 pb-2 text-sm text-slate-700">
            <input type="checkbox" name="copiar" checked class="check">
            Partir de los estados de «<%= evaluaciones[0].nombre %>»
          </label>
        <% } %>
        <button type="submit" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Crear evaluación
        </button>
      </form>
    <% } %>

    <h2 class="mt-8 titulo-seccion">Evaluaciones (<%= evaluaciones.length %>)</h2>

    <% if (evaluaciones.length === 0) { %>
      <p class="mt-4 card p-6 text-sm text-slate-500">
        Este sistema todavía no tiene evaluaciones.<%= user.rol === 'ADMIN' ? ' Crea la primera con el formulario de arriba.' : '' %>
      </p>
    <% } %>

    <div class="mt-4 space-y-4">
      <% evaluaciones.forEach((e, i) => { %>
        <article class="card p-6">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="font-semibold text-slate-800">
                <a href="/evaluaciones/<%= e.id %>" class="hover:text-indigo-600 hover:underline"><%= e.nombre %></a>
                <% if (i === 0) { %><span class="ml-2 rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">Última</span><% } %>
              </h3>
              <p class="text-xs text-slate-500">
                Creada el <%= fechaHora(e.created_at) %><%= e.creado_por ? ' por ' + e.creado_por.nombre : '' %>
              </p>
              <div class="mt-2"><%- include('../partials/barra-global', { global: e.global }) %></div>
            </div>
            <div class="flex flex-wrap gap-2 text-sm">
              <a href="/evaluaciones/<%= e.id %>" class="btn btn-primary btn-sm"><%- icono('arrow-right', 'h-3.5 w-3.5') %>Abrir</a>
              <a href="/sistemas/<%= sistema.id %>/historial?evaluacion=<%= e.id %>" class="btn btn-secondary btn-sm"><%- icono('history', 'h-3.5 w-3.5') %>Histórico</a>
              <% if (user.rol === 'ADMIN') { %>
                <form action="/evaluaciones/<%= e.id %>/eliminar" method="POST" data-nombre="<%= e.nombre %>"
                      onsubmit="return confirm('¿Eliminar la evaluación «' + this.dataset.nombre + '» y su histórico? Esta acción no se puede deshacer.')">
                  <button type="submit" class="btn btn-danger btn-sm"><%- icono('trash-2', 'h-3.5 w-3.5') %>Eliminar</button>
                </form>
              <% } %>
            </div>
          </div>
          <div class="mt-4">
            <%- include('../partials/resumen-ens', { resumen: e.resumen, compacto: true }) %>
          </div>
        </article>
      <% }) %>
    </div>
  </main>
</body>
</html>
