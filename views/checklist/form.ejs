<%
  const inputClase = 'mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500';
  const esAdmin = user.rol === 'ADMIN';
  const accion = control.id ? '/checklist/' + control.id : '/checklist';
  const volver = control.id ? '/checklist#control-' + control.id : '/checklist';
  const fecha = (d) => new Date(d).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' });
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-slate-100">
  <%- include('../partials/nav') %>

  <main class="max-w-2xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-slate-800"><%= title %></h1>
      <a href="<%= volver %>" class="text-sm text-indigo-600 hover:underline">Cancelar</a>
    </div>

    <% if (errores.length) { %>
      <ul class="mt-6 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 list-disc list-inside" role="alert">
        <% errores.forEach((e) => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <form action="<%= accion %>" method="POST" class="mt-6 bg-white rounded-2xl shadow p-6 space-y-4">
      <% if (esAdmin) { %>
        <div>
          <label for="nombre" class="block text-sm font-medium text-slate-700">Nombre del control</label>
          <input id="nombre" name="nombre" type="text" required value="<%= control.nombre || '' %>" class="<%= inputClase %>">
        </div>
        <div>
          <label for="categoria" class="block text-sm font-medium text-slate-700">Categoría</label>
          <select id="categoria" name="categoria" required class="<%= inputClase %>">
            <option value="" disabled <%= control.categoria ? '' : 'selected' %>>Selecciona una categoría</option>
            <% Object.entries(categorias).forEach(([valor, etiqueta]) => { %>
              <option value="<%= valor %>" <%= control.categoria === valor ? 'selected' : '' %>><%= etiqueta %></option>
            <% }) %>
          </select>
        </div>
      <% } else { %>
        <div class="flex flex-wrap items-center gap-3">
          <p class="text-lg font-semibold text-slate-800"><%= control.nombre %></p>
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset <%= categoriaClases[control.categoria].badge %>">
            Categoría <%= categorias[control.categoria] %>
          </span>
        </div>
      <% } %>

      <div>
        <label for="estado" class="block text-sm font-medium text-slate-700">Estado</label>
        <select id="estado" name="estado" required class="<%= inputClase %>">
          <% Object.entries(estados).forEach(([valor, etiqueta]) => { %>
            <option value="<%= valor %>" <%= control.estado === valor ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
        <p class="mt-1 text-xs text-slate-500">
          <% if (control.fecha_revision) { %>Última revisión: <%= fecha(control.fecha_revision) %>. <% } %>
          Al cambiar el estado se actualiza la fecha de revisión.
        </p>
      </div>

      <div>
        <label for="evidencia" class="block text-sm font-medium text-slate-700">Evidencia</label>
        <textarea id="evidencia" name="evidencia" rows="4" class="<%= inputClase %>"
                  placeholder="Ej.: Política de contraseñas aprobada el 15/09/2026, documento POL-SEG-03"><%= control.evidencia || '' %></textarea>
      </div>

      <div>
        <% if (esAdmin) { %>
          <label for="responsable_id" class="block text-sm font-medium text-slate-700">Responsable</label>
          <select id="responsable_id" name="responsable_id" class="<%= inputClase %>">
            <option value="">Sin asignar</option>
            <% usuarios.forEach((u) => { %>
              <option value="<%= u.id %>" <%= control.responsable_id === u.id ? 'selected' : '' %>>
                <%= u.nombre %><%= u.area ? ' — ' + u.area : '' %>
              </option>
            <% }) %>
          </select>
        <% } else { %>
          <span class="block text-sm font-medium text-slate-700">Responsable</span>
          <p class="mt-1 text-slate-600">
            <%= control.responsable ? control.responsable.nombre : 'Sin asignar' %>
          </p>
          <label class="mt-2 inline-flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" name="asignarme" class="w-4 h-4 rounded border-slate-300 text-indigo-600"
                   <%= control.responsable_id === user.id ? 'checked' : '' %>>
            Soy el responsable de este control
          </label>
        <% } %>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <a href="<%= volver %>" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-700 hover:bg-slate-50">Cancelar</a>
        <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700 transition">
          <%= control.id ? 'Guardar cambios' : 'Crear control' %>
        </button>
      </div>
    </form>
  </main>
</body>
</html>
