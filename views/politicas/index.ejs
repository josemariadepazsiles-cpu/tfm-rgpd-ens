<%
  const selectClase = 'input w-auto';
  const esAdmin = user.rol === 'ADMIN';
  const pendientes = politicas.filter((p) => p.pendienteAceptar).length;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'ENS' }, { texto: 'Políticas y Documentación' }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">Políticas y Documentación<%- include('../partials/area-badge') %></h1>
        <p class="subtitulo-pagina">
          Política de Seguridad de la Información, procedimientos, instrucciones técnicas y normativas internas<%= esAdmin ? '' : ' vigentes' %>
        </p>
      </div>
      <% if (esAdmin) { %>
        <a href="/politicas/nueva" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Nuevo documento</a>
      <% } %>
    </div>

    <% if (pendientes) { %>
      <div class="mt-6 aviso alerta-info" role="status"><%- icono('info') %>
        Tienes <strong><%= pendientes %> documento(s)</strong> pendientes de leer y aceptar.
      </div>
    <% } %>

    <%- include("../partials/filtro-alerta") %>

    <form action="/politicas" method="GET" class="mt-6 flex flex-wrap items-end gap-3">
      <% if (filtro) { %><input type="hidden" name="filtro" value="<%= filtro %>"><% } %>
      <div>
        <label for="tipo" class="label">Tipo de documento</label>
        <select id="tipo" name="tipo" onchange="this.form.submit()" class="<%= selectClase %>">
          <option value="">Todos</option>
          <% Object.entries(TIPOS_POLITICA).forEach(([v, etiqueta]) => { %>
            <option value="<%= v %>" <%= tipo === v ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
      </div>
      <% if (esAdmin) { %>
        <div>
          <label for="estado" class="label">Estado</label>
          <select id="estado" name="estado" onchange="this.form.submit()" class="<%= selectClase %>">
            <option value="">Todos</option>
            <% Object.entries(ESTADOS_POLITICA).forEach(([v, etiqueta]) => { %>
              <option value="<%= v %>" <%= estado === v ? 'selected' : '' %>><%= etiqueta %></option>
            <% }) %>
          </select>
        </div>
      <% } %>
      <noscript><button type="submit" class="btn btn-secondary">Filtrar</button></noscript>
      <% if (tipo || estado || filtro) { %><a href="/politicas" class="py-2 text-sm text-indigo-600 hover:underline">Quitar filtros</a><% } %>
    </form>

    <div class="mt-4 tabla-contenedor">
      <% if (politicas.length === 0) { %>
        <p class="p-8 text-center text-slate-500"><%= tipo || estado || filtro ? 'No hay documentos con esos filtros.' : 'No hay documentos publicados.' %></p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Documento</th>
              <th>Tipo</th>
              <th>Sistema</th>
              <th>Versión vigente</th>
              <th>Estado</th>
              <th>Próxima revisión</th>
              <th>Aceptación</th>
            </tr>
          </thead>
          <tbody>
            <% politicas.forEach((p) => { %>
              <tr class="hover:bg-slate-50 <%= p.estado === 'OBSOLETA' ? 'opacity-60' : '' %>">
                <td class="px-4 py-3 max-w-sm">
                  <a href="/politicas/<%= p.id %>" class="enlace-registro"><%= p.titulo %></a>
                </td>
                <td class="px-4 py-3 text-slate-600"><%= TIPOS_POLITICA[p.tipo_documento] %></td>
                <td class="px-4 py-3"><%- include('../partials/sistema-celda', { s: p.sistema, textoVacio: 'General' }) %></td>
                <td class="px-4 py-3 tabular-nums text-slate-700"><%= p.version %></td>
                <td class="px-4 py-3">
                  <span class="badge <%= estadoPoliticaClases[p.estado] %>"><%= ESTADOS_POLITICA[p.estado] %></span>
                </td>
                <td class="px-4 py-3">
                  <span class="text-slate-600"><%= p.fecha_proxima_revision ? fecha(p.fecha_proxima_revision) : '—' %></span>
                  <% if (p.alerta) { %>
                    <span class="badge mt-1 <%= revisionClases[p.alerta.nivel] %>"><%= p.alerta.nivel === 'vencida' ? '⚠ ' : '' %><%= p.alerta.texto %></span>
                  <% } %>
                </td>
                <td class="px-4 py-3">
                  <% if (!p.requiere_aceptacion) { %>
                    <span class="text-xs text-slate-400">No requiere</span>
                  <% } else if (p.pendienteAceptar) { %>
                    <span class="inline-flex rounded-full bg-indigo-600 px-2.5 py-0.5 text-xs font-semibold text-white">Pendiente de tu aceptación</span>
                  <% } else if (p.estado === 'APROBADA') { %>
                    <span class="text-xs font-medium text-green-700">Aceptada por ti</span>
                  <% } else { %>
                    <span class="text-xs text-slate-500">Requiere aceptación</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
    <p class="mt-3 text-xs text-slate-500">
      Revisión periódica: amarillo = en <%= DIAS_AVISO_REVISION %> días o menos · rojo = vencida.
    </p>
  </main>
</body>
</html>
