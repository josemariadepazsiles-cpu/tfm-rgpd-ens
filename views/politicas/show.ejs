<%
  const p = politica;
  const esAdmin = user.rol === 'ADMIN';
  const inputClase = 'input';
  const urlArchivo = (a) => '/politicas/' + p.id + '/archivos/' + a.id;
  const pestanas = [
    { id: 'documento', texto: 'Documento', icono: 'file-text' },
    { id: 'versiones', texto: 'Versiones anteriores', icono: 'history', contador: historicos.length },
    ...(aceptaciones ? [{ id: 'aceptaciones', texto: 'Aceptaciones', icono: 'signature', contador: aceptaciones.aceptado.length + '/' + (aceptaciones.aceptado.length + aceptaciones.pendiente.length) }] : []),
    ...(esAdmin ? [{ id: 'gestion', texto: 'Gestión', icono: 'settings-2' }] : []),
  ];
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= area %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'ENS' }, { texto: 'Políticas y Documentación', href: '/politicas' }, { texto: politica.titulo }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="eyebrow"><%= TIPOS_POLITICA[p.tipo_documento] %></p>
        <h1 class="mt-1 titulo-pagina"><%= p.titulo %><%- include('../partials/area-badge') %></h1>
        <div class="mt-2.5 flex flex-wrap items-center gap-2">
          <span class="badge bg-white text-slate-700 ring-slate-200 tabular-nums">Versión <%= p.version %></span>
          <span class="badge <%= estadoPoliticaClases[p.estado] %>"><%= ESTADOS_POLITICA[p.estado] %></span>
          <% if (alerta) { %>
            <span class="badge <%= revisionClases[alerta.nivel] %>"><%- icono(alerta.nivel === 'vencida' ? 'triangle-alert' : 'calendar-clock', 'h-3 w-3') %><%= alerta.texto %></span>
          <% } %>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <% if (vigente) { %>
          <a href="<%= urlArchivo(vigente) %>" target="_blank" rel="noopener" class="btn btn-secondary"><%- icono('eye', 'h-4 w-4') %>Ver documento</a>
        <% } %>
        <% if (esAdmin) { %>
          <a href="/politicas/<%= p.id %>/editar" class="btn btn-secondary"><%- icono('pencil', 'h-4 w-4') %>Editar datos</a>
        <% } %>
      </div>
    </div>

    <%# Aceptación del usuario: acción principal, siempre visible %>
    <% if (puedeAceptar) { %>
      <section class="card relative mt-6 overflow-hidden border-indigo-200 p-5 sm:p-6">
        <div class="pointer-events-none absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-indigo-500 to-violet-500" aria-hidden="true"></div>
        <div class="flex flex-wrap items-center justify-between gap-4 pl-1">
          <div class="flex items-start gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-marca-50 text-indigo-600"><%- icono('signature', 'h-5 w-5') %></span>
            <div>
              <h2 class="font-semibold text-slate-900">Lectura y aceptación obligatoria</h2>
              <p class="text-sm text-slate-600">Lee el documento vigente (versión <strong><%= p.version %></strong>) y confirma que lo has entendido.</p>
            </div>
          </div>
          <form action="/politicas/<%= p.id %>/aceptar" method="POST">
            <input type="hidden" name="version" value="<%= p.version %>">
            <button type="submit" class="btn btn-primary"><%- icono('check', 'h-4 w-4') %>He leído y acepto esta política</button>
          </form>
        </div>
      </section>
    <% } else if (miAceptacion) { %>
      <p class="mt-6 aviso alerta-exito"><%- icono('circle-check') %>
        Aceptaste la versión <%= p.version %> el <%= fechaHora(miAceptacion.fecha_aceptacion) %>.
      </p>
    <% } %>

    <div class="mt-8" x-data='pestanas("documento", <%= JSON.stringify(pestanas.map((t) => t.id)) %>)'>
      <%- include('../partials/pestanas', { pestanas }) %>

      <%# --- Documento --- %>
      <div x-show="tab === 'documento'" role="tabpanel" id="panel-documento" aria-labelledby="tab-documento" class="mt-6 grid items-start gap-6 lg:grid-cols-3">
        <section class="card p-5 sm:p-6 lg:col-span-2">
          <h2 class="text-base font-semibold text-slate-900">Documento vigente</h2>
          <% if (vigente) { %>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 p-4">
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-50 text-red-600"><%- icono('file-text', 'h-5 w-5') %></span>
                <div>
                  <p class="font-medium text-slate-900">Versión <%= vigente.version %></p>
                  <p class="text-xs text-slate-500">
                    <%= vigente.nombre_archivo_original %> · <%= formatoTamano(vigente.tamano_bytes) %> ·
                    subido el <%= fechaHora(vigente.fecha_subida) %><%= vigente.subido_por ? ' por ' + vigente.subido_por.nombre : '' %>
                  </p>
                </div>
              </div>
              <div class="flex gap-2">
                <a href="<%= urlArchivo(vigente) %>" target="_blank" rel="noopener" class="btn btn-primary btn-sm"><%- icono('eye', 'h-3.5 w-3.5') %>Ver</a>
                <a href="<%= urlArchivo(vigente) %>?descargar=1" class="btn btn-secondary btn-sm"><%- icono('download', 'h-3.5 w-3.5') %>Descargar</a>
              </div>
            </div>
          <% } else { %>
            <div class="vacio"><%- icono('file-up', 'h-6 w-6 text-slate-300') %>Todavía no se ha subido el PDF de este documento.
              <% if (esAdmin) { %><button type="button" class="enlace" @click="ir('gestion')">Subirlo ahora</button><% } %>
            </div>
          <% } %>
          <% if (p.descripcion) { %>
            <h3 class="mt-6 text-xs font-medium uppercase tracking-wide text-slate-500">Descripción</h3>
            <p class="mt-1 whitespace-pre-line text-slate-800"><%= p.descripcion %></p>
          <% } %>
        </section>

        <section class="card p-5">
          <h2 class="text-sm font-semibold text-slate-900">Datos generales</h2>
          <dl class="mt-3 space-y-3 text-sm">
            <div><dt class="text-slate-500">Aprobación</dt>
              <dd class="mt-0.5 <%= p.fecha_aprobacion ? 'text-slate-800' : 'italic text-slate-400' %>"><%= p.fecha_aprobacion ? fechaHora(p.fecha_aprobacion) + (p.aprobado_por ? ' · ' + p.aprobado_por.nombre : '') : 'Sin aprobar' %></dd></div>
            <div><dt class="text-slate-500">Próxima revisión</dt>
              <dd class="mt-0.5 text-slate-800"><%= p.fecha_proxima_revision ? fecha(p.fecha_proxima_revision) : 'Sin fecha' %></dd></div>
            <div><dt class="text-slate-500">Requiere aceptación</dt>
              <dd class="mt-0.5 text-slate-800"><%= p.requiere_aceptacion ? 'Sí, de cada versión aprobada' : 'No' %></dd></div>
            <div><dt class="text-slate-500">Creado</dt>
              <dd class="mt-0.5 text-slate-800"><%= fechaHora(p.created_at) %><%= p.creado_por ? ' · ' + p.creado_por.nombre : '' %></dd></div>
          </dl>
        </section>
      </div>

      <%# --- Versiones anteriores --- %>
      <div x-show="tab === 'versiones'" x-cloak role="tabpanel" id="panel-versiones" aria-labelledby="tab-versiones" class="mt-6">
        <div class="tabla-contenedor">
          <% if (historicos.length === 0) { %>
            <div class="vacio"><%- icono('history', 'h-6 w-6 text-slate-300') %>No hay versiones anteriores.</div>
          <% } else { %>
            <table class="tabla">
              <thead>
                <tr><th>Versión</th><th>Archivo</th><th>Subida</th><th>Por</th><th class="text-right">Acciones</th></tr>
              </thead>
              <tbody>
                <% historicos.forEach((a) => { %>
                  <tr>
                    <td class="tabular-nums text-slate-800"><%= a.version %> <span class="badge ml-1 bg-slate-50 text-slate-500 ring-slate-200">histórica</span></td>
                    <td class="text-slate-600"><%= a.nombre_archivo_original %> · <%= formatoTamano(a.tamano_bytes) %></td>
                    <td class="whitespace-nowrap text-slate-600"><%= fechaHora(a.fecha_subida) %></td>
                    <td class="text-slate-600"><%= a.subido_por ? a.subido_por.nombre : '—' %></td>
                    <td class="whitespace-nowrap text-right">
                      <a href="<%= urlArchivo(a) %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm"><%- icono('eye', 'h-3.5 w-3.5') %>Ver</a>
                      <a href="<%= urlArchivo(a) %>?descargar=1" class="ml-1 btn btn-secondary btn-sm"><%- icono('download', 'h-3.5 w-3.5') %>Descargar</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>

      <%# --- Aceptaciones (Administrador) --- %>
      <% if (aceptaciones) { const totalUsuarios = aceptaciones.aceptado.length + aceptaciones.pendiente.length; const pct = totalUsuarios ? Math.round((aceptaciones.aceptado.length / totalUsuarios) * 100) : 0; %>
        <div x-show="tab === 'aceptaciones'" x-cloak role="tabpanel" id="panel-aceptaciones" aria-labelledby="tab-aceptaciones" class="mt-6 space-y-4">
          <section class="card p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-base font-semibold text-slate-900">Aceptación de la versión <%= p.version %></h2>
              <span class="text-sm text-slate-600"><strong class="text-slate-900"><%= aceptaciones.aceptado.length %></strong> de <%= totalUsuarios %> usuarios · <%= pct %> %</span>
            </div>
            <div class="progreso mt-3"><span class="<%= pct === 100 ? 'bg-emerald-500' : 'bg-indigo-500' %>" style="width: <%= pct %>%"></span></div>
            <% if (p.estado !== 'APROBADA') { %>
              <p class="mt-3 flex items-center gap-1.5 text-sm text-amber-700"><%- icono('circle-alert', 'h-4 w-4') %>La aceptación se pedirá al personal cuando esta versión esté aprobada.</p>
            <% } %>
          </section>
          <div class="grid gap-4 md:grid-cols-2">
            <section class="card p-5">
              <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-900"><span class="punto bg-emerald-500"></span>Han aceptado (<%= aceptaciones.aceptado.length %>)</h3>
              <ul class="mt-2 divide-y divide-slate-100 text-sm">
                <% aceptaciones.aceptado.forEach((u) => { %>
                  <li class="flex justify-between gap-3 py-2.5">
                    <span class="text-slate-800"><%= u.nombre %><% if (u.area) { %> <span class="text-xs text-slate-400"><%= u.area %></span><% } %></span>
                    <span class="whitespace-nowrap text-slate-500"><%= fechaHora(u.fecha) %></span>
                  </li>
                <% }) %>
                <% if (!aceptaciones.aceptado.length) { %><li class="py-2.5 italic text-slate-400">Nadie todavía</li><% } %>
              </ul>
            </section>
            <section class="card p-5">
              <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-900"><span class="punto bg-amber-500"></span>Pendientes (<%= aceptaciones.pendiente.length %>)</h3>
              <ul class="mt-2 divide-y divide-slate-100 text-sm">
                <% aceptaciones.pendiente.forEach((u) => { %>
                  <li class="flex justify-between gap-3 py-2.5">
                    <span class="text-slate-800"><%= u.nombre %><% if (u.area) { %> <span class="text-xs text-slate-400"><%= u.area %></span><% } %></span>
                    <span class="truncate text-slate-500"><%= u.email %></span>
                  </li>
                <% }) %>
                <% if (!aceptaciones.pendiente.length) { %><li class="py-2.5 text-emerald-700">Todos han aceptado</li><% } %>
              </ul>
            </section>
          </div>
        </div>
      <% } %>

      <%# --- Gestión (Administrador) --- %>
      <% if (esAdmin) { %>
        <div x-show="tab === 'gestion'" x-cloak role="tabpanel" id="panel-gestion" aria-labelledby="tab-gestion" class="mt-6 grid items-start gap-6 md:grid-cols-2">
          <form action="/politicas/<%= p.id %>/versiones" method="POST" enctype="multipart/form-data" class="card space-y-4 p-5 sm:p-6">
            <div>
              <h2 class="text-base font-semibold text-slate-900"><%= vigente ? 'Subir nueva versión' : 'Subir el PDF del documento' %></h2>
              <% if (vigente) { %><p class="mt-1 text-sm text-slate-500">La versión <%= vigente.version %> quedará como histórica. Si requiere aceptación, se pedirá de nuevo al aprobar la nueva.</p><% } %>
            </div>
            <div>
              <label for="archivo" class="label">Archivo PDF (máx. <%= tamanoMaximoMb %> MB)</label>
              <input id="archivo" name="archivo" type="file" accept="application/pdf,.pdf" required
                     class="block w-full rounded-lg border border-slate-200 bg-white text-sm text-slate-600 file:mr-3 file:border-0 file:bg-marca-50 file:px-3 file:py-2.5 file:font-medium file:text-indigo-700 hover:file:bg-marca-100">
            </div>
            <div>
              <label for="version" class="label">Número de versión</label>
              <input id="version" name="version" type="text" required maxlength="20" class="<%= inputClase %> tabular-nums"
                     value="<%= vigente ? '' : p.version %>" placeholder="<%= vigente ? 'Ej.: 2.0' : '1.0' %>">
            </div>
            <label class="inline-flex items-center gap-2 text-sm text-slate-700">
              <input type="checkbox" name="aprobar" class="check">
              Aprobar esta versión ahora
            </label>
            <div class="flex justify-end">
              <button type="submit" class="btn btn-primary"><%- icono('upload', 'h-4 w-4') %>Subir versión</button>
            </div>
          </form>

          <form action="/politicas/<%= p.id %>/estado" method="POST" class="card space-y-4 p-5 sm:p-6">
            <div>
              <h2 class="text-base font-semibold text-slate-900">Estado del documento</h2>
              <p class="mt-1 text-sm text-slate-500">Al aprobarla se registra la fecha y quién la aprueba. Para retirarla, márcala como Obsoleta.</p>
            </div>
            <div>
              <label for="estado-politica" class="label">Estado</label>
              <select id="estado-politica" name="estado" class="<%= inputClase %>">
                <% Object.entries(ESTADOS_POLITICA).forEach(([v, etiqueta]) => { %>
                  <option value="<%= v %>" <%= p.estado === v ? 'selected' : '' %>><%= etiqueta %></option>
                <% }) %>
              </select>
            </div>
            <div class="flex justify-end">
              <button type="submit" class="btn btn-secondary">Cambiar estado</button>
            </div>
          </form>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
