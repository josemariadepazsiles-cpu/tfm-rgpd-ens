<%
  const inputClase = 'input';
  const accion = politica.id ? '/politicas/' + politica.id : '/politicas';
  const volver = politica.id ? '/politicas/' + politica.id : '/politicas';
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'ENS' }, { texto: 'Políticas y Documentación', href: '/politicas' }, { texto: title }] }) %>
    <div class="flex items-center justify-between">
      <h1 class="titulo-pagina"><%= title %><%- include('../partials/area-badge') %></h1>
    </div>
    <% if (!politica.id) { %>
      <p class="mt-1 text-sm text-slate-500">Se crea en Borrador. Después podrás subir el PDF de la versión y aprobarla.</p>
    <% } %>

    <% if (errores.length) { %>
      <ul class="mt-6 rounded-xl border border-red-200 bg-red-50/60 px-4 py-3 text-sm text-red-800 list-disc list-inside space-y-0.5" role="alert">
        <% errores.forEach((e) => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <form action="<%= accion %>" method="POST" class="mt-6 card p-6 space-y-4">
      <div>
        <label for="titulo" class="label">Título</label>
        <input id="titulo" name="titulo" type="text" required maxlength="200" value="<%= politica.titulo || '' %>" class="<%= inputClase %>"
               placeholder="Ej.: Política de Seguridad de la Información">
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="tipo_documento" class="label">Tipo de documento</label>
          <select id="tipo_documento" name="tipo_documento" class="<%= inputClase %>">
            <% Object.entries(TIPOS_POLITICA).forEach(([v, etiqueta]) => { %>
              <option value="<%= v %>" <%= politica.tipo_documento === v ? 'selected' : '' %>><%= etiqueta %></option>
            <% }) %>
          </select>
        </div>
        <%- include('../partials/campo-sistema', { sistemas, valor: politica.sistema_id, textoNinguno: 'General (toda la organización)', ayuda: 'Sistema al que se aplica esta política. Déjala como General si afecta a toda la organización.' }) %>
        <div>
          <% if (politica.tieneArchivos) { %>
            <span class="label">Versión vigente</span>
            <p class="mt-2 tabular-nums text-slate-800"><%= politica.version %></p>
            <p class="ayuda">Cambia al subir una nueva versión del PDF.</p>
          <% } else { %>
            <label for="version" class="label">Versión</label>
            <input id="version" name="version" type="text" required maxlength="20" value="<%= politica.version || '' %>" class="<%= inputClase %>" placeholder="1.0">
          <% } %>
        </div>
      </div>
      <div>
        <label for="descripcion" class="label">Descripción <span class="font-normal text-slate-400">(opcional)</span></label>
        <textarea maxlength="5000" id="descripcion" name="descripcion" rows="3" class="<%= inputClase %>"
                  placeholder="Objeto y alcance del documento"><%= politica.descripcion || '' %></textarea>
      </div>
      <div class="sm:w-64">
        <label for="fecha_proxima_revision" class="label">Próxima revisión</label>
        <input id="fecha_proxima_revision" name="fecha_proxima_revision" type="date"
               value="<%= aInputFecha(politica.fecha_proxima_revision) %>" class="<%= inputClase %>">
        <p class="ayuda">El ENS exige revisar periódicamente la documentación de seguridad. Se avisará <%= DIAS_AVISO_REVISION %> días antes.</p>
      </div>
      <div>
        <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700">
          <input type="checkbox" name="requiere_aceptacion" class="check"
                 <%= politica.requiere_aceptacion ? 'checked' : '' %>>
          El personal debe leerla y confirmar que la ha entendido
        </label>
        <p class="ayuda">Se pedirá la aceptación de cada nueva versión aprobada.</p>
      </div>
      <div class="flex justify-end gap-3 pt-2">
        <a href="<%= volver %>" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          <%= politica.id ? 'Guardar cambios' : 'Crear documento' %>
        </button>
      </div>
    </form>
  </main>
  <%- include('../partials/pie') %>
</body>
</html>
