<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'ENS' }, { texto: 'Declaraciones de Conformidad' }] }) %>
    <%- include('../partials/flash') %>

    <div>
      <h1 class="titulo-pagina">Declaraciones de Conformidad ENS</h1>
      <p class="subtitulo-pagina">
        Informes formales de adecuación generados a partir del checklist de cada sistema.
        <% if (user.rol === 'ADMIN') { %>Para generar una nueva, abre la evaluación del sistema y pulsa «Generar Declaración de Conformidad».<% } %>
      </p>
    </div>

    <form action="/declaraciones" method="GET" class="mt-6 flex flex-wrap items-end gap-3">
      <div>
        <label for="sistema" class="label">Sistema</label>
        <select id="sistema" name="sistema" onchange="this.form.submit()"
                class="input w-auto">
          <option value="">Todos los sistemas</option>
          <% sistemas.forEach((s) => { %>
            <option value="<%= s.id %>" <%= filtro === s.id ? 'selected' : '' %>><%= s.nombre %></option>
          <% }) %>
        </select>
      </div>
      <noscript><button type="submit" class="btn btn-secondary">Filtrar</button></noscript>
      <% if (filtro) { %><a href="/declaraciones" class="py-2 text-sm text-indigo-600 hover:underline">Quitar filtro</a><% } %>
    </form>

    <div class="mt-4 tabla-contenedor">
      <% if (declaraciones.length === 0) { %>
        <p class="p-8 text-center text-slate-500">Todavía no se ha generado ninguna declaración<%= filtro ? ' para este sistema' : '' %>.</p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Sistema</th>
              <th>Categoría ENS</th>
              <th>Versión</th>
              <th>Implementación</th>
              <th>Generada</th>
              <th>Estado</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% declaraciones.forEach((d) => { const pct = Number(d.porcentaje_implementacion); %>
              <tr class="hover:bg-slate-50 <%= d.estado === 'SUPERADA' ? 'opacity-60' : '' %>">
                <td class="px-4 py-3">
                  <a href="/declaraciones/<%= d.id %>" class="font-medium text-slate-800 hover:text-indigo-600 hover:underline"><%= d.sistema_nombre %></a>
                  <span class="block text-xs text-slate-500"><%= d.evaluacion_nombre %></span>
                </td>
                <td class="px-4 py-3">
                  <span class="badge <%= categoriaClases[d.categoria_ens].badge %>"><%= CATEGORIAS_SISTEMA[d.categoria_ens] %></span>
                </td>
                <td class="px-4 py-3 tabular-nums text-slate-700">v<%= d.version %></td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="h-2 w-20 rounded-full bg-slate-200 overflow-hidden">
                      <div class="h-full <%= pct >= 80 ? 'bg-green-500' : pct >= 50 ? 'bg-amber-500' : 'bg-red-500' %>" style="width: <%= pct %>%"></div>
                    </div>
                    <span class="text-sm font-semibold text-slate-700"><%= formatoPorcentaje(d.porcentaje_implementacion) %></span>
                  </div>
                </td>
                <td class="px-4 py-3 text-slate-600 whitespace-nowrap"><%= fechaHora(d.fecha_generacion) %></td>
                <td class="px-4 py-3">
                  <span class="badge <%= estadoDeclaracionClases[d.estado] %>"><%= ESTADOS_DECLARACION[d.estado] %></span>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a href="/declaraciones/<%= d.id %>" class="btn btn-secondary btn-sm"><%- icono('eye', 'h-3.5 w-3.5') %>Ver</a>
                  <a href="/declaraciones/<%= d.id %>/pdf" class="ml-1 btn btn-secondary btn-sm"><%- icono('download', 'h-3.5 w-3.5') %>PDF</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</body>
</html>
