<%
  const selectClase = 'input w-auto';
  const sinContrato = proveedores.filter((p) => p.estado !== 'BAJA' && !p.tiene_contrato_encargado).length;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Proveedores' }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">Encargados del tratamiento / Proveedores<%- include('../partials/area-badge') %></h1>
        <p class="subtitulo-pagina">Proveedores externos con acceso a datos personales (art. 28 RGPD)</p>
      </div>
      <% if (user.rol === 'ADMIN') { %>
        <a href="/proveedores/nuevo" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Nuevo proveedor</a>
      <% } %>
    </div>

    <% if (sinContrato) { %>
      <div class="mt-6 aviso alerta-error" role="alert"><%- icono('triangle-alert') %>
        <strong><%= sinContrato %> proveedor(es)</strong> sin contrato de encargado del tratamiento firmado (art. 28.3), sin contar los dados de baja.
      </div>
    <% } %>

    <%- include("../partials/filtro-alerta") %>

    <form action="/proveedores" method="GET" class="mt-6 flex flex-wrap items-end gap-3">
      <% if (alerta) { %><input type="hidden" name="alerta" value="<%= alerta %>"><% } %>
      <div>
        <label for="estado" class="label">Estado</label>
        <select id="estado" name="estado" onchange="this.form.submit()" class="<%= selectClase %>">
          <option value="">Todos</option>
          <% Object.entries(ESTADOS_PROVEEDOR).forEach(([v, etiqueta]) => { %>
            <option value="<%= v %>" <%= estado === v ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="contrato" class="label">Contrato de encargado</label>
        <select id="contrato" name="contrato" onchange="this.form.submit()" class="<%= selectClase %>">
          <option value="">Todos</option>
          <option value="si" <%= contrato === 'si' ? 'selected' : '' %>>Firmado</option>
          <option value="no" <%= contrato === 'no' ? 'selected' : '' %>>Sin contrato</option>
        </select>
      </div>
      <noscript><button type="submit" class="btn btn-secondary">Filtrar</button></noscript>
      <% if (estado || contrato || alerta) { %>
        <a href="/proveedores" class="py-2 text-sm text-indigo-600 hover:underline">Quitar filtros</a>
      <% } %>
    </form>

    <div class="mt-4 tabla-contenedor">
      <% if (proveedores.length === 0) { %>
        <p class="p-8 text-center text-slate-500">
          <%= estado || contrato || alerta ? 'No hay proveedores con esos filtros.' : 'No se ha registrado ningún proveedor.' %>
        </p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Empresa</th>
              <th>Servicio prestado</th>
              <th>Contrato</th>
              <th>Fuera del EEE</th>
              <th>Nivel ENS</th>
              <th>Estado</th>
              <th>Alertas</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% proveedores.forEach((p) => { %>
              <tr class="hover:bg-slate-50 <%= p.estado === 'BAJA' ? 'opacity-60' : '' %>">
                <td class="px-4 py-3">
                  <a href="/proveedores/<%= p.id %>" class="font-medium text-slate-800 hover:text-indigo-600 hover:underline"><%= p.nombre_empresa %></a>
                  <span class="block text-xs text-slate-500"><%= p.pais_tratamiento %><%= p._count.documentos ? ' · ' + p._count.documentos + ' doc.' : '' %></span>
                </td>
                <td class="px-4 py-3 text-slate-600 max-w-xs"><p class="line-clamp-2"><%= p.servicio_prestado %></p></td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if (p.tiene_contrato_encargado) { %>
                    <span class="text-green-700 font-medium">✓ Firmado</span>
                    <% if (p.fecha_firma_contrato) { %><span class="block text-xs text-slate-500"><%= fecha(p.fecha_firma_contrato) %></span><% } %>
                  <% } else { %>
                    <span class="text-red-700 font-medium">✗ No</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if (p.fuera_ue) { %>
                    <span class="font-medium text-orange-700">Sí</span>
                    <span class="block text-xs text-slate-500"><%= MECANISMOS[p.mecanismo_transferencia] %></span>
                  <% } else { %>
                    <span class="text-slate-500">No</span>
                  <% } %>
                </td>
                <td class="px-4 py-3">
                  <span class="badge <%= nivelEnsClases[p.nivel_cumplimiento_ens] %>"><%= NIVELES_ENS[p.nivel_cumplimiento_ens] %></span>
                </td>
                <td class="px-4 py-3">
                  <span class="badge <%= estadoProveedorClases[p.estado] %>"><%= ESTADOS_PROVEEDOR[p.estado] %></span>
                </td>
                <td class="px-4 py-3"><div class="flex flex-wrap gap-1"><%- include('../partials/alertas-proveedor', { lista: p.alertas }) %></div></td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a href="/proveedores/<%= p.id %>" class="btn btn-secondary btn-sm"><%- icono('eye', 'h-3.5 w-3.5') %>Ver</a>
                  <% if (user.rol === 'ADMIN') { %>
                    <a href="/proveedores/<%= p.id %>/editar" class="ml-1 btn btn-primary btn-sm"><%- icono('pencil', 'h-3.5 w-3.5') %>Editar</a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
    <p class="mt-3 text-xs text-slate-500">
      Alertas: rojo = sin contrato de encargado · amarillo = revisión del contrato en <%= DIAS_AVISO_REVISION %> días o menos, o vencida ·
      naranja = transferencia internacional fuera del EEE (más intenso si no se ha señalado mecanismo de transferencia).
    </p>
  </main>
</body>
</html>
