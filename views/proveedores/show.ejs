<%
  const inputClase = 'input';
  const campo = (etiqueta, valor, vacio, completo) => ({ etiqueta, valor, vacio, completo });
  const p = proveedor;
  const secciones = [
    { titulo: 'Tratamiento que realiza', icono: 'database', campos: [
      campo('Servicio prestado', p.servicio_prestado, null, true),
      campo('Categorías de datos tratados', p.categorias_datos_tratados, null, true),
      campo('País del tratamiento', p.pais_tratamiento),
      campo('Transferencia fuera del EEE', p.fuera_ue ? 'Sí · ' + (p.mecanismo_transferencia === 'NO_APLICA' ? 'sin mecanismo señalado' : MECANISMOS[p.mecanismo_transferencia]) : 'No'),
    ] },
    { titulo: 'Empresa y contacto', icono: 'building-2', campos: [
      campo('CIF', p.cif, 'No indicado'),
      campo('Dirección', p.direccion, 'No indicada'),
      campo('Persona de contacto', p.persona_contacto, 'No indicada'),
      campo('Email', p.email_contacto, 'No indicado'),
      campo('Teléfono', p.telefono_contacto, 'No indicado'),
    ] },
  ];
  const estiloAlerta = { rojo: 'alerta-error', amarillo: 'alerta-aviso', naranja: 'alerta-aviso', naranjaFuerte: 'alerta-error' };
  const iconoAlerta = { rojo: 'file-x', amarillo: 'calendar-clock', naranja: 'globe', naranjaFuerte: 'globe' };
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Proveedores', href: '/proveedores' }, { texto: proveedor.nombre_empresa }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="eyebrow">Encargado del tratamiento</p>
        <h1 class="mt-1 titulo-pagina"><%= p.nombre_empresa %><%- include('../partials/area-badge') %></h1>
        <div class="mt-2.5 flex flex-wrap items-center gap-2">
          <span class="badge <%= estadoProveedorClases[p.estado] %>"><%= ESTADOS_PROVEEDOR[p.estado] %></span>
          <%- include('../partials/alertas-proveedor', { lista: alertas }) %>
          <span class="text-xs text-slate-500">Registrado el <%= fechaHora(p.created_at) %><%= p.creado_por ? ' por ' + p.creado_por.nombre : '' %></span>
        </div>
      </div>
      <% if (user.rol === 'ADMIN') { %>
        <a href="/proveedores/<%= p.id %>/editar" class="btn btn-primary"><%- icono('pencil', 'h-4 w-4') %>Editar</a>
      <% } %>
    </div>

    <% if (alertas.length) { %>
      <ul class="mt-6 space-y-2" role="list">
        <% alertas.forEach((a) => { %>
          <li class="aviso <%= estiloAlerta[a.nivel] %>"><%- icono(iconoAlerta[a.nivel]) %><strong><%= a.texto %>:</strong> <%= a.detalle %></li>
        <% }) %>
      </ul>
    <% } %>

    <%# Datos y documentos en una sola página (sin pestañas) %>
    <div class="mt-8 space-y-6">
      <div class="grid items-start gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">
          <% secciones.forEach((s) => { %><%- include('../partials/ficha-seccion', { s }) %><% }) %>
        </div>
        <aside class="space-y-6">
          <section class="card p-5">
            <h2 class="text-sm font-semibold text-slate-900">Contrato de encargado</h2>
            <p class="mt-3">
              <% if (p.tiene_contrato_encargado) { %>
                <span class="badge bg-green-50 text-green-700 ring-green-600/20"><%- icono('check', 'h-3 w-3') %>Firmado<%= p.fecha_firma_contrato ? ' el ' + fecha(p.fecha_firma_contrato) : '' %></span>
              <% } else { %>
                <span class="badge bg-red-50 font-semibold text-red-700 ring-red-600/40"><%- icono('file-x', 'h-3 w-3') %>No consta contrato firmado</span>
              <% } %>
            </p>
            <dl class="mt-4 space-y-3 border-t border-slate-100 pt-4 text-sm">
              <div class="flex items-center justify-between gap-3">
                <dt class="text-slate-500">Próxima revisión</dt>
                <dd class="text-right <%= p.fecha_revision_contrato ? 'text-slate-800' : 'italic text-slate-400' %>"><%= p.fecha_revision_contrato ? fecha(p.fecha_revision_contrato) : 'Sin fecha' %></dd>
              </div>
              <div class="flex items-center justify-between gap-3">
                <dt class="text-slate-500">Nivel ENS declarado</dt>
                <dd><span class="badge <%= nivelEnsClases[p.nivel_cumplimiento_ens] %>"><%= NIVELES_ENS[p.nivel_cumplimiento_ens] %></span></dd>
              </div>
            </dl>
          </section>
          <section class="card p-5">
            <h2 class="text-sm font-semibold text-slate-900">Gestión</h2>
            <dl class="mt-3 space-y-3 text-sm">
              <div class="flex items-center justify-between gap-3">
                <dt class="text-slate-500">Responsable</dt>
                <dd class="text-right font-medium <%= p.responsable ? 'text-slate-800' : 'italic text-slate-400' %>"><%= p.responsable ? p.responsable.nombre : 'Sin asignar' %></dd>
              </div>
              <div class="flex items-center justify-between gap-3">
                <dt class="text-slate-500">Documentos</dt>
                <dd><a href="#documentos" class="enlace"><%= p.documentos.length %> adjuntos</a></dd>
              </div>
              <div class="flex items-center justify-between gap-3">
                <dt class="text-slate-500">Última modificación</dt>
                <dd class="text-right text-slate-600"><%= fechaHora(p.updated_at) %></dd>
              </div>
            </dl>
          </section>
        </aside>
      </div>

      <%# --- Documentos (los enlaces y redirecciones a #documentos llegan aquí) --- %>
      <section id="documentos" class="scroll-mt-24 space-y-4" aria-labelledby="t-documentos">
        <div>
          <h2 id="t-documentos" class="flex items-center gap-2 text-base font-semibold text-slate-900"><%- icono('files', 'h-4 w-4 text-slate-400') %>Documentos <span class="font-normal text-slate-400">(<%= p.documentos.length %>)</span></h2>
          <p class="mt-1 text-sm text-slate-500">Contrato de encargado, anexos, certificados ENS/ISO, cláusulas de transferencia…</p>
        </div>
        <div class="tabla-contenedor">
          <% if (p.documentos.length === 0) { %>
            <div class="vacio"><%- icono('files', 'h-6 w-6 text-slate-300') %>No se ha adjuntado ningún documento.</div>
          <% } else { %>
            <table class="tabla">
              <thead>
                <tr><th>Documento</th><th>Tipo</th><th>Subido</th><th>Por</th><th class="text-right">Acciones</th></tr>
              </thead>
              <tbody>
                <% p.documentos.forEach((d) => { const url = '/proveedores/' + p.id + '/documentos/' + d.id; %>
                  <tr>
                    <td>
                      <span class="flex items-center gap-2 font-medium text-slate-800"><%- icono('file-text', 'h-4 w-4 text-red-500') %><%= d.nombre_documento %></span>
                      <span class="block text-xs text-slate-500"><%= d.nombre_archivo_original %> · <%= formatoTamano(d.tamano_bytes) %></span>
                    </td>
                    <td class="text-slate-600"><%= TIPOS_DOCUMENTO[d.tipo_documento] %></td>
                    <td class="whitespace-nowrap text-slate-600"><%= fechaHora(d.fecha_subida) %></td>
                    <td class="text-slate-600"><%= d.subido_por ? d.subido_por.nombre : '—' %></td>
                    <td class="whitespace-nowrap text-right">
                      <a href="<%= url %>" target="_blank" rel="noopener" class="btn-icono" title="Ver documento" aria-label="Ver <%= d.nombre_documento %>"><%- icono('eye', 'h-4 w-4') %></a>
                      <a href="<%= url %>?descargar=1" class="ml-1 btn-icono" title="Descargar" aria-label="Descargar <%= d.nombre_documento %>"><%- icono('download', 'h-4 w-4') %></a>
                      <% if (gestionaDocumentos) { %>
                        <form action="<%= url %>/eliminar" method="POST" class="inline" data-nombre="<%= d.nombre_documento %>"
                              onsubmit="return confirm('¿Eliminar el documento «' + this.dataset.nombre + '»? Se borrará el archivo del servidor.')">
                          <button type="submit" class="ml-1 btn-icono hover:border-red-200 hover:bg-red-50 hover:text-red-600" title="Eliminar documento" aria-label="Eliminar <%= d.nombre_documento %>"><%- icono('trash-2', 'h-4 w-4') %></button>
                        </form>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <% if (gestionaDocumentos) { %>
          <form action="/proveedores/<%= p.id %>/documentos" method="POST" enctype="multipart/form-data" class="card p-5 sm:p-6">
            <h2 class="flex items-center gap-2 text-base font-semibold text-slate-900"><%- icono('upload', 'h-4 w-4 text-slate-400') %>Subir documento</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-4 sm:items-end">
              <div class="sm:col-span-2">
                <label for="archivo" class="label">Archivo PDF (máx. <%= tamanoMaximoMb %> MB)</label>
                <input id="archivo" name="archivo" type="file" accept="application/pdf,.pdf" required
                       class="block w-full rounded-lg border border-slate-200 bg-white text-sm text-slate-600 file:mr-3 file:border-0 file:bg-marca-50 file:px-3 file:py-2.5 file:font-medium file:text-indigo-700 hover:file:bg-marca-100">
              </div>
              <div>
                <label for="nombre_documento" class="label">Nombre</label>
                <input id="nombre_documento" name="nombre_documento" type="text" required maxlength="200" placeholder="Ej.: Contrato encargado 2026" class="<%= inputClase %>">
              </div>
              <div>
                <label for="tipo_documento" class="label">Tipo</label>
                <select id="tipo_documento" name="tipo_documento" class="<%= inputClase %>">
                  <% Object.entries(TIPOS_DOCUMENTO).forEach(([v, etiqueta]) => { %>
                    <option value="<%= v %>"><%= etiqueta %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="mt-4 flex justify-end">
              <button type="submit" class="btn btn-primary"><%- icono('upload', 'h-4 w-4') %>Subir documento</button>
            </div>
          </form>
        <% } %>
      </section>
    </div>
  </main>
</body>
</html>
