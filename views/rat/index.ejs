<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Actividades RAT' }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">Actividades de tratamiento<%- include('../partials/area-badge') %></h1>
        <p class="subtitulo-pagina">Registro de Actividades de Tratamiento (art. 30 RGPD)</p>
      </div>
      <a href="/rat/nueva" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Nueva actividad
      </a>
    </div>

    <div class="mt-6 flex flex-wrap items-end gap-3">
      <%- include('../partials/filtro-sistema', { accion: '/rat', sistemas, sistema, conservar: {} }) %>
      <% if (sistema) { %>
        <a href="/rat" class="py-2.5 text-sm text-indigo-600 hover:underline">Quitar filtros</a>
      <% } %>
    </div>

    <div class="mt-6 tabla-contenedor">
      <% if (actividades.length === 0) { %>
        <p class="p-8 text-center text-slate-500">
          No hay actividades de tratamiento<%= sistema ? ' con el sistema seleccionado' : '' %>.
        </p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Finalidad</th>
              <th>Base legal</th>
              <th>Sistema</th>
              <th>Responsable</th>
            </tr>
          </thead>
          <tbody>
            <% actividades.forEach((a) => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3"><a href="/rat/<%= a.id %>" class="enlace-registro"><%= a.nombre %></a></td>
                <td class="px-4 py-3 text-slate-600 max-w-xs"><p class="line-clamp-2"><%= a.finalidad %></p></td>
                <td class="px-4 py-3 text-slate-600"><%= basesLegales[a.base_legal] %></td>
                <td class="px-4 py-3"><%- include('../partials/sistema-celda', { s: a.sistema }) %></td>
                <td class="px-4 py-3 text-slate-600">
                  <%= a.responsable.nombre %>
                  <% if (a.responsable.cargo) { %><span class="block text-xs text-slate-400"><%= a.responsable.cargo %></span><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
  <%- include('../partials/pie') %>
</body>
</html>
