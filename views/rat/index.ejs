<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Actividades RAT' }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">Actividades de tratamiento</h1>
        <p class="subtitulo-pagina">Registro de Actividades de Tratamiento (art. 30 RGPD)</p>
      </div>
      <a href="/rat/nueva" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Nueva actividad
      </a>
    </div>

    <% if (user.rol === 'ADMIN') { %>
      <form action="/rat" method="GET" class="mt-6 flex flex-wrap items-end gap-3">
        <div>
          <label for="area" class="label">Filtrar por área</label>
          <select id="area" name="area" onchange="this.form.submit()"
                  class="input w-auto">
            <option value="">Todas las áreas</option>
            <% areas.forEach((a) => { %>
              <option value="<%= a %>" <%= a === area ? 'selected' : '' %>><%= a %></option>
            <% }) %>
          </select>
        </div>
        <noscript><button type="submit" class="btn btn-secondary">Filtrar</button></noscript>
        <% if (area) { %>
          <a href="/rat" class="py-2 text-sm text-indigo-600 hover:underline">Quitar filtro</a>
        <% } %>
      </form>
    <% } %>

    <div class="mt-6 tabla-contenedor">
      <% if (actividades.length === 0) { %>
        <p class="p-8 text-center text-slate-500">
          No hay actividades de tratamiento<%= area ? ' en el área ' + area : '' %>.
        </p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Finalidad</th>
              <th>Base legal</th>
              <th>Responsable</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% actividades.forEach((a) => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 font-medium text-slate-800"><%= a.nombre %></td>
                <td class="px-4 py-3 text-slate-600 max-w-xs"><p class="line-clamp-2"><%= a.finalidad %></p></td>
                <td class="px-4 py-3 text-slate-600"><%= basesLegales[a.base_legal] %></td>
                <td class="px-4 py-3 text-slate-600">
                  <%= a.responsable.nombre %>
                  <% if (a.responsable.area) { %><span class="block text-xs text-slate-400"><%= a.responsable.area %></span><% } %>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a href="/rat/<%= a.id %>" class="btn btn-secondary btn-sm"><%- icono('eye', 'h-3.5 w-3.5') %>Ver</a>
                  <a href="/rat/<%= a.id %>/editar" class="ml-1 btn btn-primary btn-sm"><%- icono('pencil', 'h-3.5 w-3.5') %>Editar</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</body>
</html>
