<%
  const inputClase = 'input';
  const accion = actividad.id ? '/rat/' + actividad.id : '/rat';
  const volver = actividad.id ? '/rat/' + actividad.id : '/rat';
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Actividades RAT', href: '/rat' }, { texto: title }] }) %>
    <div class="flex items-center justify-between">
      <h1 class="titulo-pagina"><%= title %></h1>
    </div>

    <% if (errores.length) { %>
      <ul class="mt-6 rounded-xl border border-red-200 bg-red-50/60 px-4 py-3 text-sm text-red-800 list-disc list-inside space-y-0.5" role="alert">
        <% errores.forEach((e) => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <form action="<%= accion %>" method="POST" class="mt-6 space-y-6"
          x-data="{ transferencia: <%= actividad.transferencia_intl ? 'true' : 'false' %> }">

      <!-- 1. Datos básicos -->
      <fieldset class="card p-6 space-y-4">
        <legend class="float-left w-full mb-4 text-base font-semibold text-slate-900">1. Datos básicos</legend>
        <div class="clear-both">
          <label for="nombre" class="label">Nombre de la actividad</label>
          <input id="nombre" name="nombre" type="text" required value="<%= actividad.nombre || '' %>" class="<%= inputClase %>"
                 placeholder="Ej.: Gestión de nóminas">
        </div>
        <div>
          <label for="finalidad" class="label">Finalidad del tratamiento</label>
          <textarea id="finalidad" name="finalidad" rows="3" required class="<%= inputClase %>"><%= actividad.finalidad || '' %></textarea>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="base_legal" class="label">Base legal</label>
          <select id="base_legal" name="base_legal" required class="<%= inputClase %> bg-white">
            <option value="" disabled <%= actividad.base_legal ? '' : 'selected' %>>Selecciona una base legal</option>
            <% Object.entries(basesLegales).forEach(([valor, etiqueta]) => { %>
              <option value="<%= valor %>" <%= actividad.base_legal === valor ? 'selected' : '' %>><%= etiqueta %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="usuario_id" class="label">Responsable</label>
          <% if (user.rol === 'ADMIN') { %>
            <select id="usuario_id" name="usuario_id" required class="<%= inputClase %> bg-white">
              <% responsables.forEach((r) => { %>
                <option value="<%= r.id %>" <%= actividad.usuario_id === r.id ? 'selected' : '' %>>
                  <%= r.nombre %><%= r.area ? ' — ' + r.area : '' %>
                </option>
              <% }) %>
            </select>
          <% } else { %>
            <p class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-600">
              <%= actividad.responsable ? actividad.responsable.nombre : user.nombre %>
            </p>
          <% } %>
        </div>
        </div>
        <%- include('../partials/campo-sistema', { sistemas, valor: actividad.sistema_id }) %>
      </fieldset>

      <!-- 2. Datos e interesados -->
      <fieldset class="card p-6 space-y-4">
        <legend class="float-left w-full mb-4 text-base font-semibold text-slate-900">2. Datos e interesados</legend>
        <div class="clear-both">
          <label for="categorias_datos" class="label">Categorías de datos personales</label>
          <textarea id="categorias_datos" name="categorias_datos" rows="3" required class="<%= inputClase %>"
                    placeholder="Ej.: identificativos, datos bancarios, datos de salud…"><%= actividad.categorias_datos || '' %></textarea>
        </div>
        <div>
          <label for="categorias_interesados" class="label">Categorías de interesados</label>
          <textarea id="categorias_interesados" name="categorias_interesados" rows="2" required class="<%= inputClase %>"
                    placeholder="Ej.: empleados, clientes, proveedores…"><%= actividad.categorias_interesados || '' %></textarea>
        </div>
        <div>
          <label for="destinatarios" class="label">Destinatarios</label>
          <textarea id="destinatarios" name="destinatarios" rows="2" required class="<%= inputClase %>"
                    placeholder="Ej.: Agencia Tributaria, Seguridad Social, entidades bancarias…"><%= actividad.destinatarios || '' %></textarea>
        </div>
      </fieldset>

      <!-- 3. Conservación y transferencias -->
      <fieldset class="card p-6 space-y-4">
        <legend class="float-left w-full mb-4 text-base font-semibold text-slate-900">3. Conservación y transferencias</legend>
        <div class="clear-both">
          <label for="plazo_conservacion" class="label">Plazo de conservación</label>
          <input id="plazo_conservacion" name="plazo_conservacion" type="text" required value="<%= actividad.plazo_conservacion || '' %>"
                 class="<%= inputClase %>" placeholder="Ej.: 4 años desde la baja del empleado">
        </div>
        <div>
          <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700">
            <input type="checkbox" name="transferencia_intl" x-model="transferencia"
                   class="check" <%= actividad.transferencia_intl ? 'checked' : '' %>>
            Existen transferencias internacionales de datos
          </label>
        </div>
        <div x-show="transferencia" x-cloak>
          <label for="pais_transferencia" class="label">País de destino</label>
          <input id="pais_transferencia" name="pais_transferencia" type="text" value="<%= actividad.pais_transferencia || '' %>"
                 class="<%= inputClase %>" :required="transferencia" placeholder="Ej.: Estados Unidos">
        </div>
        <div>
          <label for="medidas_seguridad" class="label">Medidas de seguridad</label>
          <textarea id="medidas_seguridad" name="medidas_seguridad" rows="3" required class="<%= inputClase %>"
                    placeholder="Ej.: control de acceso por roles, cifrado, copias de seguridad…"><%= actividad.medidas_seguridad || '' %></textarea>
        </div>
      </fieldset>

      <div class="flex justify-end gap-3">
        <a href="<%= volver %>" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          <%= actividad.id ? 'Guardar cambios' : 'Crear actividad' %>
        </button>
      </div>
    </form>
  </main>
</body>
</html>
