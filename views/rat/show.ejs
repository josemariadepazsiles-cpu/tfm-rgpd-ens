<%
  const a = actividad;
  const campo = (etiqueta, valor, vacio, completo) => ({ etiqueta, valor, vacio, completo });
  const secciones = [
    { titulo: 'Datos básicos', icono: 'clipboard-list', campos: [
      campo('Finalidad', a.finalidad, null, true),
      campo('Base legal', basesLegales[a.base_legal], null, true),
      campo('Sistema asociado', a.sistema ? a.sistema.nombre : null, 'Ninguno · transversal'),
    ] },
    { titulo: 'Datos e interesados', icono: 'users', campos: [
      campo('Categorías de datos personales', a.categorias_datos, null, true),
      campo('Categorías de interesados', a.categorias_interesados),
      campo('Destinatarios', a.destinatarios),
    ] },
    { titulo: 'Conservación y transferencias', icono: 'archive', campos: [
      campo('Plazo de conservación', a.plazo_conservacion),
      campo('Transferencias internacionales', a.transferencia_intl ? 'Sí — ' + a.pais_transferencia : 'No'),
      campo('Medidas de seguridad', a.medidas_seguridad, null, true),
    ] },
  ];
  const conteo = { ALTO: 0, MEDIO: 0, BAJO: 0 };
  a.riesgos.forEach((r) => { if (conteo[r.nivel_riesgo] !== undefined) conteo[r.nivel_riesgo]++; });
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= area %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Actividades RAT', href: '/rat' }, { texto: a.nombre }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="eyebrow">Actividad de tratamiento</p>
        <h1 class="mt-1 titulo-pagina"><%= a.nombre %><%- include('../partials/area-badge') %></h1>
        <p class="mt-2 text-xs text-slate-500">Creada el <%= fechaHora(a.created_at) %> · Última modificación el <%= fechaHora(a.updated_at) %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <% if (user.rol === 'ADMIN') { %>
          <form action="/rat/<%= a.id %>/eliminar" method="POST"
                onsubmit="return confirm('¿Eliminar esta actividad de tratamiento?<%= a.riesgos.length ? ' También se eliminarán sus ' + a.riesgos.length + ' riesgos asociados.' : '' %> Esta acción no se puede deshacer.')">
            <button type="submit" class="btn btn-danger"><%- icono('trash-2', 'h-4 w-4') %>Eliminar</button>
          </form>
        <% } %>
        <a href="/rat/<%= a.id %>/editar" class="btn btn-primary"><%- icono('pencil', 'h-4 w-4') %>Editar</a>
      </div>
    </div>

    <div class="mt-8 grid items-start gap-6 lg:grid-cols-3">
      <div class="space-y-6 lg:col-span-2">
        <% secciones.forEach((s) => { %><%- include('../partials/ficha-seccion', { s }) %><% }) %>
      </div>

      <aside class="space-y-6">
        <section class="card p-5">
          <h2 class="text-sm font-semibold text-slate-900">Responsable</h2>
          <div class="mt-3 flex items-center gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-marca-50 text-xs font-semibold text-indigo-700"><%= iniciales(a.responsable.nombre) %></span>
            <div class="min-w-0 text-sm">
              <p class="truncate font-medium text-slate-800"><%= a.responsable.nombre %></p>
              <p class="truncate text-slate-500"><%= a.responsable.email %></p>
              <% if (a.responsable.area) { %><p class="truncate text-slate-500"><%= a.responsable.area %></p><% } %>
            </div>
          </div>
        </section>

        <section class="card p-5">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-sm font-semibold text-slate-900">Riesgos asociados (<%= a.riesgos.length %>)</h2>
            <a href="/riesgos/nuevo?actividad=<%= a.id %>" class="btn btn-secondary btn-sm"><%- icono('plus', 'h-3.5 w-3.5') %>Añadir</a>
          </div>
          <% if (a.riesgos.length === 0) { %>
            <p class="mt-3 text-sm text-slate-500">Esta actividad todavía no tiene riesgos evaluados.</p>
          <% } else { %>
            <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
              <span class="inline-flex items-center gap-1.5"><span class="punto bg-red-500"></span><%= conteo.ALTO %> altos</span>
              <span class="inline-flex items-center gap-1.5"><span class="punto bg-amber-500"></span><%= conteo.MEDIO %> medios</span>
              <span class="inline-flex items-center gap-1.5"><span class="punto bg-green-500"></span><%= conteo.BAJO %> bajos</span>
            </p>
            <ul class="mt-3 divide-y divide-slate-100 border-t border-slate-100">
              <% a.riesgos.forEach((r) => { %>
                <li class="flex items-center justify-between gap-3 py-2.5">
                  <a href="/riesgos/<%= r.id %>" class="min-w-0 text-sm text-slate-800 hover:text-indigo-600 hover:underline"><%= r.amenaza %></a>
                  <span class="shrink-0"><%- include('../partials/nivel-badge', { nivel: r.nivel_riesgo, nivelEtiquetas: niveles }) %></span>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </section>
      </aside>
    </div>
  </main>
</body>
</html>
