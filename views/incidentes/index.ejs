<%
  const selectClase = 'input w-auto';
  const vencidos = incidentes.filter((i) => i.plazo.tipo === 'vencido').length;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Incidentes / Brechas' }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">Incidentes / Brechas de seguridad</h1>
        <p class="subtitulo-pagina">Registro de incidentes y brechas de datos personales (arts. 33 y 34 RGPD)</p>
      </div>
      <a href="/incidentes/nuevo" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Nuevo incidente</a>
    </div>

    <%- include('../partials/filtro-alerta') %>

    <% if (vencidos && alerta !== 'aepd_vencido') { %>
      <div class="mt-6 aviso alerta-error" role="alert"><%- icono('triangle-alert') %>
        <strong><%= vencidos %> incidente(s)</strong> requieren notificación a la AEPD y han superado el plazo de 72 horas desde su detección.
      </div>
    <% } %>

    <form action="/incidentes" method="GET" class="mt-6 flex flex-wrap items-end gap-3">
      <% if (alerta) { %><input type="hidden" name="alerta" value="<%= alerta %>"><% } %>
      <div>
        <label for="estado" class="label">Estado</label>
        <select id="estado" name="estado" onchange="this.form.submit()" class="<%= selectClase %>">
          <option value="">Todos</option>
          <% Object.entries(ESTADOS_INCIDENTE).forEach(([valor, etiqueta]) => { %>
            <option value="<%= valor %>" <%= estado === valor ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="gravedad" class="label">Gravedad</label>
        <select id="gravedad" name="gravedad" onchange="this.form.submit()" class="<%= selectClase %>">
          <option value="">Todas</option>
          <% Object.entries(GRAVEDADES).forEach(([valor, etiqueta]) => { %>
            <option value="<%= valor %>" <%= gravedad === valor ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
      </div>
      <%- include('../partials/filtro-sistema', { sistemas, sistema }) %>
      <noscript><button type="submit" class="btn btn-secondary">Filtrar</button></noscript>
      <% if (estado || gravedad || alerta || sistema) { %>
        <a href="/incidentes" class="py-2 text-sm text-indigo-600 hover:underline">Quitar filtros</a>
      <% } %>
    </form>

    <div class="mt-4 tabla-contenedor">
      <% if (incidentes.length === 0) { %>
        <p class="p-8 text-center text-slate-500">
          <%= estado || gravedad || alerta || sistema ? 'No hay incidentes con esos filtros.' : 'No se ha registrado ningún incidente.' %>
        </p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Incidente</th>
              <th>Sistema</th>
              <th>Tipo</th>
              <th>Gravedad</th>
              <th>Estado</th>
              <th>Detección</th>
              <th>Responsable</th>
              <th>Notificación AEPD</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% incidentes.forEach((i) => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 max-w-xs">
                  <a href="/incidentes/<%= i.id %>" class="font-medium text-slate-800 hover:text-indigo-600 hover:underline line-clamp-2"><%= i.titulo %></a>
                </td>
                <td class="px-4 py-3"><%- include('../partials/sistema-celda', { s: i.sistema }) %></td>
                <td class="px-4 py-3 text-slate-600"><%= TIPOS[i.tipo] %></td>
                <td class="px-4 py-3"><%- include('../partials/incidente-badges', { gravedadBadge: i.gravedad }) %></td>
                <td class="px-4 py-3"><%- include('../partials/incidente-badges', { estadoBadge: i.estado }) %></td>
                <td class="px-4 py-3 text-slate-600 whitespace-nowrap"><%= fechaHora(i.fecha_deteccion) %></td>
                <td class="px-4 py-3 text-slate-600 whitespace-nowrap">
                  <% if (!i.responsable) { %>
                    <span class="text-slate-400 italic">Sin asignar</span>
                  <% } else { %>
                    <%= i.responsable.nombre %><% if (i.responsable.id === user.id) { %> <strong>(tú)</strong><% } %>
                  <% } %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap"><%- include('../partials/plazo-aepd', { plazo: i.plazo }) %></td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a href="/incidentes/<%= i.id %>" class="btn btn-secondary btn-sm"><%- icono('eye', 'h-3.5 w-3.5') %>Ver</a>
                  <% if (i.gestionable) { %>
                    <a href="/incidentes/<%= i.id %>/editar" class="ml-1 btn btn-primary btn-sm"><%- icono('pencil', 'h-3.5 w-3.5') %>Editar</a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</body>
</html>
