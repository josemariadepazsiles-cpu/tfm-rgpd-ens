<%
  const campo = (etiqueta, valor, vacio) => ({ etiqueta, valor, vacio });
  const secciones = [
    { titulo: 'Qué ha pasado', campos: [
      campo('Descripción', incidente.descripcion),
      campo('Tipo de brecha', TIPOS[incidente.tipo]),
      campo('Fecha y hora de detección', fechaHora(incidente.fecha_deteccion)),
      campo('Fecha y hora de ocurrencia', incidente.fecha_ocurrencia ? fechaHora(incidente.fecha_ocurrencia) : null, 'Desconocida'),
    ] },
    { titulo: 'Datos afectados', campos: [
      campo('Categorías de datos afectados', incidente.categorias_datos_afectados),
      campo('Número estimado de afectados', incidente.numero_afectados_estimado !== null ? incidente.numero_afectados_estimado.toLocaleString('es-ES') : null, 'Sin estimar'),
    ] },
    { titulo: 'Gestión', campos: [
      campo('Responsable del caso', incidente.responsable ? incidente.responsable.nombre : null, 'Sin asignar'),
      campo('Medidas adoptadas', incidente.medidas_adoptadas, 'Sin medidas registradas todavía'),
    ] },
  ];
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-slate-100">
  <%- include('../partials/nav') %>

  <main class="max-w-4xl mx-auto px-4 py-8">
    <%- include('../partials/flash') %>

    <a href="/incidentes" class="text-sm text-indigo-600 hover:underline">&larr; Volver a incidentes</a>

    <div class="mt-2 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-800"><%= incidente.titulo %></h1>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <%- include('../partials/incidente-badges', { gravedadBadge: incidente.gravedad }) %>
          <%- include('../partials/incidente-badges', { estadoBadge: incidente.estado }) %>
          <span class="text-xs text-slate-500">
            Reportado el <%= fechaHora(incidente.created_at) %><%= incidente.creado_por ? ' por ' + incidente.creado_por.nombre : '' %>
          </span>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/incidentes/<%= incidente.id %>/historial" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-700 hover:bg-slate-50 transition">
          Ver historial (<%= incidente._count.historial %>)
        </a>
        <% if (gestionable) { %>
          <a href="/incidentes/<%= incidente.id %>/editar" class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">Editar</a>
        <% } %>
      </div>
    </div>

    <% if (plazo.tipo === 'vencido') { %>
      <div class="mt-6 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
        <strong>¡Plazo AEPD superado!</strong> Este incidente requiere notificación a la AEPD y han pasado más de <%= plazoHoras %> h
        desde su detección (el plazo venció el <%= fechaHora(plazo.limite) %>, hace <%= plazo.horasRetraso %> h).
        Si se notifica fuera de plazo, deben indicarse los motivos del retraso (art. 33.1).
      </div>
    <% } else if (plazo.tipo === 'pendiente') { %>
      <div class="mt-6 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800" role="status">
        Notificación a la AEPD pendiente: quedan <strong><%= plazo.horasRestantes %> h</strong> (vence el <%= fechaHora(plazo.limite) %>).
      </div>
    <% } %>

    <% if (gestionable) { %>
      <form action="/incidentes/<%= incidente.id %>/estado" method="POST"
            class="mt-6 bg-white rounded-2xl shadow p-4 flex flex-wrap items-end gap-3">
        <div>
          <label for="estado" class="block text-sm font-medium text-slate-700">Cambiar estado</label>
          <select id="estado" name="estado" class="mt-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <% Object.entries(ESTADOS_INCIDENTE).forEach(([v, etiqueta]) => { %>
              <option value="<%= v %>" <%= incidente.estado === v ? 'selected' : '' %>><%= etiqueta %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition">Aplicar</button>
        <p class="text-xs text-slate-500">Se registrará en el historial con la fecha y hora actuales.</p>
      </form>
    <% } %>

    <div class="mt-6 space-y-6">
      <% secciones.forEach((s) => { %>
        <section class="bg-white rounded-2xl shadow p-6">
          <h2 class="text-lg font-semibold text-slate-800"><%= s.titulo %></h2>
          <dl class="mt-4 space-y-4">
            <% s.campos.forEach((c) => { %>
              <div>
                <dt class="text-sm font-medium text-slate-500"><%= c.etiqueta %></dt>
                <dd class="mt-1 whitespace-pre-line <%= c.valor ? 'text-slate-800' : 'text-slate-400 italic' %>"><%= c.valor || c.vacio %></dd>
              </div>
            <% }) %>
          </dl>
        </section>
      <% }) %>

      <section class="bg-white rounded-2xl shadow p-6">
        <h2 class="text-lg font-semibold text-slate-800">Notificaciones</h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-sm font-medium text-slate-500">AEPD (art. 33)</dt>
            <dd class="mt-1"><%- include('../partials/plazo-aepd', { plazo }) %></dd>
            <% if (incidente.fecha_notificacion_aepd) { %><dd class="mt-1 text-sm text-slate-600"><%= fechaHora(incidente.fecha_notificacion_aepd) %></dd><% } %>
          </div>
          <div>
            <dt class="text-sm font-medium text-slate-500">Afectados (art. 34)</dt>
            <dd class="mt-1 text-sm text-slate-800">
              <% if (!incidente.requiere_notificacion_afectados) { %>
                <span class="text-xs text-slate-400">No requiere</span>
              <% } else if (incidente.fecha_notificacion_afectados) { %>
                Comunicada el <%= fechaHora(incidente.fecha_notificacion_afectados) %>
              <% } else { %>
                <span class="inline-flex rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800 ring-1 ring-inset ring-amber-600/30">Pendiente</span>
              <% } %>
            </dd>
          </div>
        </dl>
      </section>
    </div>

    <p class="mt-6 text-xs text-slate-400">Última modificación el <%= fechaHora(incidente.updated_at) %></p>
  </main>
</body>
</html>
