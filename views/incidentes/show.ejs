<%
  const campo = (etiqueta, valor, vacio, completo) => ({ etiqueta, valor, vacio, completo });
  const secciones = [
    { titulo: 'Qué ha pasado', icono: 'file-text', campos: [
      campo('Descripción', incidente.descripcion, null, true),
      campo('Tipo de brecha', TIPOS[incidente.tipo]),
      campo('Fecha y hora de detección', fechaHora(incidente.fecha_deteccion)),
      campo('Fecha y hora de ocurrencia', incidente.fecha_ocurrencia ? fechaHora(incidente.fecha_ocurrencia) : null, 'Desconocida'),
    ] },
    { titulo: 'Datos afectados', icono: 'database', campos: [
      campo('Categorías de datos afectados', incidente.categorias_datos_afectados),
      campo('Número estimado de afectados', incidente.numero_afectados_estimado !== null ? incidente.numero_afectados_estimado.toLocaleString('es-ES') : null, 'Sin estimar'),
    ] },
    { titulo: 'Medidas adoptadas', icono: 'shield-check', campos: [
      campo('Medidas para contener la brecha y mitigar sus efectos', incidente.medidas_adoptadas, 'Sin medidas registradas todavía', true),
    ] },
  ];
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= area %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Incidentes / Brechas', href: '/incidentes' }, { texto: incidente.titulo }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <h1 class="titulo-pagina"><%= incidente.titulo %><%- include('../partials/area-badge') %></h1>
        <div class="mt-2.5 flex flex-wrap items-center gap-2">
          <%- include('../partials/incidente-badges', { gravedadBadge: incidente.gravedad }) %>
          <%- include('../partials/incidente-badges', { estadoBadge: incidente.estado }) %>
          <span class="text-xs text-slate-500">Reportado el <%= fechaHora(incidente.created_at) %><%= incidente.creado_por ? ' por ' + incidente.creado_por.nombre : '' %></span>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/incidentes/<%= incidente.id %>/historial" class="btn btn-secondary"><%- icono('history', 'h-4 w-4') %>Ver historial (<%= incidente._count.historial %>)</a>
        <% if (gestionable) { %>
          <a href="/incidentes/<%= incidente.id %>/editar" class="btn btn-primary"><%- icono('pencil', 'h-4 w-4') %>Editar</a>
        <% } %>
      </div>
    </div>

    <% if (plazo.tipo === 'vencido') { %>
      <div class="mt-6 aviso alerta-error" role="alert"><%- icono('triangle-alert') %>
        <strong>¡Plazo AEPD superado!</strong> Este incidente requiere notificación a la AEPD y han pasado más de <%= plazoHoras %> h
        desde su detección (el plazo venció el <%= fechaHora(plazo.limite) %>, hace <%= plazo.horasRetraso %> h).
        Si se notifica fuera de plazo, deben indicarse los motivos del retraso (art. 33.1).
      </div>
    <% } else if (plazo.tipo === 'pendiente') { %>
      <div class="mt-6 aviso alerta-aviso" role="status"><%- icono('clock') %>
        Notificación a la AEPD pendiente: quedan <strong><%= plazo.horasRestantes %> h</strong> (vence el <%= fechaHora(plazo.limite) %>).
      </div>
    <% } %>

    <div class="mt-6 grid items-start gap-6 lg:grid-cols-3">
      <div class="space-y-6 lg:col-span-2">
        <% secciones.forEach((s) => { %><%- include('../partials/ficha-seccion', { s }) %><% }) %>
      </div>

      <aside class="space-y-6">
        <section class="card p-5">
          <h2 class="text-sm font-semibold text-slate-900">Estado del incidente</h2>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <%- include('../partials/incidente-badges', { estadoBadge: incidente.estado }) %>
            <%- include('../partials/incidente-badges', { gravedadBadge: incidente.gravedad }) %>
          </div>
          <% if (gestionable) { %>
            <form action="/incidentes/<%= incidente.id %>/estado" method="POST" class="mt-4 space-y-2 border-t border-slate-100 pt-4">
              <label for="estado" class="label">Cambiar estado</label>
              <div class="flex gap-2">
                <select id="estado" name="estado" class="input">
                  <% Object.entries(ESTADOS_INCIDENTE).forEach(([v, etiqueta]) => { %>
                    <option value="<%= v %>" <%= incidente.estado === v ? 'selected' : '' %>><%= etiqueta %></option>
                  <% }) %>
                </select>
                <button type="submit" class="btn btn-primary">Aplicar</button>
              </div>
              <p class="ayuda">Se registrará en el historial con la fecha y hora actuales.</p>
            </form>
          <% } %>
        </section>

        <section class="card p-5">
          <h2 class="text-sm font-semibold text-slate-900">Notificaciones</h2>
          <dl class="mt-3 space-y-4">
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">AEPD (art. 33)</dt>
              <dd class="mt-1.5"><%- include('../partials/plazo-aepd', { plazo }) %></dd>
              <% if (incidente.fecha_notificacion_aepd) { %><dd class="mt-1 text-sm text-slate-600"><%= fechaHora(incidente.fecha_notificacion_aepd) %></dd><% } %>
            </div>
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Afectados (art. 34)</dt>
              <dd class="mt-1.5 text-sm text-slate-800">
                <% if (!incidente.requiere_notificacion_afectados) { %>
                  <span class="text-xs text-slate-400">No requiere</span>
                <% } else if (incidente.fecha_notificacion_afectados) { %>
                  <span class="badge bg-green-50 text-green-700 ring-green-600/20"><%- icono('check', 'h-3 w-3') %>Comunicada</span>
                  <span class="mt-1 block text-slate-600"><%= fechaHora(incidente.fecha_notificacion_afectados) %></span>
                <% } else { %>
                  <span class="badge bg-amber-50 text-amber-800 ring-amber-600/25"><%- icono('clock', 'h-3 w-3') %>Pendiente</span>
                <% } %>
              </dd>
            </div>
          </dl>
        </section>

        <section class="card p-5">
          <h2 class="text-sm font-semibold text-slate-900">Gestión</h2>
          <dl class="mt-3 space-y-3 text-sm">
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-500">Sistema afectado</dt>
              <dd class="text-right"><% if (incidente.sistema) { %><a href="/sistemas/<%= incidente.sistema.id %>" class="enlace"><%= incidente.sistema.nombre %></a><% } else { %><span class="italic text-slate-400">Ninguno · transversal</span><% } %></dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-500">Responsable</dt>
              <dd class="text-right font-medium <%= incidente.responsable ? 'text-slate-800' : 'italic text-slate-400' %>"><%= incidente.responsable ? incidente.responsable.nombre : 'Sin asignar' %></dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-500">Cambios de estado</dt>
              <dd><a href="/incidentes/<%= incidente.id %>/historial" class="enlace"><%= incidente._count.historial %> registrados</a></dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-500">Última modificación</dt>
              <dd class="text-right text-slate-600"><%= fechaHora(incidente.updated_at) %></dd>
            </div>
          </dl>
        </section>
      </aside>
    </div>
  </main>
</body>
</html>
