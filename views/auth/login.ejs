<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-white">
  <div class="flex min-h-screen">

    <%# ====== Panel izquierdo: identidad de la plataforma (decorativo) ====== %>
    <section class="relative hidden overflow-hidden bg-gradient-to-br from-slate-50 via-[#eef1fb] to-[#e6e9fb] lg:flex lg:w-[58%] lg:flex-col lg:justify-between lg:px-14 lg:py-12 xl:px-20">
      <%# Retícula muy sutil de fondo %>
      <svg class="pointer-events-none absolute inset-0 h-full w-full text-indigo-900/[0.035]" aria-hidden="true">
        <defs><pattern id="reticula" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0v32" fill="none" stroke="currentColor"/></pattern></defs>
        <rect width="100%" height="100%" fill="url(#reticula)"/>
      </svg>

      <div class="relative flex items-center gap-2.5">
        <%- include('../partials/logo', { tamano: 'h-9 w-9' }) %>
        <span class="leading-tight">
          <span class="block font-semibold tracking-tight text-slate-900"><%= producto.nombre %></span>
          <span class="block text-xs text-slate-500"><%= producto.lema %></span>
        </span>
      </div>

      <div class="relative grid items-center gap-8 2xl:grid-cols-[1fr_minmax(0,440px)] 2xl:gap-10">
        <div class="max-w-md">
          <p class="eyebrow">RGPD · ENS · Inteligencia Artificial</p>
          <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-900 xl:text-[44px] xl:leading-[1.1]">Cumplimiento inteligente.</h1>
          <p class="mt-3 text-xl font-medium text-indigo-700">Protege. Analiza. Cumple.</p>
          <p class="mt-5 text-[15px] leading-relaxed text-slate-600">
            Inteligencia artificial para gestionar el cumplimiento normativo, la protección de datos y la seguridad de la información.
          </p>
        </div>

        <%# Ilustración: mapa de los módulos RGPD y ENS alrededor del escudo de la plataforma %>
        <img src="/img/mapa-modulos.png" width="760" height="760" alt="" aria-hidden="true" class="relative mx-auto hidden w-full max-w-[340px] select-none xl:block 2xl:max-w-[440px]">
      </div>

      <p class="relative text-xs text-slate-500">Reglamento (UE) 2016/679 · Real Decreto 311/2022 (ENS)</p>
    </section>

    <%# ====== Panel derecho: acceso ====== %>
    <main data-area="<%= areaNormativa %>" class="flex w-full items-center justify-center px-5 py-12 sm:px-10 lg:w-[42%]">
      <div class="w-full max-w-sm">
        <div class="flex items-center gap-3">
          <%- include('../partials/logo', { tamano: 'h-11 w-11' }) %>
          <div class="leading-tight">
            <p class="text-sm font-bold tracking-[0.14em] text-slate-900">COMPLIANCE AI</p>
            <p class="text-xs text-slate-500"><%= producto.lema %></p>
          </div>
        </div>

        <h2 class="mt-10 text-[28px] font-semibold tracking-tight text-slate-900">Bienvenido de nuevo</h2>
        <p class="mt-1.5 text-sm text-slate-500">Accede a tu plataforma de cumplimiento.</p>

        <% if (error) { %>
          <div class="alerta alerta-error mt-6" role="alert">
            <%- icono('circle-alert', 'mt-0.5 h-4 w-4') %><span><%= error %></span>
          </div>
        <% } %>

        <form action="/login" method="POST" class="mt-8 space-y-5" x-data="{ ver: false, enviando: false, olvido: false }" @submit="enviando = true">
          <div>
            <label for="email" class="label">Email</label>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%- icono('mail', 'h-4 w-4') %></span>
              <input id="email" name="email" type="email" required autocomplete="email" autofocus
                     value="<%= email %>" placeholder="nombre@organizacion.es" class="input pl-10">
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between">
              <label for="password" class="label">Contraseña</label>
              <button type="button" class="mb-1.5 text-xs font-medium text-indigo-600 hover:text-indigo-700" @click="olvido = !olvido" :aria-expanded="olvido" aria-controls="ayuda-olvido">
                ¿Has olvidado tu contraseña?
              </button>
            </div>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%- icono('lock', 'h-4 w-4') %></span>
              <input id="password" name="password" :type="ver ? 'text' : 'password'" type="password" required autocomplete="current-password"
                     placeholder="••••••••" class="input pl-10 pr-10">
              <button type="button" class="absolute inset-y-0 right-0 flex items-center rounded-r-lg px-3 text-slate-400 hover:text-slate-600"
                      @click="ver = !ver" :aria-label="ver ? 'Ocultar contraseña' : 'Mostrar contraseña'" aria-label="Mostrar contraseña">
                <span x-show="!ver"><%- icono('eye', 'h-4 w-4') %></span>
                <span x-show="ver" x-cloak><%- icono('eye-off', 'h-4 w-4') %></span>
              </button>
            </div>
            <p id="ayuda-olvido" x-show="olvido" x-cloak x-transition.opacity class="alerta alerta-info mt-3 text-xs">
              <%- icono('info', 'mt-0.5 h-4 w-4') %><span>Por seguridad, las contraseñas las restablece el administrador de la plataforma. Contacta con él para recuperar el acceso.</span>
            </p>
          </div>

          <button type="submit" class="btn btn-primary w-full py-2.5 text-[15px]" :disabled="enviando">
            <span x-show="!enviando" class="inline-flex items-center gap-2">Acceder a la plataforma <%- icono('arrow-right', 'h-4 w-4') %></span>
            <span x-show="enviando" x-cloak class="inline-flex items-center gap-2">
              <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity=".3" stroke-width="3"/><path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
              Accediendo…
            </span>
          </button>
        </form>

        <p class="mt-8 flex items-center justify-center gap-2 text-xs text-slate-500">
          <%- icono('shield-check', 'h-4 w-4 text-emerald-600') %>Acceso seguro · Datos protegidos
        </p>
        <%- include('../partials/pie', { compacto: true }) %>
      </div>
    </main>
  </div>
</body>
</html>
