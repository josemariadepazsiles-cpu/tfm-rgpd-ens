<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main class="mx-auto max-w-2xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <%- include('../partials/migas', { migas: [{ texto: 'Administración' }, { texto: 'Registrar usuario' }] }) %>

    <h1 class="titulo-pagina">Registrar usuario</h1>
    <p class="subtitulo-pagina">Da de alta a una persona de la organización y asígnale su rol en la plataforma.</p>

    <% if (exito) { %>
      <div class="alerta alerta-exito mt-6 items-center" role="status">
        <%- icono('circle-check', 'h-5 w-5') %><span><%= exito %></span>
      </div>
    <% } %>

    <% if (errores.length) { %>
      <ul class="mt-6 list-inside list-disc space-y-0.5 rounded-xl border border-red-200 bg-red-50/60 px-4 py-3 text-sm text-red-800" role="alert">
        <% errores.forEach((e) => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <form action="/registro" method="POST" class="mt-6 space-y-6">
      <fieldset class="form-seccion space-y-5">
        <legend>Datos de la persona</legend>
        <div class="clear-both grid gap-5 sm:grid-cols-2">
          <div>
            <label for="nombre" class="label">Nombre y apellidos</label>
            <input id="nombre" name="nombre" type="text" required value="<%= datos.nombre || '' %>" class="input">
          </div>
          <div>
            <label for="area" class="label">Área <span class="font-normal text-slate-400">(opcional)</span></label>
            <input id="area" name="area" type="text" value="<%= datos.area || '' %>" class="input" placeholder="Ej.: Recursos Humanos">
          </div>
        </div>
      </fieldset>

      <fieldset class="form-seccion space-y-5">
        <legend>Acceso y rol</legend>
        <div class="clear-both">
          <label for="email" class="label">Email</label>
          <input id="email" name="email" type="email" required autocomplete="off" value="<%= datos.email || '' %>" class="input" placeholder="nombre@organizacion.es">
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="password" class="label">Contraseña inicial</label>
            <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" class="input">
            <p class="ayuda">Mínimo 8 caracteres.</p>
          </div>
          <div>
            <label for="rol" class="label">Rol</label>
            <select id="rol" name="rol" required class="input">
              <% Object.entries(roles).forEach(([valor, etiqueta]) => { %>
                <option value="<%= valor %>" <%= (datos.rol || 'USUARIO') === valor ? 'selected' : '' %>><%= etiqueta %></option>
              <% }) %>
            </select>
            <p class="ayuda">El Administrador gestiona la estructura de todos los módulos.</p>
          </div>
        </div>
      </fieldset>

      <div class="flex justify-end gap-3">
        <a href="/dashboard" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary"><%- icono('user-plus', 'h-4 w-4') %>Crear usuario</button>
      </div>
    </form>
  </main>
</body>
</html>
