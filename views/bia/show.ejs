<%
  const p = proceso;
  const inputClase = 'input';
  const campo = (etiqueta, valor, vacio, completo) => ({ etiqueta, valor, vacio, completo });
  const secciones = [
    { titulo: 'Proceso', icono: 'workflow', campos: [
      campo('Descripción', p.descripcion, 'Sin descripción', true),
      campo('Departamento responsable', p.departamento_responsable),
      campo('Sistema del que depende', p.sistema ? p.sistema.nombre : null, 'Ninguno'),
    ] },
    { titulo: 'Impacto de la interrupción', icono: 'trending-down', campos: [
      campo('Impacto económico', p.impacto_economico, 'No evaluado', true),
      campo('Impacto legal y reputacional', p.impacto_legal_reputacional, 'No evaluado', true),
    ] },
    { titulo: 'Continuidad', icono: 'life-buoy', campos: [
      campo('Recursos mínimos necesarios', p.recursos_minimos_necesarios, 'No definidos', true),
      campo('Estrategia de continuidad', p.estrategia_continuidad, 'No definida', true),
    ] },
  ];
  const pestanas = [
    { id: 'ficha', texto: 'Ficha del proceso', icono: 'file-text' },
    { id: 'pruebas', texto: 'Pruebas de continuidad', icono: 'activity', contador: p.pruebas.length },
  ];
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'ENS' }, { texto: 'BIA y Continuidad', href: '/bia' }, { texto: proceso.nombre }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="eyebrow">Proceso de negocio</p>
        <h1 class="mt-1 titulo-pagina"><%= p.nombre %><%- include('../partials/area-badge') %></h1>
        <div class="mt-2.5 flex flex-wrap items-center gap-2">
          <span class="badge <%= criticidadClases[p.criticidad] %>">Criticidad <%= CRITICIDADES[p.criticidad].toLowerCase() %></span>
          <span class="badge <%= estadoRevisionClases[p.estado_revision] %>"><%= ESTADOS_REVISION_BIA[p.estado_revision] %></span>
          <% alertas.forEach((a) => { %>
            <span class="badge <%= alertaBiaClases[a.nivel] %>"><%- icono(a.nivel === 'rojo' ? 'triangle-alert' : 'calendar-clock', 'h-3 w-3') %><%= a.texto %></span>
          <% }) %>
        </div>
      </div>
      <% if (editable) { %>
        <div class="flex shrink-0 items-start gap-2">
          <a href="/bia/<%= p.id %>/editar" class="btn btn-primary"><%- icono('pencil', 'h-4 w-4') %>Editar</a>
          <% if (user.rol === 'ADMIN') { %>
            <form action="/bia/<%= p.id %>/eliminar" method="POST" data-nombre="<%= p.nombre %>"
                  onsubmit="return confirm('¿Eliminar el proceso «' + this.dataset.nombre + '»?<%= p.pruebas.length ? ' Se borrarán también sus ' + p.pruebas.length + ' pruebas de continuidad.' : '' %> Esta acción no se puede deshacer.')">
              <button type="submit" class="btn btn-danger"><%- icono('trash-2', 'h-4 w-4') %>Eliminar</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>

    <% if (alertas.length) { %>
      <ul class="mt-6 space-y-2">
        <% alertas.forEach((a) => { %>
          <li class="aviso <%= a.nivel === 'rojo' ? 'alerta-error' : 'alerta-aviso' %>"><%- icono(a.nivel === 'rojo' ? 'triangle-alert' : 'calendar-clock') %><strong><%= a.texto %>:</strong> <%= a.detalle %>.</li>
        <% }) %>
      </ul>
    <% } %>

    <section class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Objetivos de recuperación">
      <% [
        { t: 'RTO', v: formatoHoras(p.rto_horas), d: 'Interrupción máxima admisible', i: 'timer' },
        { t: 'RPO', v: formatoHoras(p.rpo_horas), d: 'Pérdida de datos máxima', i: 'database-backup' },
        { t: 'Último análisis', v: p.fecha_ultimo_analisis ? fecha(p.fecha_ultimo_analisis) : '—', d: ESTADOS_REVISION_BIA[p.estado_revision], i: 'clipboard-check' },
      ].forEach((k) => { %>
        <div class="card p-5">
          <p class="flex items-center gap-2 text-sm font-medium text-slate-500"><%- icono(k.i, 'h-4 w-4 text-slate-400') %><%= k.t %></p>
          <p class="mt-2 text-xl font-semibold tracking-tight text-slate-900"><%= k.v %></p>
          <p class="mt-0.5 text-xs text-slate-500"><%= k.d %></p>
        </div>
      <% }) %>
      <div class="card p-5">
        <p class="flex items-center gap-2 text-sm font-medium text-slate-500"><%- icono('activity', 'h-4 w-4 text-slate-400') %>Última prueba</p>
        <% if (ultima) { %>
          <p class="mt-2 text-xl font-semibold tracking-tight text-slate-900"><%= fecha(ultima.fecha_prueba) %></p>
          <span class="badge mt-1 <%= resultadoClases[ultima.resultado] %>"><%= RESULTADOS_PRUEBA[ultima.resultado] %></span>
        <% } else { %>
          <p class="mt-2 text-xl font-semibold tracking-tight text-slate-400">Ninguna</p>
          <p class="mt-0.5 text-xs text-slate-500">Sin pruebas registradas</p>
        <% } %>
      </div>
    </section>

    <div class="mt-8" x-data='pestanas("ficha", <%= JSON.stringify(pestanas.map((t) => t.id)) %>)'>
      <%- include('../partials/pestanas', { pestanas }) %>

      <div x-show="tab === 'ficha'" role="tabpanel" id="panel-ficha" aria-labelledby="tab-ficha" class="mt-6 grid items-start gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">
          <% secciones.forEach((s) => { %><%- include('../partials/ficha-seccion', { s }) %><% }) %>
        </div>
        <aside class="card p-5">
          <h2 class="text-sm font-semibold text-slate-900">Gestión</h2>
          <dl class="mt-3 space-y-3 text-sm">
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-500">Responsable</dt>
              <dd class="text-right font-medium <%= p.responsable ? 'text-slate-800' : 'italic text-slate-400' %>"><%= p.responsable ? p.responsable.nombre : 'Sin asignar' %></dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-500">Registrado</dt>
              <dd class="text-right text-slate-600"><%= fecha(p.created_at) %><%= p.creado_por ? ' · ' + p.creado_por.nombre : '' %></dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-slate-500">Última modificación</dt>
              <dd class="text-right text-slate-600"><%= fechaHora(p.updated_at) %></dd>
            </div>
          </dl>
        </aside>
      </div>

      <div x-show="tab === 'pruebas'" x-cloak role="tabpanel" id="panel-pruebas" aria-labelledby="tab-pruebas" class="mt-6 space-y-6">
        <div class="tabla-contenedor">
          <% if (p.pruebas.length === 0) { %>
            <div class="vacio"><%- icono('activity', 'h-6 w-6 text-slate-300') %>No se ha registrado ninguna prueba.</div>
          <% } else { %>
            <table class="tabla">
              <thead>
                <tr><th>Fecha</th><th>Tipo</th><th>Resultado</th><th>Observaciones</th><th>Realizada por</th></tr>
              </thead>
              <tbody>
                <% p.pruebas.forEach((t) => { %>
                  <tr>
                    <td class="whitespace-nowrap text-slate-700 tabular-nums"><%= fechaHora(t.fecha_prueba) %></td>
                    <td class="text-slate-700"><%= TIPOS_PRUEBA[t.tipo_prueba] %></td>
                    <td><span class="badge <%= resultadoClases[t.resultado] %>"><%= RESULTADOS_PRUEBA[t.resultado] %></span></td>
                    <td class="max-w-md whitespace-pre-line text-slate-600"><%= t.observaciones || '—' %></td>
                    <td class="text-slate-600"><%= t.realizado_por ? t.realizado_por.nombre : '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <% if (editable) { %>
          <form action="/bia/<%= p.id %>/pruebas" method="POST" class="card p-5 sm:p-6" x-data="{ resultado: 'SATISFACTORIO' }">
            <h2 class="flex items-center gap-2 text-base font-semibold text-slate-900"><%- icono('plus', 'h-4 w-4 text-slate-400') %>Registrar nueva prueba</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-3">
              <div>
                <label for="fecha_prueba" class="label">Fecha y hora</label>
                <input id="fecha_prueba" name="fecha_prueba" type="datetime-local" required value="<%= aInputFechaHora(new Date()) %>" class="<%= inputClase %>">
              </div>
              <div>
                <label for="tipo_prueba" class="label">Tipo de prueba</label>
                <select id="tipo_prueba" name="tipo_prueba" class="<%= inputClase %>">
                  <% Object.entries(TIPOS_PRUEBA).forEach(([v, etiqueta]) => { %><option value="<%= v %>"><%= etiqueta %></option><% }) %>
                </select>
              </div>
              <div>
                <label for="resultado" class="label">Resultado</label>
                <select id="resultado" name="resultado" x-model="resultado" class="<%= inputClase %>">
                  <% Object.entries(RESULTADOS_PRUEBA).forEach(([v, etiqueta]) => { %><option value="<%= v %>"><%= etiqueta %></option><% }) %>
                </select>
              </div>
              <div class="sm:col-span-3">
                <label for="observaciones" class="label">
                  Observaciones <span class="font-normal text-slate-400" x-show="resultado === 'SATISFACTORIO'">(opcional)</span>
                </label>
                <textarea id="observaciones" name="observaciones" rows="3" class="<%= inputClase %>" :required="resultado !== 'SATISFACTORIO'"
                          placeholder="Alcance de la prueba, tiempos de recuperación obtenidos, incidencias detectadas…"></textarea>
              </div>
            </div>
            <div class="mt-4 flex justify-end">
              <button type="submit" class="btn btn-primary"><%- icono('check', 'h-4 w-4') %>Registrar prueba</button>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>
