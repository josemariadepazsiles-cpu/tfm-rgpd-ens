<%
  const selectClase = 'input w-auto';
  const conAlertaRoja = procesos.filter((p) => p.alertas.some((a) => a.nivel === 'rojo')).length;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'ENS' }, { texto: 'BIA y Continuidad' }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">BIA y Continuidad<%- include('../partials/area-badge') %></h1>
        <p class="subtitulo-pagina">Análisis de impacto en el negocio: criticidad de los procesos, RTO/RPO y pruebas del plan de continuidad</p>
      </div>
      <% if (user.rol === 'ADMIN') { %>
        <a href="/bia/nuevo" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Nuevo proceso</a>
      <% } %>
    </div>

    <% if (conAlertaRoja) { %>
      <div class="mt-6 aviso alerta-error" role="alert"><%- icono('triangle-alert') %>
        <strong><%= conAlertaRoja %> proceso(s)</strong> de criticidad alta o crítica siguen pendientes de análisis.
      </div>
    <% } %>

    <%- include("../partials/filtro-alerta") %>

    <form action="/bia" method="GET" class="mt-6 flex flex-wrap items-end gap-3">
      <% if (filtro) { %><input type="hidden" name="filtro" value="<%= filtro %>"><% } %>
      <div>
        <label for="criticidad" class="label">Criticidad</label>
        <select id="criticidad" name="criticidad" onchange="this.form.submit()" class="<%= selectClase %>">
          <option value="">Todas</option>
          <% Object.entries(CRITICIDADES).forEach(([v, etiqueta]) => { %>
            <option value="<%= v %>" <%= criticidad === v ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="estado" class="label">Estado de revisión</label>
        <select id="estado" name="estado" onchange="this.form.submit()" class="<%= selectClase %>">
          <option value="">Todos</option>
          <% Object.entries(ESTADOS_REVISION_BIA).forEach(([v, etiqueta]) => { %>
            <option value="<%= v %>" <%= estado === v ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
      </div>
      <%- include('../partials/filtro-sistema', { sistemas, sistema }) %>
      <noscript><button type="submit" class="btn btn-secondary">Filtrar</button></noscript>
      <% if (criticidad || estado || filtro || sistema) { %><a href="/bia" class="py-2 text-sm text-indigo-600 hover:underline">Quitar filtros</a><% } %>
    </form>

    <div class="mt-4 tabla-contenedor">
      <% if (procesos.length === 0) { %>
        <p class="p-8 text-center text-slate-500"><%= criticidad || estado || filtro || sistema ? 'No hay procesos con esos filtros.' : 'No se ha registrado ningún proceso de negocio.' %></p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Proceso</th>
              <th>Departamento</th>
              <th>Criticidad</th>
              <th>RTO</th>
              <th>RPO</th>
              <th>Estado de revisión</th>
              <th>Alertas</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% procesos.forEach((p) => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3">
                  <a href="/bia/<%= p.id %>" class="font-medium text-slate-800 hover:text-indigo-600 hover:underline"><%= p.nombre %></a>
                  <% if (p.sistema) { %><span class="block text-xs text-slate-500">Sistema: <%= p.sistema.nombre %></span><% } %>
                </td>
                <td class="px-4 py-3 text-slate-600"><%= p.departamento_responsable %></td>
                <td class="px-4 py-3">
                  <span class="badge <%= criticidadClases[p.criticidad] %>"><%= CRITICIDADES[p.criticidad] %></span>
                </td>
                <td class="px-4 py-3 text-slate-700 whitespace-nowrap"><%= formatoHoras(p.rto_horas) %></td>
                <td class="px-4 py-3 text-slate-700 whitespace-nowrap"><%= formatoHoras(p.rpo_horas) %></td>
                <td class="px-4 py-3">
                  <span class="badge <%= estadoRevisionClases[p.estado_revision] %>"><%= ESTADOS_REVISION_BIA[p.estado_revision] %></span>
                  <% if (p.ultimaPrueba) { %><span class="mt-1 block text-xs text-slate-500">Última prueba: <%= fecha(p.ultimaPrueba) %></span><% } %>
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-1">
                    <% p.alertas.forEach((a) => { %>
                      <span class="badge <%= alertaBiaClases[a.nivel] %>" title="<%= a.detalle %>"><%= a.nivel === 'rojo' ? '⚠ ' : '' %><%= a.texto %></span>
                    <% }) %>
                  </div>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a href="/bia/<%= p.id %>" class="btn btn-secondary btn-sm"><%- icono('eye', 'h-3.5 w-3.5') %>Ver</a>
                  <% if (p.editable) { %>
                    <a href="/bia/<%= p.id %>/editar" class="ml-1 btn btn-primary btn-sm"><%- icono('pencil', 'h-3.5 w-3.5') %>Editar</a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
    <p class="mt-3 text-xs text-slate-500">
      RTO: tiempo máximo de interrupción admisible · RPO: pérdida máxima de datos admisible.
      Alertas (procesos de criticidad alta o crítica): rojo = pendiente de análisis · amarillo = sin prueba de continuidad en los últimos 12 meses.
    </p>
  </main>
</body>
</html>
