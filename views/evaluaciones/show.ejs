<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'Sistemas de información', href: '/sistemas' }, { texto: evaluacion.sistema.nombre, href: '/sistemas/' + evaluacion.sistema.id + '#ens' }, { texto: evaluacion.nombre }] }) %>
    <%- include('../partials/flash') %>


    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="titulo-pagina"><%= evaluacion.nombre %></h1>
        <p class="subtitulo-pagina">Checklist ENS del sistema <strong><%= evaluacion.sistema.nombre %></strong> · creada el <%= fechaHora(evaluacion.created_at) %></p>
      </div>
      <div class="flex flex-wrap items-end gap-2">
        <% if (otras.length > 1) { %>
          <div>
            <label for="ev" class="label text-xs">Cambiar de evaluación</label>
            <select id="ev" onchange="location.href = '/evaluaciones/' + this.value"
                    class="input w-auto">
              <% otras.forEach((o) => { %>
                <option value="<%= o.id %>" <%= o.id === evaluacion.id ? 'selected' : '' %>><%= o.nombre %></option>
              <% }) %>
            </select>
          </div>
        <% } %>
        <a href="/sistemas/<%= evaluacion.sistema.id %>/historial?evaluacion=<%= evaluacion.id %>"
           class="btn btn-secondary"><%- icono('history', 'h-4 w-4') %>Ver histórico</a>
        <% if (user.rol === 'ADMIN' && evaluacion.sistema.categoria_general) { %>
          <form action="/evaluaciones/<%= evaluacion.id %>/declaracion" method="POST"
                onsubmit="return confirm('Se generará una Declaración de Conformidad en Borrador con el estado actual de todos los controles. Las declaraciones anteriores de este sistema pasarán a «Superada por nueva versión». ¿Continuar?')">
            <button type="submit" class="btn btn-primary">Generar Declaración de Conformidad</button>
          </form>
        <% } %>
      </div>
    </div>
    <% if (user.rol === 'ADMIN' && !evaluacion.sistema.categoria_general) { %>
      <p class="mt-3 aviso alerta-aviso"><%- icono('circle-alert') %>
        Para generar la Declaración de Conformidad, primero
        <a href="/sistemas/<%= evaluacion.sistema.id %>/editar" class="font-medium underline">indica la categoría ENS del sistema</a>.
      </p>
    <% } %>

    <div class="mt-6">
      <%- include('../partials/resumen-ens', { resumen: grupos }) %>
    </div>

    <div class="mt-8 space-y-8">
      <% grupos.forEach((g) => { const clases = categoriaClases[g.categoria]; %>
        <section class="card overflow-hidden">
          <header class="flex flex-wrap items-center justify-between gap-3 border-b px-6 py-4 <%= clases.cabecera %>">
            <h2 class="flex items-center gap-2.5 text-base font-semibold"><span class="punto <%= categoriaClases[g.categoria].punto %>" aria-hidden="true"></span>Categoría <%= categorias[g.categoria] %></h2>
            <span class="text-sm"><strong><%= g.implementados %>/<%= g.aplicables %></strong> implementados<%= g.noAplica ? ' · ' + g.noAplica + ' no aplicables' : '' %></span>
          </header>

          <% if (g.controles.length === 0) { %>
            <p class="px-6 py-6 text-sm text-slate-500">No hay controles en esta categoría.</p>
          <% } else { %>
            <div class="overflow-x-auto">
              <table class="tabla">
                <thead>
                  <tr>
                    <th>Control</th>
                    <th>Estado</th>
                    <th>Último cambio de estado</th>
                    <th>Responsable</th>
                    <th>Evidencia</th>
                    <th class="text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% g.controles.forEach((c) => { const base = '/evaluaciones/' + evaluacion.id + '/controles/' + c.id; %>
                    <tr id="control-<%= c.id %>" class="scroll-mt-20 hover:bg-slate-50">
                      <td class="px-4 py-3 font-medium text-slate-800"><%= c.nombre %></td>
                      <td class="px-4 py-3">
                        <form action="<%= base %>/estado" method="POST" class="flex items-center gap-2">
                          <label for="estado-<%= c.id %>" class="sr-only">Estado de <%= c.nombre %></label>
                          <select id="estado-<%= c.id %>" name="estado" onchange="this.form.submit()"
                                  class="rounded-lg border px-2 py-1 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 <%= estadoClases[c.estado] %>">
                            <% Object.entries(estados).forEach(([valor, etiqueta]) => { %>
                              <option value="<%= valor %>" <%= c.estado === valor ? 'selected' : '' %>><%= etiqueta %></option>
                            <% }) %>
                          </select>
                          <noscript><button type="submit" class="text-xs text-indigo-600">Guardar</button></noscript>
                        </form>
                      </td>
                      <td class="px-4 py-3 text-slate-600 whitespace-nowrap">
                        <% if (c.fecha_revision) { %>
                          <span class="tabular-nums"><%= fechaHora(c.fecha_revision) %></span>
                          <% if (c.ultimoCambio) { %>
                            <span class="block text-xs text-slate-400">
                              antes: <%= estados[c.ultimoCambio.estado_anterior] %><%= c.ultimoCambio.usuario ? ' · ' + c.ultimoCambio.usuario.nombre : '' %>
                            </span>
                          <% } %>
                        <% } else { %>
                          <span class="text-slate-400 italic">Sin cambios</span>
                        <% } %>
                      </td>
                      <td class="px-4 py-3 text-slate-600 whitespace-nowrap">
                        <% if (c.responsable) { %>
                          <%= c.responsable.nombre %><%= c.responsable.id === user.id ? ' (tú)' : '' %>
                        <% } else { %>
                          <span class="text-slate-400 italic">Sin asignar</span>
                        <% } %>
                        <% if (!c.responsable || c.responsable.id !== user.id) { %>
                          <form action="<%= base %>/asignarme" method="POST" class="mt-1">
                            <button type="submit" class="text-xs text-indigo-600 hover:underline">Asignarme</button>
                          </form>
                        <% } %>
                      </td>
                      <td class="px-4 py-3 text-slate-600 max-w-xs">
                        <% if (c.evidencia) { %>
                          <p class="line-clamp-2" title="<%= c.evidencia %>"><%= c.evidencia %></p>
                        <% } else { %>
                          <span class="text-slate-400 italic">Sin evidencia</span>
                        <% } %>
                      </td>
                      <td class="px-4 py-3 text-right whitespace-nowrap">
                        <a href="/sistemas/<%= evaluacion.sistema.id %>/historial?control=<%= c.id %>"
                           class="btn btn-secondary btn-sm"><%- icono('history', 'h-3.5 w-3.5') %>Historial</a>
                        <a href="<%= base %>/editar" class="ml-1 btn btn-secondary btn-sm"><%- icono('pencil', 'h-3.5 w-3.5') %>Editar</a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
      <% }) %>
    </div>
  </main>
</body>
</html>
