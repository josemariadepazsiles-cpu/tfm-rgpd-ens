<%
  const inputClase = 'input';
  const volver = '/evaluaciones/' + evaluacion.id + '#control-' + control.id;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'Sistemas de información', href: '/sistemas' }, { texto: evaluacion.sistema.nombre, href: '/sistemas/' + evaluacion.sistema.id + '#ens' }, { texto: evaluacion.nombre, href: '/evaluaciones/' + evaluacion.id }, { texto: control.nombre }] }) %>

    <div class="mt-2 flex flex-wrap items-center gap-3">
      <h1 class="titulo-pagina"><%= control.nombre %><%- include('../partials/area-badge') %></h1>
      <span class="badge <%= categoriaClases[control.categoria].badge %>">
        Categoría <%= categorias[control.categoria] %>
      </span>
    </div>

    <% if (errores.length) { %>
      <ul class="mt-6 rounded-xl border border-red-200 bg-red-50/60 px-4 py-3 text-sm text-red-800 list-disc list-inside space-y-0.5" role="alert">
        <% errores.forEach((e) => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <form action="/evaluaciones/<%= evaluacion.id %>/controles/<%= control.id %>" method="POST" class="mt-6 card p-6 space-y-4">
      <div>
        <label for="estado" class="label">Estado</label>
        <select id="estado" name="estado" required class="<%= inputClase %>">
          <% Object.entries(estados).forEach(([valor, etiqueta]) => { %>
            <option value="<%= valor %>" <%= valores.estado === valor ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
        <p class="ayuda">
          <% if (valores.fecha_revision) { %>Último cambio de estado: <%= fechaHora(valores.fecha_revision) %>. <% } %>
          Si cambias el estado se registrará con la fecha y hora actuales en el histórico.
        </p>
      </div>

      <div>
        <label for="evidencia" class="label">Evidencia</label>
        <textarea id="evidencia" name="evidencia" rows="4" class="<%= inputClase %>"
                  placeholder="Ej.: Política aprobada el 15/09/2026, documento POL-SEG-03"><%= valores.evidencia || '' %></textarea>
      </div>

      <div>
        <% if (user.rol === 'ADMIN') { %>
          <label for="responsable_id" class="label">Responsable</label>
          <select id="responsable_id" name="responsable_id" class="<%= inputClase %>">
            <option value="">Sin asignar</option>
            <% usuarios.forEach((u) => { %>
              <option value="<%= u.id %>" <%= valores.responsable_id === u.id ? 'selected' : '' %>>
                <%= u.nombre %><%= u.cargo ? ' — ' + u.cargo : '' %>
              </option>
            <% }) %>
          </select>
        <% } else { %>
          <span class="label">Responsable</span>
          <p class="mt-1 text-slate-600"><%= valores.responsable ? valores.responsable.nombre : 'Sin asignar' %></p>
          <label class="mt-2 inline-flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" name="asignarme" class="check"
                   <%= valores.responsable_id === user.id ? 'checked' : '' %>>
            Soy el responsable de este control
          </label>
        <% } %>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <a href="<%= volver %>" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
      </div>
    </form>
  </main>
</body>
</html>
