<%# Resumen por categoría de una evaluación. Recibe `resumen` y opcionalmente `compacto` %>
<% const esCompacto = typeof compacto !== 'undefined' && compacto; %>
<div class="grid gap-3 <%= esCompacto ? 'grid-cols-3' : 'sm:grid-cols-3' %>">
  <% resumen.forEach((r) => { const clases = categoriaClases[r.categoria]; %>
    <div class="rounded-xl border border-slate-200/80 bg-white <%= esCompacto ? 'p-3' : 'p-4' %>">
      <p class="flex items-center gap-2 text-xs font-medium text-slate-500">
        <span class="punto <%= clases.punto %>" aria-hidden="true"></span><%= categorias[r.categoria] %>
      </p>
      <p class="mt-1.5 <%= esCompacto ? 'text-lg' : 'text-2xl' %> font-semibold tracking-tight text-slate-900">
        <%= r.implementados %><span class="text-sm font-normal text-slate-400">/<%= r.aplicables %></span>
      </p>
      <div class="progreso mt-2" role="progressbar" aria-valuenow="<%= r.porcentaje %>" aria-valuemin="0" aria-valuemax="100"
           aria-label="Cumplimiento categoría <%= categorias[r.categoria] %>">
        <span class="<%= clases.barra %>" style="width: <%= r.porcentaje %>%"></span>
      </div>
      <p class="mt-1.5 text-xs text-slate-500"><%= r.porcentaje %> %<%= r.noAplica ? ' · ' + r.noAplica + ' no aplic.' : '' %></p>
    </div>
  <% }) %>
</div>
