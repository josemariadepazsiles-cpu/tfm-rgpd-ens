<%# Etiqueta del área («RGPD» / «ENS») junto al título de la página. En las pantallas neutras no se muestra. %>
<% if (areasNormativas[areaNormativa]) { %><span class="badge-area" data-area="<%= areaNormativa %>" title="<%= areasNormativas[areaNormativa].nombre %>"><%- icono(areasNormativas[areaNormativa].icono, 'h-3.5 w-3.5') %><%= areasNormativas[areaNormativa].etiqueta %></span><% } %>
