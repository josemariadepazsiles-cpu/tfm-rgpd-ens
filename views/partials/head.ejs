<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f6f8fc">
<title><%= typeof title !== 'undefined' ? title + ' · ' + producto.nombre : producto.nombre %></title>
<link rel="icon" type="image/svg+xml" href="/img/logo.svg">
<link rel="preload" href="/fuentes/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/output.css?v=<%= versionCss %>">
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
<script>
  // Pestañas (ver partials/pestanas.ejs): la activa se toma de la URL (#id) y se actualiza al cambiar
  document.addEventListener('alpine:init', function () {
    Alpine.data('pestanas', function (inicial, ids) {
      return {
        tab: ids.indexOf(location.hash.slice(1)) >= 0 ? location.hash.slice(1) : inicial,
        ir: function (id) {
          this.tab = id;
          history.replaceState(null, '', '#' + id);
        },
        mover: function (paso) {
          var i = (ids.indexOf(this.tab) + paso + ids.length) % ids.length;
          this.ir(ids[i]);
          var boton = document.getElementById('tab-' + ids[i]);
          if (boton) boton.focus();
        },
      };
    });
  });

  // Secciones plegables (ver partials/plegable-abrir.ejs). Plegadas por defecto; las que el usuario
  // despliega se recuerdan en localStorage (con try/catch: puede no estar disponible).
  var CLAVE_PLEGABLES = 'compliance-ai:plegables-abiertos';
  function leerPlegables() {
    try { return JSON.parse(localStorage.getItem(CLAVE_PLEGABLES)) || {}; } catch (e) { return {}; }
  }
  function guardarPlegable(id, abierto) {
    try {
      var estado = leerPlegables();
      if (abierto) estado[id] = true; else delete estado[id];
      localStorage.setItem(CLAVE_PLEGABLES, JSON.stringify(estado));
    } catch (e) { /* sin almacenamiento: el estado solo dura hasta recargar */ }
  }
  document.addEventListener('alpine:init', function () {
    Alpine.data('plegable', function (id) {
      return {
        abierto: !!leerPlegables()[id] || location.hash === '#' + id,
        listo: false,
        init: function () {
          var self = this;
          // La animación se activa tras el primer pintado: al cargar no hay saltos ni animación
          requestAnimationFrame(function () { requestAnimationFrame(function () { self.listo = true; }); });
          if (location.hash === '#' + id) this.$nextTick(function () { self.$root.scrollIntoView({ block: 'start' }); });
        },
        alternar: function () {
          if (this.abierto) this.cerrar(); else this.abrir(false);
        },
        abrir: function (desplazar) {
          var raiz = this.$root;
          this.abierto = true;
          guardarPlegable(id, true);
          // Gráficos que se dibujen con tamaño 0 estando ocultos: se recalculan al terminar de abrir
          setTimeout(function () { window.dispatchEvent(new Event('resize')); }, 240);
          if (desplazar) this.$nextTick(function () { raiz.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
        },
        cerrar: function () {
          this.abierto = false;
          guardarPlegable(id, false);
        },
      };
    });
  });
  // Un enlace «#id» a una sección plegable la despliega y se desplaza hasta ella
  document.addEventListener('click', function (e) {
    var enlace = e.target.closest && e.target.closest('a[href^="#"]');
    if (!enlace) return;
    var id = enlace.getAttribute('href').slice(1);
    var destino = id && document.getElementById(id);
    if (!destino || !destino.classList.contains('plegable')) return;
    e.preventDefault();
    history.replaceState(null, '', '#' + id);
    window.dispatchEvent(new CustomEvent('abrir-plegable', { detail: id }));
  });

  // Tablas en móvil: copia el título de cada columna a sus celdas (data-label) para mostrar
  // cada fila como una ficha sin scroll horizontal (ver .tabla en input.css)
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('table.tabla').forEach(function (tabla) {
      var titulos = Array.prototype.map.call(tabla.querySelectorAll('thead th'), function (th) { return th.textContent.trim(); });
      tabla.querySelectorAll('tbody tr').forEach(function (tr) {
        Array.prototype.forEach.call(tr.children, function (td, i) {
          if (!td.hasAttribute('data-label')) td.setAttribute('data-label', titulos[i] || '');
        });
      });
    });
  });
</script>
