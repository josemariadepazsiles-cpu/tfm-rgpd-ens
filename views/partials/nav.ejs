<%
  const esAdmin = user.rol === 'ADMIN';
  const activo = (href) => currentPath === href || currentPath.startsWith(href + '/');

  // Menús desplegables. `rutas` marca el desplegable como activo aunque la página no sea
  // uno de sus enlaces (p. ej. /evaluaciones/3 pertenece a ENS)
  const menus = [
    {
      id: 'rgpd',
      texto: 'RGPD',
      icono: 'scale',
      rutas: ['/rat', '/riesgos', '/incidentes', '/derechos', '/proveedores'],
      enlaces: [
        { href: '/rat', texto: 'Actividades RAT', detalle: 'Registro de actividades de tratamiento', icono: 'clipboard-list' },
        { href: '/riesgos', texto: 'Riesgos', detalle: 'Evaluación de riesgos por actividad', icono: 'gauge' },
        { href: '/incidentes', texto: 'Incidentes / Brechas', detalle: 'Arts. 33 y 34 · notificación AEPD', icono: 'siren' },
        { href: '/derechos', texto: 'Derechos de los Interesados', detalle: 'Solicitudes ARCO-POL y plazos', icono: 'users' },
        { href: '/proveedores', texto: 'Proveedores', detalle: 'Encargados del tratamiento · art. 28', icono: 'building-2' },
      ],
    },
    {
      id: 'ens',
      texto: 'ENS',
      icono: 'shield-check',
      rutas: ['/evaluaciones', '/controles', '/declaraciones', '/politicas', '/bia'],
      enlaces: [
        { href: '/declaraciones', texto: 'Declaraciones de Conformidad', detalle: 'Informes formales de adecuación', icono: 'file-badge' },
        { href: '/politicas', texto: 'Políticas y Documentación', detalle: 'PSI, procedimientos y aceptaciones', icono: 'book-open-check' },
        { href: '/bia', texto: 'BIA y Continuidad', detalle: 'Impacto en el negocio, RTO y RPO', icono: 'life-buoy' },
        ...(esAdmin ? [{ href: '/controles', texto: 'Catálogo de controles', detalle: 'Controles evaluados en cada sistema', icono: 'list-todo' }] : []),
      ],
    },
  ];
  const menuActivo = (m) => m.rutas.some(activo);
  const usuarioActivo = activo('/registro');

  // Área de la pantalla actual (lib/areas.js): colorea el filete de la cabecera y la sección activa
  const areaActual = typeof areaNormativa !== 'undefined' ? areaNormativa : 'neutro';

  // Inicio y Sistemas son neutros; RGPD y ENS usan su color de área (clases *-area en input.css)
  const claseBoton = (marcado) =>
    'inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition duration-150 ' +
    (marcado ? 'bg-slate-100 text-slate-900' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900');
  const claseBotonArea = (marcado) =>
    'inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition duration-150 ' +
    (marcado ? 'nav-area-activo' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900');
  const claseItem = (marcado) =>
    'flex items-start gap-3 rounded-lg px-3 py-2.5 text-sm transition duration-150 ' +
    (marcado ? 'nav-area-item-activo' : 'text-slate-700 hover:bg-slate-50 focus:bg-slate-50 focus:outline-none');
  const claseMovil = (marcado) =>
    'flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm ' + (marcado ? 'bg-slate-100 font-medium text-slate-900' : 'text-slate-700 hover:bg-slate-50');
  const claseMovilArea = (marcado) =>
    'flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm ' + (marcado ? 'nav-area-item-activo font-medium' : 'text-slate-700 hover:bg-slate-50');
%>
<header data-area="<%= areaActual %>" class="cabecera-area sticky top-0 z-30 border-b border-slate-200/80 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/80">
<nav class="contenedor" aria-label="Navegación principal"
     x-data="{
       abierto: false,
       menu: null,
       alternar(id) { this.menu = this.menu === id ? null : id },
       cerrar(devolverFoco) {
         if (!this.menu) return;
         const boton = this.$refs['btn-' + this.menu];
         this.menu = null;
         if (devolverFoco && boton) boton.focus();
       },
     }"
     @keydown.escape.window="cerrar(true)">
  <div class="flex h-16 items-center justify-between gap-4">
    <div class="flex items-center gap-8">
      <a href="/dashboard" class="flex items-center gap-2.5 rounded-lg" aria-label="<%= producto.nombre %> · Inicio">
        <%- include('logo', { tamano: 'h-8 w-8' }) %>
        <span class="leading-tight">
          <span class="block text-[15px] font-semibold tracking-tight text-slate-900"><%= producto.nombre %></span>
          <span class="block text-[11px] font-medium tracking-wide text-slate-500">RGPD · ENS</span>
        </span>
      </a>

      <%# Escritorio: Inicio + desplegables %>
      <div class="hidden md:flex items-center gap-1">
        <a href="/dashboard" class="<%= claseBoton(activo('/dashboard')) %>" <%- activo('/dashboard') ? 'aria-current="page"' : '' %>>
          <%- icono('layout-dashboard', 'h-4 w-4') %>Inicio
        </a>
        <%# Los sistemas de información son el eje de RGPD y ENS %>
        <a href="/sistemas" class="<%= claseBoton(activo('/sistemas')) %>" <%- activo('/sistemas') ? 'aria-current="page"' : '' %>>
          <%- icono('server', 'h-4 w-4') %>Sistemas
        </a>

        <% menus.forEach((m) => { %>
          <div class="relative" data-area="<%= m.id %>" @click.outside="menu === '<%= m.id %>' && cerrar(false)">
            <button type="button" x-ref="btn-<%= m.id %>" @click="alternar('<%= m.id %>')"
                    class="<%= claseBotonArea(menuActivo(m)) %>"
                    aria-haspopup="true" :aria-expanded="menu === '<%= m.id %>'" aria-controls="menu-<%= m.id %>">
              <span class="nav-area-icono"><%- icono(m.icono, 'h-4 w-4') %></span><%= m.texto %>
              <span class="transition-transform duration-150" :class="menu === '<%= m.id %>' && 'rotate-180'"><%- icono('chevron-down', 'h-3.5 w-3.5 opacity-60') %></span>
            </button>
            <div id="menu-<%= m.id %>" x-show="menu === '<%= m.id %>'" x-cloak
                 x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-100" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
                 class="absolute left-0 z-20 mt-2 w-80 rounded-xl border border-slate-200 bg-white p-1.5 shadow-lg shadow-slate-900/5">
              <p class="miga-area sin-fondo px-3 pb-1 pt-1.5 text-[11px] tracking-[0.08em]"><%= m.texto %></p>
              <% m.enlaces.forEach((e) => { %>
                <a href="<%= e.href %>" class="<%= claseItem(activo(e.href)) %>" <%- activo(e.href) ? 'aria-current="page"' : '' %>>
                  <span class="mt-0.5 flex h-7 w-7 items-center justify-center rounded-md <%= activo(e.href) ? 'nav-area-icono bg-white' : 'bg-slate-100 text-slate-500' %>"><%- icono(e.icono, 'h-4 w-4') %></span>
                  <span>
                    <span class="block font-medium"><%= e.texto %></span>
                    <span class="block text-xs text-slate-500"><%= e.detalle %></span>
                  </span>
                </a>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <%# Escritorio: desplegable de usuario %>
    <div class="relative hidden md:block" @click.outside="menu === 'usuario' && cerrar(false)">
      <button type="button" x-ref="btn-usuario" @click="alternar('usuario')"
              class="flex items-center gap-2.5 rounded-lg py-1.5 pl-1.5 pr-2.5 text-sm transition duration-150 <%= usuarioActivo ? 'bg-slate-100' : 'hover:bg-slate-100' %> max-w-64"
              aria-haspopup="true" :aria-expanded="menu === 'usuario'" aria-controls="menu-usuario">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-blue-800 text-xs font-semibold text-white" aria-hidden="true"><%= iniciales(user.nombre) %></span>
        <span class="min-w-0 text-left leading-tight">
          <span class="block truncate font-medium text-slate-800"><%= user.nombre %></span>
          <span class="block text-xs text-slate-500"><%= roles[user.rol] %></span>
        </span>
        <span class="transition-transform duration-150" :class="menu === 'usuario' && 'rotate-180'"><%- icono('chevron-down', 'h-3.5 w-3.5 text-slate-400') %></span>
      </button>
      <div id="menu-usuario" x-show="menu === 'usuario'" x-cloak
           x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0"
           x-transition:leave="transition ease-in duration-100" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
           class="absolute right-0 z-20 mt-2 w-72 rounded-xl border border-slate-200 bg-white p-1.5 shadow-lg shadow-slate-900/5">
        <div class="px-3 py-2.5">
          <p class="truncate text-sm font-medium text-slate-900"><%= user.nombre %></p>
          <p class="truncate text-xs text-slate-500"><%= user.email %></p>
          <span class="badge mt-2 bg-marca-50 text-indigo-700 ring-indigo-600/15"><%- icono(esAdmin ? 'shield-check' : 'user-round', 'h-3 w-3') %><%= roles[user.rol] %></span>
        </div>
        <div class="my-1 border-t border-slate-100"></div>
        <% if (esAdmin) { %>
          <a href="/registro" class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm <%= activo('/registro') ? 'bg-slate-100 text-slate-900' : 'text-slate-700 hover:bg-slate-50' %>" <%- activo('/registro') ? 'aria-current="page"' : '' %>>
            <%- icono('user-plus', 'h-4 w-4 text-slate-500') %>Registrar usuario
          </a>
        <% } %>
        <form action="/logout" method="POST">
          <button type="submit" class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm text-slate-700 hover:bg-slate-50">
            <%- icono('log-out', 'h-4 w-4 text-slate-500') %>Cerrar sesión
          </button>
        </form>
      </div>
    </div>

    <%# Móvil: botón hamburguesa %>
    <button type="button" class="md:hidden rounded-lg p-2 text-slate-600 hover:bg-slate-100" @click="abierto = !abierto"
            :aria-expanded="abierto" aria-controls="menu-movil" aria-label="Menú">
      <span x-show="!abierto"><%- icono('menu', 'h-6 w-6') %></span>
      <span x-show="abierto" x-cloak><%- icono('x', 'h-6 w-6') %></span>
    </button>
  </div>

  <%# Móvil: los desplegables se muestran como secciones %>
  <div id="menu-movil" class="md:hidden space-y-4 border-t border-slate-100 py-4" x-show="abierto" x-cloak>
    <a href="/dashboard" class="<%= claseMovil(activo('/dashboard')) %>" <%- activo('/dashboard') ? 'aria-current="page"' : '' %>><%- icono('layout-dashboard', 'h-4 w-4') %>Inicio</a>
    <a href="/sistemas" class="<%= claseMovil(activo('/sistemas')) %>" <%- activo('/sistemas') ? 'aria-current="page"' : '' %>><%- icono('server', 'h-4 w-4') %>Sistemas de información</a>

    <% menus.forEach((m) => { %>
      <div data-area="<%= m.id %>">
        <p class="miga-area sin-fondo px-3 text-xs uppercase tracking-wider"><%= m.texto %></p>
        <div class="mt-1 space-y-0.5">
          <% m.enlaces.forEach((e) => { %>
            <a href="<%= e.href %>" class="<%= claseMovilArea(activo(e.href)) %>" <%- activo(e.href) ? 'aria-current="page"' : '' %>><span class="<%= activo(e.href) ? 'nav-area-icono' : 'text-slate-500' %>"><%- icono(e.icono, 'h-4 w-4') %></span><%= e.texto %></a>
          <% }) %>
        </div>
      </div>
    <% }) %>

    <div class="border-t border-slate-100 pt-4">
      <div class="flex items-center gap-3 px-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-blue-800 text-xs font-semibold text-white" aria-hidden="true"><%= iniciales(user.nombre) %></span>
        <span class="leading-tight">
          <span class="block text-sm font-medium text-slate-900"><%= user.nombre %></span>
          <span class="block text-xs text-slate-500"><%= roles[user.rol] %> · <%= user.email %></span>
        </span>
      </div>
      <div class="mt-2 space-y-0.5">
        <% if (esAdmin) { %>
          <a href="/registro" class="<%= claseMovil(activo('/registro')) %>" <%- activo('/registro') ? 'aria-current="page"' : '' %>><%- icono('user-plus', 'h-4 w-4 text-slate-500') %>Registrar usuario</a>
        <% } %>
        <form action="/logout" method="POST">
          <button type="submit" class="<%= claseMovil(false) %> w-full text-left"><%- icono('log-out', 'h-4 w-4 text-slate-500') %>Cerrar sesión</button>
        </form>
      </div>
    </div>
  </div>
</nav>
<%# Banda del área (RGPD / ENS): recuerda en qué ámbito normativo se está trabajando %>
<% if (areasNormativas[areaActual]) { const a = areasNormativas[areaActual]; %>
  <div class="banda-area">
    <div class="contenedor flex h-9 items-center gap-2 text-[13px]">
      <%- icono(a.icono, 'h-4 w-4 shrink-0') %>
      <span class="font-semibold tracking-wide"><%= a.etiqueta %></span>
      <span class="hidden opacity-40 sm:inline" aria-hidden="true">·</span>
      <span class="hidden truncate font-medium opacity-90 sm:inline"><%= a.nombre %></span>
    </div>
  </div>
<% } %>
</header>
