<%
  const enlaces = [
    { href: '/dashboard', texto: 'Inicio' },
    { href: '/rat', texto: 'Actividades RAT' },
    { href: '/riesgos', texto: 'Riesgos' },
    { href: '/sistemas', texto: 'Sistemas ENS' },
  ];
  if (user.rol === 'ADMIN') enlaces.push({ href: '/registro', texto: 'Registrar usuario' });
  const activo = (href) => currentPath === href || currentPath.startsWith(href + '/');
%>
<nav class="bg-white border-b border-slate-200" x-data="{ abierto: false }">
  <div class="max-w-6xl mx-auto px-4 flex items-center justify-between h-14">
    <a href="/dashboard" class="font-bold text-indigo-600">RGPD · ENS</a>

    <button type="button" class="sm:hidden p-2 text-slate-600" @click="abierto = !abierto" aria-label="Menú">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <div class="hidden sm:flex items-center gap-1">
      <% enlaces.forEach((e) => { %>
        <a href="<%= e.href %>"
           class="px-3 py-2 rounded-lg text-sm <%= activo(e.href) ? 'bg-indigo-50 text-indigo-700 font-medium' : 'text-slate-600 hover:bg-slate-100' %>">
          <%= e.texto %>
        </a>
      <% }) %>
      <span class="ml-4 text-sm text-slate-500"><%= user.nombre %> (<%= roles[user.rol] %>)</span>
      <form action="/logout" method="POST" class="ml-2">
        <button type="submit" class="px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-100">Cerrar sesión</button>
      </form>
    </div>
  </div>

  <div class="sm:hidden border-t border-slate-200 px-4 py-2 space-y-1" x-show="abierto" x-cloak>
    <% enlaces.forEach((e) => { %>
      <a href="<%= e.href %>" class="block px-3 py-2 rounded-lg text-sm <%= activo(e.href) ? 'bg-indigo-50 text-indigo-700 font-medium' : 'text-slate-600' %>"><%= e.texto %></a>
    <% }) %>
    <form action="/logout" method="POST">
      <button type="submit" class="w-full text-left px-3 py-2 rounded-lg text-sm text-slate-600">Cerrar sesión</button>
    </form>
  </div>
</nav>
