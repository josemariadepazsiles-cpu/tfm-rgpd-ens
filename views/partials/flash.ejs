<% if (flash) { const esExito = flash.tipo === 'exito'; %>
  <div class="alerta <%= esExito ? 'alerta-exito' : 'alerta-error' %> mb-6 items-center" role="<%= esExito ? 'status' : 'alert' %>"
       x-data="{ visible: true }" x-show="visible" x-transition.opacity.duration.200ms>
    <%- icono(esExito ? 'circle-check' : 'circle-alert', 'h-5 w-5') %>
    <span class="flex-1"><%= flash.mensaje %></span>
    <button type="button" @click="visible = false" class="rounded-md p-1 opacity-60 transition hover:bg-black/5 hover:opacity-100" aria-label="Cerrar aviso">
      <%- icono('x', 'h-4 w-4') %>
    </button>
  </div>
<% } %>
