<% if (flash) { %>
  <div class="mb-6 rounded-lg border px-4 py-3 text-sm <%= flash.tipo === 'exito' ? 'bg-green-50 border-green-200 text-green-700' : 'bg-red-50 border-red-200 text-red-700' %>"
       role="status" x-data="{ visible: true }" x-show="visible">
    <div class="flex items-start justify-between gap-4">
      <span><%= flash.mensaje %></span>
      <button type="button" @click="visible = false" aria-label="Cerrar">&times;</button>
    </div>
  </div>
<% } %>
