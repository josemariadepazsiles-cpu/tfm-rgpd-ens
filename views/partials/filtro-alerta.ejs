<%# Aviso de filtro rápido activo (desde el panel de control). Recibe `filtroAlerta` = { texto, quitar } o null %>
<% if (typeof filtroAlerta !== 'undefined' && filtroAlerta) { %>
  <div class="alerta alerta-info mt-6 items-center justify-between" role="status">
    <span class="flex items-center gap-2"><%- icono('list-filter', 'h-4 w-4') %>Filtrando por: <strong class="font-semibold"><%= filtroAlerta.texto %></strong></span>
    <a href="<%= filtroAlerta.quitar %>" class="inline-flex items-center gap-1 font-medium hover:underline"><%- icono('x', 'h-3.5 w-3.5') %>Quitar filtro</a>
  </div>
<% } %>
