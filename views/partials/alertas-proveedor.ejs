<%# Alertas de un proveedor. Recibe `lista` (resultado de alertas()) %>
<% const iconoAlerta = { rojo: 'file-x', amarillo: 'calendar-clock', naranja: 'globe', naranjaFuerte: 'globe' }; %>
<% lista.forEach((a) => { %>
  <span class="badge <%= alertaClases[a.nivel] %>" title="<%= a.detalle %>"><%- icono(iconoAlerta[a.nivel], 'h-3 w-3') %><%= a.texto %></span>
<% }) %>
