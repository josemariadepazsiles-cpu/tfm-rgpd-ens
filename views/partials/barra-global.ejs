<%# % de implementación global. Recibe `global` (resultado de resumenGlobal) %>
<div class="flex items-center gap-2.5">
  <div class="progreso w-24" role="progressbar" aria-valuenow="<%= global.porcentaje %>" aria-valuemin="0" aria-valuemax="100" aria-label="Implementación global">
    <span class="<%= global.porcentaje >= 80 ? 'bg-emerald-500' : global.porcentaje >= 50 ? 'bg-amber-500' : 'bg-red-500' %>" style="width: <%= global.porcentaje %>%"></span>
  </div>
  <span class="text-sm font-semibold text-slate-800"><%= global.porcentaje %>%</span>
  <span class="text-xs text-slate-400"><%= global.implementados %>/<%= global.aplicables %></span>
</div>
