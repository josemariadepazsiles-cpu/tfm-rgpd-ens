<%# Situación de la notificación a la AEPD. Recibe `plazo` (resultado de plazoAepd) %>
<% if (plazo.tipo === 'vencido') { %>
  <span class="badge bg-red-50 font-semibold text-red-700 ring-red-600/40"
        title="Han pasado más de 72 h desde la detección sin notificar a la AEPD (vencía el <%= fechaHora(plazo.limite) %>)">
    <%- icono('triangle-alert', 'h-3 w-3') %>¡Plazo AEPD!
  </span>
<% } else if (plazo.tipo === 'pendiente') { %>
  <span class="badge bg-amber-50 text-amber-800 ring-amber-600/25" title="Vence el <%= fechaHora(plazo.limite) %>">
    <%- icono('clock', 'h-3 w-3') %>Pendiente · quedan <%= plazo.horasRestantes %> h
  </span>
<% } else if (plazo.tipo === 'notificado') { %>
  <span class="badge bg-green-50 text-green-700 ring-green-600/20"><%- icono('check', 'h-3 w-3') %>Notificada <%= fecha(plazo.fecha) %></span>
<% } else { %>
  <span class="text-xs text-slate-400">No requiere</span>
<% } %>
