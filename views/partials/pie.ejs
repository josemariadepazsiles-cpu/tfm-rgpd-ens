<%#
  Pie de página con los enlaces legales, en todas las pantallas (también en el login).
  Parámetro opcional: compacto (true en el panel del login, sin franja ni márgenes propios).
%>
<% const piePequeno = typeof compacto !== 'undefined' && compacto; %>
<footer class="<%= piePequeno ? 'mt-6' : 'mt-12 border-t border-slate-200/80 bg-white/60' %>">
  <div class="<%= piePequeno ? '' : 'contenedor py-5' %> flex flex-col items-center gap-2 text-xs text-slate-500 <%= piePequeno ? '' : 'sm:flex-row sm:justify-between' %>">
    <p class="text-center">
      <span class="font-medium text-amber-700"><%= legal.PROYECTO.aviso %></span>
      · Web de prueba para un <%= legal.PROYECTO.tipo %>
    </p>
    <nav aria-label="Información legal" class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
      <a href="/aviso-legal" class="hover:text-indigo-600 hover:underline">Aviso legal</a>
      <a href="/privacidad" class="hover:text-indigo-600 hover:underline">Privacidad</a>
      <a href="/cookies" class="hover:text-indigo-600 hover:underline">Cookies</a>
    </nav>
  </div>
</footer>
