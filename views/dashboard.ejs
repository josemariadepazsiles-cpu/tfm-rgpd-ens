<%
  // Panel de control. Estructura: cabecera con selector · aviso de plazos (solo si los hay) ·
  // 4 KPIs · acciones pendientes · zonas RGPD, ENS, Continuidad y Riesgos (cada una con su color
  // de área) · actividad reciente. Cada dato aparece una sola vez.
  const { actividades: act, incidentes: inc, derechos: der, proveedores: prov, ens, declaraciones: decl, politicas: pol, bia, actividad } = m;
  const esTodos = !sistema;
  const v = vista;
  const tr = panel.transversal;
  const plural = (n, uno, varios) => n + ' ' + (n === 1 ? uno : varios);
  const etiquetaArea = { rgpd: 'RGPD', ens: 'ENS' };

  const colorPct = (pct) => (pct >= 80 ? 'bg-emerald-500' : pct >= 50 ? 'bg-amber-500' : 'bg-red-500');
  const estadoPct = (pct) => (pct >= 80 ? { texto: 'Correcto', color: 'text-emerald-700', icono: 'circle-check' }
    : pct >= 50 ? { texto: 'Requiere atención', color: 'text-amber-700', icono: 'circle-alert' }
    : { texto: 'Crítico', color: 'text-red-700', icono: 'circle-dot' });

  // ---- Aviso de plazos (solo si hay algo vencido o próximo) ----
  const vencidas = v.alertas.filter((a) => a.nivel === 'critico').length;
  const proximas = v.alertas.length - vencidas;

  // ---- KPIs ----
  const pctEns = v.ens.porcentaje;
  const evaluados = panel.comparativa.filter((s) => s.ens.porcentaje !== null);
  const peor = evaluados[0] || null;
  const bajos = evaluados.filter((s) => s.ens.porcentaje < 50).length;
  const urgentes = acciones.filter((a) => a.nivel !== 'info');
  const criticas = acciones.filter((a) => a.nivel === 'critico').length;
  const incAbiertos = v.rgpd.incidentesActivos || 0;

  // ---- Zona ENS: cumplimiento por sistema (de menor a mayor; primero los sin evaluar) ----
  const sistemasEns = [...ens.sistemas].sort((a, b) => (a.global ? a.global.porcentaje : -1) - (b.global ? b.global.porcentaje : -1));
  const ensEvaluados = sistemasEns.filter((s) => s.global);
  const ensBajos = ensEvaluados.filter((s) => s.global.porcentaje < 50).length;
  const conclusionEns = !sistemasEns.length ? 'Todavía no hay sistemas registrados'
    : !ensEvaluados.length ? 'Ningún sistema evaluado todavía'
    : ensBajos ? `${ensBajos} de ${ensEvaluados.length} ${ensEvaluados.length === 1 ? 'sistema' : 'sistemas'} por debajo del 50 %`
    : ensEvaluados.length === 1 ? 'El sistema supera el 50 %' : `Los ${ensEvaluados.length} sistemas evaluados superan el 50 %`;
  const nombres = (lista) => lista.map((s) => s.nombre).join(', ');

  const filasDecl = [
    { titulo: 'Sin declaración vigente', valor: decl.sinDeclaracion.length, detalle: nombres(decl.sinDeclaracion), href: enlace('/declaraciones'), nivel: 'atencion' },
    { titulo: 'Emitida hace más de 12 meses', valor: decl.caducadas.length, detalle: nombres(decl.caducadas), href: enlace('/declaraciones'), nivel: 'atencion' },
  ];
  const filasPol = [
    { titulo: 'Revisión vencida', valor: pol.revisionVencidas, detalle: 'Documentos a revisar ya', href: '/politicas?filtro=revision', nivel: 'critico' },
    { titulo: 'Revisión en los próximos 30 días', valor: pol.revisionProximas, detalle: 'Planifica su revisión', href: '/politicas?filtro=revision', nivel: 'atencion' },
    { titulo: 'Pendientes de tu aceptación', valor: pol.misPendientes.length, detalle: 'Léelas y acéptalas', href: '/politicas?filtro=pendientes', nivel: 'atencion' },
  ];

  // ---- Zona RGPD ----
  const tarjetasRgpd = [
    { titulo: 'Actividades de tratamiento', icono: 'clipboard-list', href: enlace('/rat'), filas: [
      { titulo: user.rol === 'ADMIN' ? 'Registradas en el RAT' : 'De las que eres responsable', valor: act.actividades, detalle: esTodos ? 'Registro de actividades (art. 30)' : 'En este sistema', href: enlace('/rat'), nivel: 'neutro' },
      ...(esTodos ? [{ titulo: 'Sin sistema asignado (transversales)', valor: tr.rgpd.actividades, detalle: 'Afectan a toda la organización', href: '/rat?sistema=ninguno', nivel: 'neutro' }] : []),
    ] },
    { titulo: 'Derechos de los interesados', icono: 'users', href: enlace('/derechos'), filas: [
      { titulo: 'Solicitudes abiertas', valor: der.abiertas, detalle: 'Sin resolver', href: enlace('/derechos?plazo=abiertas'), nivel: 'atencion' },
      { titulo: 'Fuera de plazo', valor: der.vencidas, detalle: 'Vencidas sin resolver (art. 12.3)', href: enlace('/derechos?plazo=vencidas'), nivel: 'critico' },
    ] },
    { titulo: 'Proveedores', icono: 'building-2', href: '/proveedores', nota: esTodos ? null : 'No se asocian a sistemas: datos de toda la organización.', filas: [
      { titulo: 'Proveedores activos', valor: prov.activos, detalle: 'Relación vigente', href: '/proveedores?estado=ACTIVO', nivel: 'neutro' },
      { titulo: 'Sin contrato de encargado', valor: prov.sinContrato, detalle: 'Art. 28.3 · sin contar bajas', href: '/proveedores?alerta=sin_contrato', nivel: 'critico' },
      { titulo: 'Transferencia sin garantías', valor: prov.sinGarantias, detalle: 'Fuera del EEE sin mecanismo', href: '/proveedores?alerta=sin_garantias', nivel: 'critico' },
    ] },
    { titulo: 'Incidentes / Brechas', icono: 'siren', href: enlace('/incidentes'), filas: [
      { titulo: 'Notificación a la AEPD pendiente', valor: inc.aepdPendientes, detalle: 'Requieren notificar (art. 33)', href: enlace('/incidentes?alerta=aepd_pendiente'), nivel: 'atencion' },
      { titulo: 'Notificación fuera de plazo (72 h)', valor: inc.aepdVencidos, detalle: 'Plazo legal superado', href: enlace('/incidentes?alerta=aepd_vencido'), nivel: 'critico' },
    ] },
  ];
  // Nota de lo transversal en la vista de un sistema concreto
  const notaTransversal = [
    tr.rgpd.riesgos ? { texto: plural(tr.rgpd.riesgos, 'riesgo', 'riesgos'), href: '/riesgos?sistema=ninguno' } : null,
    tr.rgpd.incidentesActivos ? { texto: plural(tr.rgpd.incidentesActivos, 'incidente abierto', 'incidentes abiertos'), href: '/incidentes?sistema=ninguno&alerta=activos' } : null,
    tr.rgpd.solicitudesAbiertas ? { texto: plural(tr.rgpd.solicitudesAbiertas, 'solicitud abierta', 'solicitudes abiertas'), href: '/derechos?sistema=ninguno&plazo=abiertas' } : null,
    tr.rgpd.actividades ? { texto: plural(tr.rgpd.actividades, 'actividad RAT', 'actividades RAT'), href: '/rat?sistema=ninguno' } : null,
  ].filter(Boolean);

  // ---- Zona Continuidad ----
  const b = v.bia;
  const filasBia = [
    { titulo: 'Procesos de negocio analizados', valor: b.procesos, detalle: b.criticidadMax ? 'Criticidad más alta: ' + CRITICIDADES[b.criticidadMax].toLowerCase() : '', href: enlace('/bia'), nivel: 'neutro' },
    { titulo: 'Críticos o altos sin plan de contingencia', valor: bia.sinPlan, detalle: `De ${plural(bia.altos, 'proceso crítico/alto', 'procesos críticos/altos')}`, href: enlace('/bia?filtro=sin_plan'), nivel: 'critico' },
    { titulo: 'Críticos o altos sin prueba en 12 meses', valor: bia.sinPrueba, detalle: 'Programa una prueba de continuidad', href: enlace('/bia?filtro=sin_prueba'), nivel: 'atencion' },
  ];

  // ---- Zona Riesgos e incidencias ----
  const maxRiesgo = Math.max(act.riesgosAltos, act.riesgosMedios, act.riesgosBajos, 1);
  const conclusionRiesgos = act.altosSinMedidas ? `${plural(act.altosSinMedidas, 'riesgo alto', 'riesgos altos')} sin medidas mitigadoras`
    : act.riesgosAltos ? `${plural(act.riesgosAltos, 'riesgo alto', 'riesgos altos')}, con medidas definidas`
    : act.riesgos ? 'Ningún riesgo de nivel alto' : 'Sin riesgos evaluados';
  const total12m = inc.abiertos12m + inc.cerrados12m;
  const pctCerrados = total12m ? Math.round((inc.cerrados12m / total12m) * 100) : 0;
  const conclusionInc = total12m ? `${inc.cerrados12m} de ${plural(total12m, 'incidente cerrado', 'incidentes cerrados')} (${pctCerrados} %) en 12 meses` : 'Ningún incidente en los últimos 12 meses';

  const nivelIcono = { critico: 'circle-dot', atencion: 'circle-alert', info: 'info' };
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="contenedor space-y-8 py-8 sm:py-10">

    <%# ================= 1. Cabecera: saludo + selector de sistema ================= %>
    <header class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Panel de control</p>
        <h1 class="mt-1.5 titulo-pagina">Hola, <%= nombrePila %></h1>
        <p class="subtitulo-pagina"><%= esTodos ? 'Estado de cumplimiento y seguridad de tu organización.' : 'Estado de cumplimiento y seguridad de «' + v.nombre + '».' %></p>
      </div>
      <div class="flex flex-col items-start gap-2 sm:items-end">
        <form action="/dashboard" method="GET" class="flex flex-wrap items-center gap-2">
          <label for="sistema-panel" class="flex items-center gap-1.5 text-sm font-medium text-slate-600"><%- icono('server', 'h-4 w-4 text-slate-400') %>Ver por sistema</label>
          <select id="sistema-panel" name="sistema" onchange="this.form.submit()" class="input w-auto min-w-64">
            <option value="">Todos los sistemas (<%= panel.sistemas.length %>)</option>
            <% panel.sistemas.forEach((s) => { %>
              <option value="<%= s.id %>" <%= sistema && sistema.id === s.id ? 'selected' : '' %>><%= s.nombre %></option>
            <% }) %>
          </select>
          <noscript><button type="submit" class="btn btn-secondary btn-sm">Ver</button></noscript>
        </form>
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-400">
          <% if (!esTodos) { %>
            <a href="/sistemas/<%= v.id %>" class="enlace inline-flex items-center gap-1"><%- icono('layout-dashboard', 'h-3 w-3') %>Ficha del sistema</a>
            <a href="/dashboard" class="enlace">Ver todos</a>
          <% } %>
          <span class="flex items-center gap-1"><%- icono('refresh-cw', 'h-3 w-3') %>Actualizado el <%= fechaHora(panel.generado) %></span>
        </p>
      </div>
    </header>

    <%# Aviso de plazos: solo si hay algo vencido (rojo) o próximo a vencer (ámbar) %>
    <% if (v.alertas.length) { %>
      <a href="#acciones" class="flex flex-wrap items-center justify-between gap-3 rounded-xl border px-4 py-3 text-sm transition hover:shadow-sm <%= vencidas ? 'border-red-200 bg-red-50/70 text-red-800' : 'border-amber-200 bg-amber-50/70 text-amber-900' %>" role="status">
        <span class="flex items-center gap-2.5">
          <%- icono('triangle-alert', 'h-4 w-4 shrink-0') %>
          <span>
            <% if (vencidas) { %><strong><%= plural(vencidas, 'plazo vencido', 'plazos vencidos') %></strong><% } %><%= vencidas && proximas ? ' · ' : '' %><% if (proximas) { %><strong><%= plural(proximas, 'plazo próximo', 'plazos próximos') %></strong> a vencer<% } %>
          </span>
        </span>
        <span class="inline-flex items-center gap-1 font-medium">Ver acciones<%- icono('arrow-down', 'h-3.5 w-3.5') %></span>
      </a>
    <% } %>

    <%# ================= 2. KPIs ================= %>
    <section aria-label="Indicadores clave" class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      <%# Cumplimiento ENS %>
      <a href="<%= esTodos ? '#zona-ens' : (v.ens.ultima ? '/evaluaciones/' + v.ens.ultima.id : '/sistemas/' + v.id + '#ens') %>" class="card flex flex-col p-5 transition hover:border-indigo-200 hover:shadow-sm">
        <p class="flex items-center gap-2 text-sm font-medium text-slate-600"><%- icono('shield-check', 'h-4 w-4 text-slate-400') %>Cumplimiento ENS</p>
        <% if (pctEns === null || pctEns === undefined) { %>
          <p class="mt-3 text-[32px] leading-10 font-semibold text-slate-300">—</p>
          <p class="mt-auto pt-2 text-xs text-slate-500">Sin evaluaciones todavía</p>
        <% } else { const e = estadoPct(pctEns); %>
          <p class="mt-3 text-[32px] leading-10 font-semibold tabular-nums tracking-tight text-slate-900"><%= pctEns %><span class="text-xl text-slate-400"> %</span></p>
          <div class="progreso mt-2 h-1.5"><span class="<%= colorPct(pctEns) %>" style="width: <%= pctEns %>%"></span></div>
          <p class="mt-auto flex items-start gap-1 pt-2 text-xs <%= e.color %>"><%- icono(e.icono, 'mt-px h-3.5 w-3.5 shrink-0') %>
            <span><% if (esTodos && peor) { %>Media · peor: <strong><%= peor.nombre %> <%= peor.ens.porcentaje %> %</strong><% if (bajos) { %><span class="block text-slate-500"><%= bajos %> de <%= evaluados.length %> por debajo del 50 %</span><% } %><% } else { %><%= v.ens.global.implementados %> de <%= v.ens.global.aplicables %> controles aplicables<% } %></span>
          </p>
        <% } %>
      </a>

      <%# Acciones pendientes %>
      <a href="#acciones" class="card flex flex-col p-5 transition hover:border-indigo-200 hover:shadow-sm">
        <p class="flex items-center gap-2 text-sm font-medium text-slate-600"><%- icono('list-todo', 'h-4 w-4 text-slate-400') %>Acciones pendientes</p>
        <p class="mt-3 text-[32px] leading-10 font-semibold tabular-nums tracking-tight <%= urgentes.length ? 'text-slate-900' : 'text-slate-300' %>"><%= urgentes.length %></p>
        <% if (criticas) { %>
          <p class="mt-auto flex items-center gap-1 pt-2 text-xs text-red-700"><%- icono('circle-dot', 'h-3.5 w-3.5') %><%= plural(criticas, 'crítica', 'críticas') %></p>
        <% } else if (urgentes.length) { %>
          <p class="mt-auto flex items-center gap-1 pt-2 text-xs text-amber-700"><%- icono('circle-alert', 'h-3.5 w-3.5') %>Requieren atención</p>
        <% } else { %>
          <p class="mt-auto pt-2 text-xs text-slate-400">Nada urgente</p>
        <% } %>
      </a>

      <%# Incidentes abiertos %>
      <a href="<%= enlace('/incidentes?alerta=activos') %>" class="card flex flex-col p-5 transition hover:border-indigo-200 hover:shadow-sm">
        <p class="flex items-center gap-2 text-sm font-medium text-slate-600"><%- icono('siren', 'h-4 w-4 text-slate-400') %>Incidentes abiertos</p>
        <p class="mt-3 text-[32px] leading-10 font-semibold tabular-nums tracking-tight <%= incAbiertos ? 'text-slate-900' : 'text-slate-300' %>"><%= incAbiertos %></p>
        <% if (inc.aepdVencidos) { %>
          <p class="mt-auto flex items-center gap-1 pt-2 text-xs text-red-700"><%- icono('circle-dot', 'h-3.5 w-3.5') %><%= inc.aepdVencidos %> fuera de plazo AEPD</p>
        <% } else if (incAbiertos) { %>
          <p class="mt-auto flex items-center gap-1 pt-2 text-xs text-amber-700"><%- icono('circle-alert', 'h-3.5 w-3.5') %>En gestión</p>
        <% } else { %>
          <p class="mt-auto pt-2 text-xs text-slate-400">Ninguno abierto</p>
        <% } %>
      </a>

      <%# Próximo vencimiento %>
      <a href="<%= proximo ? proximo.href : '#acciones' %>" class="card flex flex-col p-5 transition hover:border-indigo-200 hover:shadow-sm">
        <p class="flex items-center gap-2 text-sm font-medium text-slate-600"><%- icono('calendar-clock', 'h-4 w-4 text-slate-400') %>Próximo vencimiento</p>
        <% if (proximo) { %>
          <p class="mt-3 text-[32px] leading-10 font-semibold tabular-nums tracking-tight text-slate-900"><%= proximo.plazo %></p>
          <p class="mt-auto flex flex-wrap items-center gap-1.5 pt-2 text-xs text-slate-600">
            <% if (etiquetaArea[proximo.area]) { %><span class="etiqueta-area" data-area="<%= proximo.area %>"><%= etiquetaArea[proximo.area] %></span><% } %>
            <span class="truncate"><%= proximo.texto %></span>
          </p>
        <% } else { %>
          <p class="mt-3 text-[32px] leading-10 font-semibold text-slate-300">—</p>
          <p class="mt-auto pt-2 text-xs text-slate-400">Sin plazos pendientes</p>
        <% } %>
      </a>
    </section>

    <%
      // Contadores de las barras de los bloques plegables
      const avisosRgpd = tarjetasRgpd.flatMap((t) => t.filas).filter((k) => k.valor > 0 && (k.nivel === 'critico' || k.nivel === 'atencion')).length;
    %>

    <%# Bloques plegables (partials/plegable-abrir.ejs): plegados por defecto, se despliegan uno a uno %>
    <div class="space-y-4">
    <%# ================= 3. Acciones pendientes ================= %>
    <%- include('partials/plegable-abrir', { id: 'acciones', titulo: 'Acciones pendientes', iconoBarra: 'list-todo', contador: acciones.length }) %>
      <div x-data="{ todas: false }" class="space-y-3">
        <p class="flex items-center gap-1.5 text-xs text-slate-500"><%- icono('sparkles', 'h-3.5 w-3.5 text-violet-500') %>Ordenadas por urgencia a partir de tus datos</p>
        <div class="card">
          <% if (!acciones.length) { %>
            <p class="px-5 py-6 text-sm text-slate-500">No hay acciones pendientes<%= esTodos ? '' : ' para este sistema' %>.</p>
          <% } else { %>
            <ul class="divide-y divide-slate-100">
              <% acciones.forEach((a, i) => { const e = nivelEstilo[a.nivel]; %>
                <li <%- i >= 6 ? 'x-show="todas" x-cloak' : '' %> class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
                  <div class="flex min-w-0 items-start gap-3">
                    <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg <%= a.nivel === 'critico' ? 'bg-red-50 text-red-600' : a.nivel === 'atencion' ? 'bg-amber-50 text-amber-600' : 'bg-slate-50 text-slate-500' %>"><%- icono(a.icono, 'h-4 w-4') %></span>
                    <div class="min-w-0">
                      <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-slate-900">
                        <% if (etiquetaArea[a.area]) { %><span class="etiqueta-area" data-area="<%= a.area %>"><%= etiquetaArea[a.area] %></span><% } %>
                        <%- include('partials/ambito', { ambito: a.ambito }) %>
                        <a href="<%= a.href %>" class="enlace-registro" title="<%= a.accion %>"><%= a.titulo %></a>
                      </p>
                      <p class="mt-0.5 text-[13px] text-slate-500"><%= a.motivo %></p>
                    </div>
                  </div>
                  <div class="flex shrink-0 items-center gap-3 pl-11 sm:pl-0">
                    <span class="flex items-center gap-1 text-xs font-medium <%= e.texto %>"><%- icono(nivelIcono[a.nivel], 'h-3.5 w-3.5') %><%= e.etiqueta %></span>
                  </div>
                </li>
              <% }) %>
            </ul>
            <% if (acciones.length > 6) { %>
              <button type="button" class="w-full border-t border-slate-100 px-5 py-2.5 text-sm font-medium text-indigo-600 hover:bg-slate-50" @click="todas = !todas"
                      x-text="todas ? 'Ver menos' : 'Ver las <%= acciones.length %> acciones'">Ver las <%= acciones.length %> acciones</button>
            <% } %>
          <% } %>
        </div>
      </div>
    <%- include('partials/plegable-cerrar') %>

    <%# ================= 4. Zona RGPD (incluye Riesgos e incidencias) ================= %>
    <%- include('partials/plegable-abrir', { id: 'zona-rgpd', titulo: 'RGPD · Protección de datos', iconoBarra: 'scale', area: 'rgpd', contador: (avisosRgpd ? plural(avisosRgpd, 'aviso', 'avisos') : 'sin avisos') + ' · ' + plural(act.riesgos, 'riesgo', 'riesgos') + ' · ' + plural(incAbiertos, 'incidente abierto', 'incidentes abiertos') }) %>
      <div class="grid gap-4 md:grid-cols-2">
        <% tarjetasRgpd.forEach((t) => { %>
          <div class="card p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="flex items-center gap-2 font-semibold text-slate-900"><%- icono(t.icono, 'h-4 w-4 text-slate-400') %><%= t.titulo %></h3>
              <a href="<%= t.href %>" class="zona-enlace">Ver módulo<%- icono('arrow-right', 'h-3.5 w-3.5') %></a>
            </div>
            <% if (t.nota) { %><p class="mt-1 text-xs text-slate-500"><%= t.nota %></p><% } %>
            <div class="mt-2 divide-y divide-slate-100"><% t.filas.forEach((k) => { %><%- include('partials/metrica', { k }) %><% }) %></div>
          </div>
        <% }) %>
      </div>
      <% if (!esTodos && notaTransversal.length) { %>
        <p class="text-xs text-slate-500">
          + <% notaTransversal.forEach((n, i) => { %><%= i ? ', ' : '' %><a href="<%= n.href %>" class="zona-enlace"><%= n.texto %></a><% }) %>
          transversales no asignados a ningún sistema.
        </p>
      <% } %>

      <%# --- Subsección: Riesgos e incidencias (antes, sección independiente) --- %>
      <div id="zona-riesgos" class="scroll-mt-24 space-y-4 border-t border-slate-200/80 pt-5">
        <%- include('partials/subseccion-titulo', { titulo: 'Riesgos e incidencias', iconoBarra: 'activity', contador: plural(act.riesgos, 'riesgo', 'riesgos') + ' · ' + plural(incAbiertos, 'incidente abierto', 'incidentes abiertos') }) %>
        <div class="grid gap-4 lg:grid-cols-2">
          <a href="<%= enlace('/riesgos') %>" class="card group flex flex-col p-5 transition hover:border-slate-300">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-semibold text-slate-900"><%= conclusionRiesgos %></h3>
                <p class="text-xs text-slate-500">Riesgos por nivel · <%= plural(act.riesgos, 'evaluado', 'evaluados') %></p>
              </div>
              <span class="zona-enlace shrink-0">Ver riesgos<%- icono('arrow-right', 'h-3.5 w-3.5') %></span>
            </div>
            <div class="mt-4 space-y-3">
              <% [['Alto', act.riesgosAltos, 'bg-red-500'], ['Medio', act.riesgosMedios, 'bg-amber-500'], ['Bajo', act.riesgosBajos, 'bg-emerald-500']].forEach(([t, val, c]) => { %>
                <div class="grid grid-cols-[5rem_1fr_2.5rem] items-center gap-3 text-sm">
                  <span class="flex items-center gap-2 text-slate-600"><span class="punto <%= c %>"></span><%= t %></span>
                  <span class="progreso h-2"><span class="<%= c %>" style="width: <%= Math.round((val / maxRiesgo) * 100) %>%"></span></span>
                  <span class="text-right font-semibold tabular-nums <%= val ? 'text-slate-800' : 'text-slate-300' %>"><%= val %></span>
                </div>
              <% }) %>
            </div>
          </a>
  
          <a href="<%= enlace('/incidentes') %>" class="card group flex flex-col p-5 transition hover:border-slate-300">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-semibold text-slate-900"><%= conclusionInc %></h3>
                <p class="text-xs text-slate-500">Incidentes detectados en los últimos 12 meses</p>
              </div>
              <span class="zona-enlace shrink-0">Ver incidentes<%- icono('arrow-right', 'h-3.5 w-3.5') %></span>
            </div>
            <% if (total12m) { %>
              <div class="mt-4 flex h-2.5 overflow-hidden rounded-full bg-slate-100" role="img" aria-label="<%= inc.cerrados12m %> cerrados y <%= inc.abiertos12m %> abiertos">
                <div class="h-full bg-emerald-500" style="width: <%= pctCerrados %>%"></div>
                <div class="h-full <%= inc.abiertos12m ? 'bg-amber-500' : '' %>" style="width: <%= 100 - pctCerrados %>%"></div>
              </div>
              <div class="mt-2 flex flex-wrap gap-4 text-xs text-slate-600">
                <span class="flex items-center gap-1.5"><span class="punto bg-emerald-500"></span>Cerrados: <strong class="tabular-nums"><%= inc.cerrados12m %></strong></span>
                <span class="flex items-center gap-1.5"><span class="punto bg-amber-500"></span>Abiertos: <strong class="tabular-nums"><%= inc.abiertos12m %></strong></span>
              </div>
            <% } %>
            <p class="mt-5 text-xs font-medium uppercase tracking-wide text-slate-400">Abiertos por gravedad</p>
            <div class="mt-2 grid grid-cols-4 gap-2 text-center">
              <% [['CRITICA', 'bg-red-500'], ['ALTA', 'bg-orange-500'], ['MEDIA', 'bg-yellow-500'], ['BAJA', 'bg-emerald-500']].forEach(([g, c]) => { const n = inc.activosPorGravedad[g]; %>
                <div class="rounded-lg border border-slate-100 py-2">
                  <p class="text-[22px] leading-7 font-semibold tabular-nums <%= n ? 'text-slate-900' : 'text-slate-300' %>"><%= n %></p>
                  <p class="flex items-center justify-center gap-1 text-[11px] text-slate-500"><span class="punto h-1.5 w-1.5 <%= c %>"></span><%= GRAVEDADES[g] %></p>
                </div>
              <% }) %>
            </div>
          </a>
        </div>
        <% if (!esTodos) { %><p class="text-xs text-slate-500">Riesgos e incidentes asociados a «<%= v.nombre %>».</p><% } %>
      </div>
    <%- include('partials/plegable-cerrar') %>

    <%# ================= 5. Zona ENS (incluye Continuidad / BIA) ================= %>
    <%- include('partials/plegable-abrir', { id: 'zona-ens', titulo: 'ENS · Esquema Nacional de Seguridad', iconoBarra: 'shield-check', area: 'ens', contador: (pctEns === null || pctEns === undefined ? 'sin evaluar' : pctEns + ' %') + ' · ' + plural(b.procesos, 'proceso BIA', 'procesos BIA') }) %>
      <div class="grid gap-4 lg:grid-cols-3">
        <div class="card flex flex-col p-5">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="font-semibold text-slate-900"><%= conclusionEns %></h3>
              <p class="text-xs text-slate-500">Cumplimiento por sistema · última evaluación</p>
            </div>
            <a href="/sistemas" class="zona-enlace shrink-0">Ver sistemas<%- icono('arrow-right', 'h-3.5 w-3.5') %></a>
          </div>
          <% if (!sistemasEns.length) { %>
            <div class="vacio"><%- icono('server', 'h-6 w-6 text-slate-300') %>Todavía no hay sistemas registrados.</div>
          <% } else { %>
            <ul class="mt-3 space-y-1">
              <% sistemasEns.forEach((s) => { const pct = s.global ? s.global.porcentaje : null; %>
                <li>
                  <a href="<%= s.ultima ? '/evaluaciones/' + s.ultima.id : '/sistemas/' + s.id + '#ens' %>" class="-mx-2 grid grid-cols-[minmax(0,1fr)_5rem_3rem] items-center gap-3 rounded-lg px-2 py-1.5 transition hover:bg-slate-50">
                    <span class="truncate text-sm text-slate-800"><%= s.nombre %></span>
                    <% if (pct === null) { %>
                      <span class="h-2 rounded-full border border-dashed border-slate-300" aria-hidden="true"></span>
                      <span class="text-right text-xs italic text-slate-400">Sin eval.</span>
                    <% } else { %>
                      <span class="progreso h-2" aria-hidden="true"><span class="<%= colorPct(pct) %>" style="width: <%= Math.max(pct, 2) %>%"></span></span>
                      <span class="text-right text-sm font-semibold tabular-nums text-slate-800"><%= pct %> %</span>
                    <% } %>
                  </a>
                </li>
              <% }) %>
            </ul>
            <p class="mt-auto flex flex-wrap gap-3 border-t border-slate-100 pt-3 text-[11px] text-slate-500">
              <span class="flex items-center gap-1"><span class="punto bg-emerald-500"></span>≥ 80 %</span>
              <span class="flex items-center gap-1"><span class="punto bg-amber-500"></span>50–79 %</span>
              <span class="flex items-center gap-1"><span class="punto bg-red-500"></span>&lt; 50 %</span>
            </p>
          <% } %>
        </div>

        <div class="card p-5">
          <div class="flex items-center justify-between gap-3">
            <h3 class="flex items-center gap-2 font-semibold text-slate-900"><%- icono('file-badge', 'h-4 w-4 text-slate-400') %>Declaraciones de Conformidad</h3>
            <a href="<%= enlace('/declaraciones') %>" class="zona-enlace">Ver módulo<%- icono('arrow-right', 'h-3.5 w-3.5') %></a>
          </div>
          <p class="mt-1 text-xs text-slate-500"><%= decl.alDia %> de <%= plural(decl.totalSistemas, 'sistema', 'sistemas') %> con declaración vigente</p>
          <div class="mt-2 divide-y divide-slate-100"><% filasDecl.forEach((k) => { %><%- include('partials/metrica', { k }) %><% }) %></div>
        </div>

        <div class="card p-5">
          <div class="flex items-center justify-between gap-3">
            <h3 class="flex items-center gap-2 font-semibold text-slate-900"><%- icono('book-open-check', 'h-4 w-4 text-slate-400') %>Políticas y documentación</h3>
            <a href="/politicas" class="zona-enlace">Ver módulo<%- icono('arrow-right', 'h-3.5 w-3.5') %></a>
          </div>
          <% if (!esTodos) { %><p class="mt-1 text-xs text-slate-500">Recuento de toda la organización (generales y de cada sistema).</p><% } %>
          <div class="mt-2 divide-y divide-slate-100"><% filasPol.forEach((k) => { %><%- include('partials/metrica', { k }) %><% }) %></div>
        </div>
      </div>

      <%# --- Subsección: Continuidad del negocio (BIA) (antes, sección independiente) --- %>
      <div id="zona-bia" class="scroll-mt-24 space-y-4 border-t border-slate-200/80 pt-5">
        <div class="flex items-center justify-between gap-3">
          <%- include('partials/subseccion-titulo', { titulo: 'Continuidad del negocio (BIA)', iconoBarra: 'life-buoy', contador: plural(b.procesos, 'proceso', 'procesos') }) %>
          <a href="<%= enlace('/bia') %>" class="zona-enlace shrink-0">Ver módulo<%- icono('arrow-right', 'h-3.5 w-3.5') %></a>
        </div>
        <div class="card p-5">
          <% if (!b.procesos) { %>
            <div class="flex flex-col items-center gap-3 py-6 text-center">
              <span class="zona-icono"><%- icono('life-buoy', 'h-5 w-5') %></span>
              <p class="text-sm text-slate-600"><%= esTodos ? 'Todavía no se ha analizado ningún proceso de negocio.' : 'Ningún proceso de negocio depende de este sistema.' %></p>
              <% if (user.rol === 'ADMIN') { %>
                <a href="/bia/nuevo" class="btn btn-primary btn-sm"><%- icono('plus', 'h-3.5 w-3.5') %>Analizar primer proceso</a>
              <% } else { %>
                <p class="text-xs text-slate-400">Un administrador puede registrar el primer análisis.</p>
              <% } %>
            </div>
          <% } else { %>
            <div class="grid gap-x-8 md:grid-cols-3">
              <% filasBia.forEach((k) => { %><div class="border-b border-slate-100 last:border-b-0 md:border-b-0"><%- include('partials/metrica', { k }) %></div><% }) %>
            </div>
            <% if (bia.urgentes.length) { %>
              <div class="mt-3 border-t border-slate-100 pt-3">
                <p class="flex items-center gap-1.5 text-xs font-semibold text-red-700"><%- icono('circle-dot', 'h-3.5 w-3.5') %>Pendientes de análisis</p>
                <ul class="mt-1 flex flex-wrap gap-x-6 gap-y-1 text-sm">
                  <% bia.urgentes.forEach((p) => { %>
                    <li><a href="/bia/<%= p.id %>" class="text-slate-800 hover:underline"><%= p.nombre %></a> <span class="text-xs text-slate-500">· <%= CRITICIDADES[p.criticidad] %></span></li>
                  <% }) %>
                </ul>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>
    <%- include('partials/plegable-cerrar') %>

    <%# ================= 6. Actividad reciente ================= %>
    <%- include('partials/plegable-abrir', { id: 'actividad', titulo: 'Actividad reciente', iconoBarra: 'history', contador: Math.min(actividad.length, 5) }) %>
      <div class="card p-5">
        <% if (actividad.length === 0) { %>
          <p class="text-sm text-slate-500">Todavía no hay actividad registrada.</p>
        <% } else { %>
          <ol class="relative space-y-5 before:absolute before:inset-y-2 before:left-4 before:w-px before:bg-slate-200">
            <% actividad.slice(0, 5).forEach((ev) => { const zona = areaDeEnlace(ev.href); %>
              <li class="relative flex gap-4">
                <span class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-slate-500 ring-1 ring-slate-200"><%- icono(ev.icono, 'h-4 w-4') %></span>
                <div class="min-w-0 flex-1 pt-0.5">
                  <p class="text-sm text-slate-700">
                    <a href="<%= ev.href %>" class="font-medium text-slate-900 hover:text-indigo-600 hover:underline"><%= ev.texto %></a>
                    <% if (ev.tipo === 'estado') { const et = etiquetasEstado[ev.catalogo]; %>
                      <span class="text-slate-500">· <%= et[ev.anterior] %> → <strong class="font-medium text-slate-700"><%= et[ev.nuevo] %></strong></span>
                    <% } else if (ev.resultado) { %>
                      <span class="text-slate-500">· <%= RESULTADOS_PRUEBA[ev.resultado] %></span>
                    <% } %>
                  </p>
                  <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500">
                    <% if (etiquetaArea[zona]) { %><span class="etiqueta-area" data-area="<%= zona %>"><%= etiquetaArea[zona] %></span><% } %>
                    <%- include('partials/ambito', { ambito: ev.ambito }) %>
                    <span class="font-medium text-slate-600"><%= ev.modulo %></span> · <%= fechaHora(ev.fecha) %><%= ev.usuario ? ' · ' + ev.usuario : '' %>
                  </p>
                </div>
              </li>
            <% }) %>
          </ol>
        <% } %>
      </div>
    <%- include('partials/plegable-cerrar') %>
    </div>
  </main>
</body>
</html>
