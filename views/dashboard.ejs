<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body class="min-h-screen bg-slate-100">
  <%- include('partials/nav') %>

  <main class="max-w-6xl mx-auto px-4 py-8 space-y-6">
    <div class="bg-white rounded-2xl shadow p-8">
      <h1 class="text-2xl font-bold text-slate-800">
        Bienvenido, <%= user.nombre %> (<%= roles[user.rol] %>)
      </h1>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/rat" class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">
          Actividades RAT
        </a>
        <a href="/riesgos" class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">
          Riesgos
        </a>
        <a href="/incidentes" class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">
          Incidentes / Brechas
        </a>
        <a href="/derechos" class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">
          Derechos de los Interesados
        </a>
        <a href="/proveedores" class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">
          Proveedores
        </a>
        <a href="/sistemas" class="rounded-lg bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 transition">
          Sistemas ENS
        </a>
        <% if (user.rol === 'ADMIN') { %>
          <a href="/registro" class="rounded-lg border border-slate-300 px-4 py-2 text-slate-700 hover:bg-slate-50 transition">
            Registrar usuario
          </a>
        <% } %>
      </div>
    </div>

    <% if (politicas.misPendientes.length) { %>
      <section class="rounded-2xl border-2 border-indigo-300 bg-indigo-50 p-6" role="status">
        <h2 class="text-lg font-semibold text-indigo-900">
          Tienes <%= politicas.misPendientes.length %> documento(s) pendientes de leer y aceptar
        </h2>
        <ul class="mt-3 space-y-2">
          <% politicas.misPendientes.forEach((p) => { %>
            <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg bg-white px-4 py-2">
              <span class="text-slate-800">
                <%= p.titulo %> <span class="text-xs text-slate-500"><%= TIPOS_POLITICA[p.tipo_documento] %> · versión <%= p.version %></span>
              </span>
              <a href="/politicas/<%= p.id %>" class="rounded-lg bg-indigo-600 px-3 py-1 text-sm text-white hover:bg-indigo-700">Leer y aceptar</a>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <section class="bg-white rounded-2xl shadow p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-slate-800">Incidentes y brechas de seguridad</h2>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/incidentes/nuevo" class="text-indigo-600 hover:underline">+ Reportar incidente</a>
          <a href="/incidentes" class="text-indigo-600 hover:underline">Ver incidentes &rarr;</a>
        </div>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 p-5">
          <p class="text-sm font-medium text-slate-500">Incidentes activos</p>
          <p class="mt-1 text-3xl font-bold text-slate-800"><%= incidentes.abiertos %></p>
          <p class="mt-1 text-xs text-slate-500">No cerrados</p>
        </div>
        <div class="rounded-xl border p-5 <%= incidentes.aepdVencidos ? 'border-red-300 bg-red-50' : incidentes.aepdPendientes ? 'border-amber-300 bg-amber-50' : 'border-slate-200' %>">
          <p class="text-sm font-medium <%= incidentes.aepdVencidos ? 'text-red-800' : 'text-slate-500' %>">Notificación AEPD pendiente</p>
          <p class="mt-1 text-3xl font-bold <%= incidentes.aepdVencidos ? 'text-red-700' : 'text-slate-800' %>"><%= incidentes.aepdPendientes %></p>
          <p class="mt-1 text-xs <%= incidentes.aepdVencidos ? 'font-semibold text-red-700' : 'text-slate-500' %>">
            <%= incidentes.aepdVencidos %> fuera de plazo (más de 72 h)
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 p-5">
          <p class="text-sm font-medium text-slate-500">Incidente activo más grave</p>
          <% if (incidentes.masGrave) { const g = incidentes.masGrave; %>
            <a href="/incidentes/<%= g.id %>" class="mt-1 block font-semibold text-slate-800 hover:text-indigo-600 hover:underline line-clamp-2"><%= g.titulo %></a>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <%- include('partials/incidente-badges', { gravedadBadge: g.gravedad }) %>
              <%- include('partials/incidente-badges', { estadoBadge: g.estado }) %>
              <% if (g.plazo.tipo === 'vencido') { %><%- include('partials/plazo-aepd', { plazo: g.plazo }) %><% } %>
            </div>
          <% } else { %>
            <p class="mt-1 text-sm text-slate-500 italic">Ningún incidente activo</p>
          <% } %>
        </div>
      </div>
    </section>

    <section class="bg-white rounded-2xl shadow p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-slate-800">Derechos de los interesados</h2>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/derechos/nueva" class="text-indigo-600 hover:underline">+ Nueva solicitud</a>
          <a href="/derechos" class="text-indigo-600 hover:underline">Ver solicitudes &rarr;</a>
        </div>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 p-5">
          <p class="text-sm font-medium text-slate-500">Solicitudes abiertas</p>
          <p class="mt-1 text-3xl font-bold text-slate-800"><%= derechos.abiertas %></p>
          <p class="mt-1 text-xs text-slate-500">Sin resolver</p>
        </div>
        <a href="/derechos?plazo=vencidas" class="block rounded-xl border p-5 hover:shadow <%= derechos.vencidas ? 'border-red-300 bg-red-50' : 'border-slate-200' %>">
          <p class="text-sm font-medium <%= derechos.vencidas ? 'text-red-800' : 'text-slate-500' %>">Plazo vencido sin resolver</p>
          <p class="mt-1 text-3xl font-bold <%= derechos.vencidas ? 'text-red-700' : 'text-slate-800' %>"><%= derechos.vencidas %></p>
          <p class="mt-1 text-xs <%= derechos.vencidas ? 'font-semibold text-red-700' : 'text-slate-500' %>">
            <%= derechos.vencidas ? 'Requieren atención inmediata' : 'Todas dentro de plazo' %>
          </p>
        </a>
        <div class="rounded-xl border border-slate-200 p-5">
          <p class="text-sm font-medium text-slate-500">Próxima en vencer</p>
          <% if (derechos.proxima) { const p = derechos.proxima; %>
            <a href="/derechos/<%= p.id %>" class="mt-1 block font-semibold text-slate-800 hover:text-indigo-600 hover:underline">
              <%= TIPOS_DERECHO[p.tipo_derecho] %> · <%= p.nombre_solicitante %>
            </a>
            <p class="mt-1 text-xs text-slate-500">Fecha límite: <%= fecha(p.fecha_limite) %></p>
            <div class="mt-2"><%- include('partials/urgencia-derecho', { u: p.urgencia }) %></div>
          <% } else { %>
            <p class="mt-1 text-sm text-slate-500 italic">Ninguna solicitud pendiente dentro de plazo</p>
          <% } %>
        </div>
      </div>
    </section>

    <section class="bg-white rounded-2xl shadow p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-slate-800">Encargados del tratamiento / Proveedores</h2>
        <a href="/proveedores" class="text-sm text-indigo-600 hover:underline">Ver proveedores &rarr;</a>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <a href="/proveedores?estado=ACTIVO" class="block rounded-xl border border-slate-200 p-5 hover:shadow">
          <p class="text-sm font-medium text-slate-500">Proveedores activos</p>
          <p class="mt-1 text-3xl font-bold text-slate-800"><%= proveedores.activos %></p>
          <p class="mt-1 text-xs text-slate-500">Con relación vigente</p>
        </a>
        <a href="/proveedores?contrato=no" class="block rounded-xl border p-5 hover:shadow <%= proveedores.sinContrato ? 'border-red-300 bg-red-50' : 'border-slate-200' %>">
          <p class="text-sm font-medium <%= proveedores.sinContrato ? 'text-red-800' : 'text-slate-500' %>">Sin contrato de encargado</p>
          <p class="mt-1 text-3xl font-bold <%= proveedores.sinContrato ? 'text-red-700' : 'text-slate-800' %>"><%= proveedores.sinContrato %></p>
          <p class="mt-1 text-xs <%= proveedores.sinContrato ? 'font-semibold text-red-700' : 'text-slate-500' %>">Art. 28.3 · sin contar las bajas</p>
        </a>
        <div class="rounded-xl border p-5 <%= proveedores.sinMecanismo ? 'border-orange-300 bg-orange-50' : 'border-slate-200' %>">
          <p class="text-sm font-medium <%= proveedores.sinMecanismo ? 'text-orange-800' : 'text-slate-500' %>">Transferencia internacional sin garantías</p>
          <p class="mt-1 text-3xl font-bold <%= proveedores.sinMecanismo ? 'text-orange-700' : 'text-slate-800' %>"><%= proveedores.sinMecanismo %></p>
          <p class="mt-1 text-xs <%= proveedores.sinMecanismo ? 'font-semibold text-orange-700' : 'text-slate-500' %>">Fuera del EEE sin mecanismo señalado</p>
        </div>
      </div>
    </section>

    <section class="bg-white rounded-2xl shadow p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-slate-800">Políticas y documentación</h2>
        <a href="/politicas" class="text-sm text-indigo-600 hover:underline">Ver documentos &rarr;</a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border p-5 <%= politicas.revisionVencidas ? 'border-red-300 bg-red-50' : 'border-slate-200' %>">
          <p class="text-sm font-medium <%= politicas.revisionVencidas ? 'text-red-800' : 'text-slate-500' %>">Revisión vencida</p>
          <p class="mt-1 text-3xl font-bold <%= politicas.revisionVencidas ? 'text-red-700' : 'text-slate-800' %>"><%= politicas.revisionVencidas %></p>
          <p class="mt-1 text-xs text-slate-500">Documentos no obsoletos</p>
        </div>
        <div class="rounded-xl border p-5 <%= politicas.revisionProximas ? 'border-yellow-300 bg-yellow-50' : 'border-slate-200' %>">
          <p class="text-sm font-medium <%= politicas.revisionProximas ? 'text-yellow-800' : 'text-slate-500' %>">Revisión en 30 días o menos</p>
          <p class="mt-1 text-3xl font-bold text-slate-800"><%= politicas.revisionProximas %></p>
          <p class="mt-1 text-xs text-slate-500">Pendientes de revisión periódica</p>
        </div>
        <div class="rounded-xl border p-5 <%= politicas.misPendientes.length ? 'border-indigo-300 bg-indigo-50' : 'border-slate-200' %>">
          <p class="text-sm font-medium <%= politicas.misPendientes.length ? 'text-indigo-800' : 'text-slate-500' %>">Pendientes de tu aceptación</p>
          <p class="mt-1 text-3xl font-bold <%= politicas.misPendientes.length ? 'text-indigo-700' : 'text-slate-800' %>"><%= politicas.misPendientes.length %></p>
          <p class="mt-1 text-xs text-slate-500"><%= politicas.misPendientes.length ? 'Consúltalas arriba' : 'Estás al día' %></p>
        </div>
      </div>
    </section>

    <section class="bg-white rounded-2xl shadow p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-slate-800">Cumplimiento ENS por sistema</h2>
        <a href="/sistemas" class="text-sm text-indigo-600 hover:underline">Ver sistemas &rarr;</a>
      </div>

      <% if (sistemas.length === 0) { %>
        <p class="mt-6 text-sm text-slate-500">
          Todavía no hay sistemas.<% if (user.rol === 'ADMIN') { %> <a href="/sistemas/nuevo" class="text-indigo-600 hover:underline">Crea el primero</a>.<% } %>
        </p>
      <% } %>

      <div class="mt-6 space-y-6">
        <% sistemas.forEach((s) => { %>
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div class="flex flex-wrap items-center gap-3">
                <a href="/sistemas/<%= s.id %>" class="font-semibold text-slate-800 hover:text-indigo-600 hover:underline"><%= s.nombre %></a>
                <% if (s.categoria_general) { %><%- include('partials/categoria-badge', { categoria: s.categoria_general }) %><% } %>
                <% if (s.global) { %><%- include('partials/barra-global', { global: s.global }) %><% } %>
              </div>
              <% if (s.ultima) { %>
                <a href="/evaluaciones/<%= s.ultima.id %>" class="text-xs text-slate-500 hover:underline">Última evaluación: <%= s.ultima.nombre %></a>
              <% } %>
            </div>
            <div class="mt-2">
              <% if (s.resumen) { %>
                <%- include('partials/resumen-ens', { resumen: s.resumen, compacto: true }) %>
              <% } else { %>
                <p class="text-sm text-slate-500 italic">Sin evaluaciones todavía.</p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  </main>
</body>
</html>
