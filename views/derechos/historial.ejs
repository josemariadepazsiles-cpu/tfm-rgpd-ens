<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Derechos de los Interesados', href: '/derechos' }, { texto: 'Solicitud de ' + solicitud.nombre_solicitante, href: '/derechos/' + solicitud.id }, { texto: 'Historial' }] }) %>
    <h1 class="titulo-pagina">Historial de la solicitud</h1>
    <p class="subtitulo-pagina">
      <%= TIPOS_DERECHO[solicitud.tipo_derecho] %> · <%= solicitud.nombre_solicitante %> · <%= total %> cambio(s) · hora de España ·
      registrada el <%= fechaHora(solicitud.created_at) %><%= solicitud.creado_por ? ' por ' + solicitud.creado_por.nombre : '' %> en estado Recibida
    </p>

    <div class="mt-6 tabla-contenedor">
      <% if (cambios.length === 0) { %>
        <p class="p-8 text-center text-slate-500">Todavía no se ha cambiado el estado de esta solicitud.</p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Fecha y hora</th>
              <th>Usuario</th>
              <th>Estado anterior</th>
              <th class="w-4"></th>
              <th>Estado nuevo</th>
              <th>Detalle</th>
            </tr>
          </thead>
          <tbody>
            <% cambios.forEach((c) => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 whitespace-nowrap tabular-nums text-slate-700"><%= fechaHora(c.fecha) %></td>
                <td class="px-4 py-3 text-slate-600"><%= c.usuario ? c.usuario.nombre : '—' %></td>
                <td class="px-4 py-3"><%- include('../partials/estado-solicitud', { estadoSolicitud: c.estado_anterior }) %></td>
                <td class="px-1 py-3 text-slate-400" aria-hidden="true">&rarr;</td>
                <td class="px-4 py-3"><%- include('../partials/estado-solicitud', { estadoSolicitud: c.estado_nuevo }) %></td>
                <td class="px-4 py-3 text-slate-600"><%= c.detalle || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <% if (paginas > 1) { %>
      <nav class="mt-4 flex items-center justify-between text-sm" aria-label="Paginación">
        <% if (pagina > 1) { %>
          <a href="?pagina=<%= pagina - 1 %>" class="btn btn-secondary btn-sm">&larr; Más recientes</a>
        <% } else { %><span></span><% } %>
        <span class="text-slate-500">Página <%= pagina %> de <%= paginas %></span>
        <% if (pagina < paginas) { %>
          <a href="?pagina=<%= pagina + 1 %>" class="btn btn-secondary btn-sm">Más antiguos &rarr;</a>
        <% } else { %><span></span><% } %>
      </nav>
    <% } %>
  </main>
</body>
</html>
