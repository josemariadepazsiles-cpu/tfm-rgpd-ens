<%
  const selectClase = 'input w-auto';
  const vencidas = solicitudes.filter((s) => s.urgencia.nivel === 'rojo').length;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'RGPD' }, { texto: 'Derechos de los Interesados' }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">Derechos de los interesados<%- include('../partials/area-badge') %></h1>
        <p class="subtitulo-pagina">Solicitudes de acceso, rectificación, supresión, oposición, limitación y portabilidad (arts. 12 a 22 RGPD)</p>
      </div>
      <a href="/derechos/nueva" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Nueva solicitud</a>
    </div>

    <% if (vencidas && plazo !== 'vencidas') { %>
      <div class="mt-6 aviso alerta-error" role="alert"><%- icono('triangle-alert') %>
        <strong><%= vencidas %> solicitud(es)</strong> han superado su fecha límite sin resolverse.
        <a href="/derechos?plazo=vencidas" class="font-medium underline">Ver solo las vencidas</a>
      </div>
    <% } %>

    <form action="/derechos" method="GET" class="mt-6 flex flex-wrap items-end gap-3">
      <div>
        <label for="tipo" class="label">Tipo de derecho</label>
        <select id="tipo" name="tipo" onchange="this.form.submit()" class="<%= selectClase %>">
          <option value="">Todos</option>
          <% Object.entries(TIPOS_DERECHO).forEach(([v, etiqueta]) => { %>
            <option value="<%= v %>" <%= tipo === v ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="estado" class="label">Estado</label>
        <select id="estado" name="estado" onchange="this.form.submit()" class="<%= selectClase %>">
          <option value="">Todos</option>
          <% Object.entries(ESTADOS_SOLICITUD).forEach(([v, etiqueta]) => { %>
            <option value="<%= v %>" <%= estado === v ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="plazo" class="label">Plazo</label>
        <select id="plazo" name="plazo" onchange="this.form.submit()" class="<%= selectClase %>">
          <option value="">Todos</option>
          <option value="abiertas" <%= plazo === 'abiertas' ? 'selected' : '' %>>Sin resolver</option>
          <option value="proximas" <%= plazo === 'proximas' ? 'selected' : '' %>>Vencen en <%= DIAS_AVISO %> días o menos</option>
          <option value="vencidas" <%= plazo === 'vencidas' ? 'selected' : '' %>>Vencidas sin resolver</option>
        </select>
      </div>
      <%- include('../partials/filtro-sistema', { sistemas, sistema }) %>
      <noscript><button type="submit" class="btn btn-secondary">Filtrar</button></noscript>
      <% if (tipo || estado || plazo || sistema) { %>
        <a href="/derechos" class="py-2 text-sm text-indigo-600 hover:underline">Quitar filtros</a>
      <% } %>
    </form>

    <div class="mt-4 tabla-contenedor">
      <% if (solicitudes.length === 0) { %>
        <p class="p-8 text-center text-slate-500">
          <%= tipo || estado || plazo || sistema ? 'No hay solicitudes con esos filtros.' : 'No se ha registrado ninguna solicitud.' %>
        </p>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Solicitante</th>
              <th>Derecho</th>
              <th>Sistema</th>
              <th>Recepción</th>
              <th>Fecha límite</th>
              <th>Estado</th>
              <th>Responsable</th>
            </tr>
          </thead>
          <tbody>
            <% solicitudes.forEach((s) => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3">
                  <a href="/derechos/<%= s.id %>" class="enlace-registro"><%= s.nombre_solicitante %></a>
                  <span class="block text-xs text-slate-500"><%= s.email_solicitante %></span>
                </td>
                <td class="px-4 py-3 text-slate-700"><%= TIPOS_DERECHO[s.tipo_derecho] %></td>
                <td class="px-4 py-3"><%- include('../partials/sistema-celda', { s: s.sistema }) %></td>
                <td class="px-4 py-3 text-slate-600 whitespace-nowrap"><%= fecha(s.fecha_recepcion) %></td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="text-slate-700"><%= fecha(s.fecha_limite) %></span>
                  <% if (s.plazo_ampliado) { %><span class="ml-1 text-xs text-amber-700" title="Plazo ampliado 2 meses (art. 12.3)">(ampliado)</span><% } %>
                  <div class="mt-1"><%- include('../partials/urgencia-derecho', { u: s.urgencia }) %></div>
                </td>
                <td class="px-4 py-3"><%- include('../partials/estado-solicitud', { estadoSolicitud: s.estado }) %></td>
                <td class="px-4 py-3 text-slate-600">
                  <% if (!s.responsable) { %>
                    <span class="text-slate-400 italic">Sin asignar</span>
                  <% } else { %>
                    <%= s.responsable.nombre %><% if (s.responsable.id === user.id) { %> <strong>(tú)</strong><% } %>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
    <p class="mt-3 text-xs text-slate-500">
      Plazo de respuesta: 1 mes desde la recepción, ampliable 2 meses más en casos complejos (art. 12.3 RGPD).
      Verde: más de <%= DIAS_AVISO %> días · Amarillo: <%= DIAS_AVISO %> días o menos · Rojo: vencida sin resolver.
    </p>
  </main>
</body>
</html>
