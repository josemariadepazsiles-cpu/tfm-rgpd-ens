<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'ENS' }, { texto: 'Catálogo de controles' }] }) %>
    <%- include('../partials/flash') %>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">Catálogo de controles ENS<%- include('../partials/area-badge') %></h1>
        <p class="subtitulo-pagina">Todos estos controles se evalúan en cada evaluación de cada sistema</p>
      </div>
      <a href="/controles/nuevo" class="btn btn-primary"><%- icono('plus', 'h-4 w-4') %>Nuevo control</a>
    </div>

    <div class="mt-6 space-y-6">
      <% grupos.forEach((g) => { %>
        <section class="card overflow-hidden">
          <header class="flex items-center justify-between border-b px-6 py-3 <%= categoriaClases[g.categoria].cabecera %>">
            <h2 class="flex items-center gap-2.5 font-semibold"><span class="punto <%= categoriaClases[g.categoria].punto %>" aria-hidden="true"></span>Categoría <%= categorias[g.categoria] %> <span class="font-normal text-slate-400">(<%= g.controles.length %>)</span></h2>
            <a href="/controles/nuevo?categoria=<%= g.categoria %>" class="text-sm hover:underline">Añadir</a>
          </header>
          <ul class="divide-y divide-slate-100">
            <% g.controles.forEach((c) => { %>
              <li class="flex flex-wrap items-center justify-between gap-3 px-6 py-3">
                <div class="min-w-0 flex-1">
                  <span class="text-slate-800"><%= c.nombre %></span>
                  <span class="ml-2 text-xs text-slate-400">evaluado en <%= c._count.evaluaciones %> evaluación(es)</span>
                  <% if (c.descripcion) { %>
                    <p class="mt-0.5 line-clamp-2 max-w-3xl text-xs text-slate-500" title="<%= c.descripcion %>"><%= c.descripcion %></p>
                  <% } %>
                </div>
                <div class="flex shrink-0 gap-2 text-sm">
                  <a href="/controles/<%= c.id %>/editar" class="btn btn-secondary btn-sm"><%- icono('pencil', 'h-3.5 w-3.5') %>Editar</a>
                  <form action="/controles/<%= c.id %>/eliminar" method="POST" data-nombre="<%= c.nombre %>"
                        onsubmit="return confirm('¿Eliminar «' + this.dataset.nombre + '» del catálogo?')">
                    <button type="submit" class="btn btn-danger btn-sm"><%- icono('trash-2', 'h-3.5 w-3.5') %>Eliminar</button>
                  </form>
                </div>
              </li>
            <% }) %>
            <% if (g.controles.length === 0) { %>
              <li class="px-6 py-4 text-sm text-slate-500">No hay controles en esta categoría.</li>
            <% } %>
          </ul>
        </section>
      <% }) %>
    </div>
  </main>
</body>
</html>
