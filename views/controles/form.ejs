<%
  const inputClase = 'input';
  const accion = control.id ? '/controles/' + control.id : '/controles';
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'ENS' }, { texto: 'Catálogo de controles', href: '/controles' }, { texto: title }] }) %>
    <div class="flex items-center justify-between">
      <h1 class="titulo-pagina"><%= title %><%- include('../partials/area-badge') %></h1>
    </div>

    <% if (errores.length) { %>
      <ul class="mt-6 rounded-xl border border-red-200 bg-red-50/60 px-4 py-3 text-sm text-red-800 list-disc list-inside space-y-0.5" role="alert">
        <% errores.forEach((e) => { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <form action="<%= accion %>" method="POST" class="mt-6 card p-6 space-y-4">
      <div>
        <label for="nombre" class="label">Nombre del control</label>
        <input maxlength="200" id="nombre" name="nombre" type="text" required value="<%= control.nombre || '' %>" class="<%= inputClase %>">
      </div>
      <div>
        <label for="categoria" class="label">Categoría</label>
        <select id="categoria" name="categoria" required class="<%= inputClase %>">
          <option value="" disabled <%= control.categoria ? '' : 'selected' %>>Selecciona una categoría</option>
          <% Object.entries(categorias).forEach(([valor, etiqueta]) => { %>
            <option value="<%= valor %>" <%= control.categoria === valor ? 'selected' : '' %>><%= etiqueta %></option>
          <% }) %>
        </select>
      </div>
      <div x-data="{ n: <%= (control.descripcion || '').length %> }">
        <label for="descripcion" class="label">Descripción <span class="font-normal text-slate-400">(opcional)</span></label>
        <textarea id="descripcion" name="descripcion" rows="5" maxlength="<%= maxDescripcion %>" class="<%= inputClase %> resize-y"
                  @input="n = $event.target.value.length"
                  placeholder="Objetivo del control y qué debe implantar la organización (Anexo II del ENS)."><%= control.descripcion || '' %></textarea>
        <p class="ayuda flex justify-between gap-3">
          <span>Se muestra en el catálogo bajo el nombre del control.</span>
          <span class="shrink-0 tabular-nums" x-text="n + ' / <%= maxDescripcion %>'"><%= (control.descripcion || '').length %> / <%= maxDescripcion %></span>
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
        <% if (control.id) { %>
          <%# Formulario de borrado fuera de este (ver más abajo), enlazado con el atributo form %>
          <button type="submit" form="form-eliminar" class="btn btn-danger mr-auto"><%- icono('trash-2', 'h-4 w-4') %>Eliminar</button>
        <% } %>
        <a href="/controles" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          <%= control.id ? 'Guardar cambios' : 'Crear control' %>
        </button>
      </div>
    </form>
    <% if (control.id) { %>
      <form id="form-eliminar" action="/controles/<%= control.id %>/eliminar" method="POST" data-nombre="<%= control.nombre %>"
            onsubmit="return confirm('¿Eliminar «' + this.dataset.nombre + '» del catálogo? Si ya se ha evaluado en algún sistema no se podrá eliminar, para no perder su histórico.')"></form>
    <% } %>
  </main>
  <%- include('../partials/pie') %>
</body>
</html>
