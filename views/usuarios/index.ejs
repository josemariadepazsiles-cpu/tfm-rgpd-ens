<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-fondo">
  <%- include('../partials/nav') %>

  <main data-area="<%= areaNormativa %>" class="contenedor py-8 sm:py-10">
    <%- include('../partials/migas', { migas: [{ texto: 'Administración' }, { texto: 'Usuarios' }] }) %>
    <%- include('../partials/flash') %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="titulo-pagina">Usuarios</h1>
        <p class="subtitulo-pagina">Personas de la organización con acceso a la plataforma. Los sistemas asignados determinan qué políticas de sistema deben aceptar.</p>
      </div>
      <a href="/usuarios/nuevo" class="btn btn-primary"><%- icono('user-plus', 'h-4 w-4') %>Nuevo usuario</a>
    </div>

    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Filtrar por estado">
      <% [['activos', 'Activos'], ['inactivos', 'Desactivados']].forEach(([v, t]) => { %>
        <a href="/usuarios?estado=<%= v %>"
           class="rounded-full px-3 py-1 text-sm ring-1 ring-inset <%= estado === v ? 'bg-indigo-600 text-white ring-indigo-600' : 'bg-white text-slate-600 ring-slate-300 hover:bg-slate-50' %>">
          <%= t %> <span class="opacity-70">(<%= conteo[v] %>)</span>
        </a>
      <% }) %>
    </nav>

    <div class="mt-4 tabla-contenedor">
      <% if (usuarios.length === 0) { %>
        <div class="vacio"><%- icono('users-round', 'h-6 w-6 text-slate-300') %><%= estado === 'activos' ? 'No hay usuarios activos.' : 'No hay usuarios desactivados.' %></div>
      <% } else { %>
        <table class="tabla">
          <thead>
            <tr>
              <th>Usuario</th>
              <th>Cargo</th>
              <th>Rol</th>
              <th>Sistemas</th>
              <th>Políticas pendientes</th>
            </tr>
          </thead>
          <tbody>
            <% usuarios.forEach((u) => { %>
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3">
                  <a href="/usuarios/<%= u.id %>/editar" class="enlace-registro"><%= u.nombre %></a>
                  <% if (u.id === user.id) { %><span class="ml-1 text-xs text-slate-400">(tú)</span><% } %>
                  <span class="block text-xs text-slate-500"><%= u.email %></span>
                </td>
                <td class="px-4 py-3 text-slate-600"><%= u.cargo || '—' %></td>
                <td class="px-4 py-3">
                  <span class="badge <%= u.rol === 'ADMIN' ? 'bg-marca-50 text-indigo-700 ring-indigo-600/15' : 'bg-slate-50 text-slate-600 ring-slate-500/20' %>"><%= roles[u.rol] %></span>
                </td>
                <td class="px-4 py-3">
                  <% if (u.sistemas.length) { %>
                    <div class="flex max-w-xs flex-wrap gap-1">
                      <% u.sistemas.forEach((s) => { %>
                        <a href="/sistemas/<%= s.sistema.id %>" class="inline-flex items-center gap-1 rounded-md bg-slate-100 px-1.5 py-0.5 text-[11px] font-medium text-slate-700 hover:bg-slate-200"><%- icono('server', 'h-3 w-3 text-slate-400') %><%= s.sistema.nombre %></a>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <span class="text-xs text-slate-400">Ninguno · solo políticas generales</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if (u.pendientes === null) { %>
                    <span class="text-xs text-slate-400">—</span>
                  <% } else if (u.pendientes) { %>
                    <span class="inline-flex items-center gap-1 text-sm font-semibold text-amber-700"><%- icono('circle-alert', 'h-3.5 w-3.5') %><%= u.pendientes %></span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 text-sm text-emerald-700"><%- icono('circle-check', 'h-3.5 w-3.5') %>Al día</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
    <p class="mt-3 text-xs text-slate-500">Las políticas generales las deben aceptar todos los usuarios activos; las de un sistema, solo los usuarios asignados a él. Un usuario desactivado no puede entrar ni cuenta en las aceptaciones.</p>
  </main>
  <%- include('../partials/pie') %>
</body>
</html>
