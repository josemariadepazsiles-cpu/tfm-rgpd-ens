// La URL de conexión (DATABASE_URL del .env) se configura en prisma.config.js

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Bases de licitud del art. 6.1 RGPD
enum BaseLegal {
  CONSENTIMIENTO
  CONTRATO
  OBLIGACION_LEGAL
  INTERES_VITAL
  INTERES_PUBLICO
  INTERES_LEGITIMO
}

enum Probabilidad {
  BAJA
  MEDIA
  ALTA
}

enum Impacto {
  BAJO
  MEDIO
  ALTO
}

// Calculado a partir de probabilidad x impacto (ver lib/riesgo.js)
enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
}

// Categoría del sistema según el ENS (RD 311/2022)
enum CategoriaEns {
  BAJA
  MEDIA
  ALTA
}

enum EstadoControl {
  IMPLEMENTADO
  PENDIENTE
  NO_APLICA
}

enum Rol {
  ADMIN
  USUARIO
}

model Usuario {
  id            Int     @id @default(autoincrement())
  nombre        String
  email         String  @unique
  password_hash String
  rol           Rol     @default(USUARIO)
  area          String?

  actividades ActividadRat[]
  controles   ControlEns[]

  @@map("usuarios")
}

model ActividadRat {
  id                     Int       @id @default(autoincrement())
  nombre                 String
  finalidad              String
  base_legal             BaseLegal
  categorias_datos       String
  categorias_interesados String
  destinatarios          String
  transferencia_intl     Boolean   @default(false)
  pais_transferencia     String?
  plazo_conservacion     String
  medidas_seguridad      String
  usuario_id             Int
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  responsable Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  riesgos     Riesgo[]

  @@index([usuario_id])
  @@map("actividades_rat")
}

model Riesgo {
  id                  Int          @id @default(autoincrement())
  actividad_id        Int
  amenaza             String
  probabilidad        Probabilidad
  impacto             Impacto
  nivel_riesgo        NivelRiesgo
  medidas_mitigadoras String?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  actividad ActividadRat @relation(fields: [actividad_id], references: [id], onDelete: Cascade)

  @@index([actividad_id])
  @@index([nivel_riesgo])
  @@map("riesgos")
}

model ControlEns {
  id             Int           @id @default(autoincrement())
  nombre         String        @unique
  categoria      CategoriaEns
  estado         EstadoControl @default(PENDIENTE)
  evidencia      String?
  responsable_id Int?
  fecha_revision DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  responsable Usuario? @relation(fields: [responsable_id], references: [id], onDelete: SetNull)

  @@index([categoria])
  @@index([responsable_id])
  @@map("controles_ens")
}
