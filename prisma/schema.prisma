// La URL de conexión (DATABASE_URL del .env) se configura en prisma.config.js

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Bases de licitud del art. 6.1 RGPD
enum BaseLegal {
  CONSENTIMIENTO
  CONTRATO
  OBLIGACION_LEGAL
  INTERES_VITAL
  INTERES_PUBLICO
  INTERES_LEGITIMO
}

enum Probabilidad {
  BAJA
  MEDIA
  ALTA
}

enum Impacto {
  BAJO
  MEDIO
  ALTO
}

// Calculado a partir de probabilidad x impacto (ver lib/riesgo.js)
enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
}

// Categoría del sistema según el ENS (RD 311/2022)
enum CategoriaEns {
  BAJA
  MEDIA
  ALTA
}

enum EstadoControl {
  IMPLEMENTADO
  PENDIENTE
  NO_APLICA
}

// Dimensión de seguridad afectada por la brecha (Dictamen 9/2022 EDPB)
enum TipoIncidente {
  CONFIDENCIALIDAD
  INTEGRIDAD
  DISPONIBILIDAD
}

enum GravedadIncidente {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoIncidente {
  ABIERTO
  EN_INVESTIGACION
  CONTENIDO
  NOTIFICADO
  CERRADO
}

// Derechos de los interesados (arts. 15 a 22 RGPD)
enum TipoDerecho {
  ACCESO
  RECTIFICACION
  SUPRESION
  OPOSICION
  LIMITACION
  PORTABILIDAD
}

enum CanalEntrada {
  EMAIL
  FORMULARIO_WEB
  CORREO_POSTAL
  PRESENCIAL
  OTRO
}

enum EstadoSolicitud {
  RECIBIDA
  VERIFICACION_IDENTIDAD
  EN_TRAMITACION
  ESTIMADA
  DENEGADA
  AMPLIADA
}

// Encargados del tratamiento / proveedores (art. 28 RGPD)
enum MecanismoTransferencia {
  NO_APLICA
  CLAUSULAS_TIPO
  DECISION_ADECUACION
  NORMAS_CORPORATIVAS
  OTRO
}

enum NivelEnsProveedor {
  NO_APLICA
  BASICO
  MEDIO
  ALTO
  NO_ACREDITADO
}

enum EstadoProveedor {
  ACTIVO
  EN_REVISION
  BAJA
}

enum TipoDocumentoProveedor {
  CONTRATO
  ANEXO
  CERTIFICADO
  CLAUSULAS_TRANSFERENCIA
  OTRO
}

enum EstadoDeclaracion {
  BORRADOR
  EMITIDA
  SUPERADA
}

// Políticas y documentación normativa de seguridad (ENS, marco organizativo)
enum TipoPolitica {
  POLITICA
  PROCEDIMIENTO
  INSTRUCCION_TECNICA
  NORMATIVA_INTERNA
  OTRO
}

enum EstadoPolitica {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADA
  OBSOLETA
}

// Análisis de Impacto en el Negocio (BIA) y continuidad (ENS, op.cont)
enum CriticidadProceso {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoRevisionBia {
  PENDIENTE_ANALISIS
  ANALIZADO
  REQUIERE_PLAN
  PLAN_DEFINIDO
}

enum TipoPruebaContinuidad {
  SIMULACRO_DOCUMENTAL
  PRUEBA_PARCIAL
  PRUEBA_COMPLETA
}

enum ResultadoPrueba {
  SATISFACTORIO
  CON_INCIDENCIAS
  FALLIDO
}

enum Rol {
  ADMIN
  USUARIO
}

model Usuario {
  id            Int     @id @default(autoincrement())
  nombre        String
  email         String  @unique
  password_hash String
  rol           Rol     @default(USUARIO)
  area          String?

  actividades            ActividadRat[]
  controlesResponsable   EvaluacionControl[]
  evaluacionesCreadas    Evaluacion[]
  cambiosEstado          HistorialEstado[]
  sistemasCreados        Sistema[]
  incidentesResponsable  Incidente[]                 @relation("IncidenteResponsable")
  incidentesCreados      Incidente[]                 @relation("IncidenteCreador")
  cambiosIncidente       HistorialIncidente[]
  solicitudesResponsable SolicitudDerecho[]          @relation("SolicitudResponsable")
  solicitudesCreadas     SolicitudDerecho[]          @relation("SolicitudCreador")
  cambiosSolicitud       HistorialSolicitudDerecho[]
  proveedoresResponsable Proveedor[]                 @relation("ProveedorResponsable")
  proveedoresCreados     Proveedor[]                 @relation("ProveedorCreador")
  documentosSubidos      DocumentoProveedor[]
  declaracionesGeneradas DeclaracionConformidad[]    @relation("DeclaracionGenerador")
  declaracionesEmitidas  DeclaracionConformidad[]    @relation("DeclaracionEmisor")
  politicasAprobadas     Politica[]                  @relation("PoliticaAprobador")
  politicasCreadas       Politica[]                  @relation("PoliticaCreador")
  archivosPoliticas      ArchivoPolitica[]
  aceptacionesPoliticas  AceptacionPolitica[]
  procesosResponsable    ProcesoNegocio[]            @relation("ProcesoResponsable")
  procesosCreados        ProcesoNegocio[]            @relation("ProcesoCreador")
  pruebasContinuidad     PruebaContinuidad[]

  @@map("usuarios")
}

model ActividadRat {
  id                     Int       @id @default(autoincrement())
  nombre                 String
  finalidad              String
  base_legal             BaseLegal
  categorias_datos       String
  categorias_interesados String
  destinatarios          String
  transferencia_intl     Boolean   @default(false)
  pais_transferencia     String?
  plazo_conservacion     String
  medidas_seguridad      String
  usuario_id             Int
  sistema_id             Int?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  responsable Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  riesgos     Riesgo[]
  sistema     Sistema? @relation(fields: [sistema_id], references: [id], onDelete: SetNull)

  @@index([usuario_id])
  @@index([sistema_id])
  @@map("actividades_rat")
}

model Riesgo {
  id                  Int          @id @default(autoincrement())
  actividad_id        Int
  amenaza             String
  probabilidad        Probabilidad
  impacto             Impacto
  nivel_riesgo        NivelRiesgo
  medidas_mitigadoras String?
  sistema_id          Int?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  actividad ActividadRat @relation(fields: [actividad_id], references: [id], onDelete: Cascade)
  sistema   Sistema?     @relation(fields: [sistema_id], references: [id], onDelete: SetNull)

  @@index([actividad_id])
  @@index([nivel_riesgo])
  @@index([sistema_id])
  @@map("riesgos")
}

// Catálogo de controles ENS; se evalúan todos en cada evaluación de cada sistema
model ControlEns {
  id         Int          @id @default(autoincrement())
  nombre     String       @unique
  categoria  CategoriaEns
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  evaluaciones EvaluacionControl[]

  @@index([categoria])
  @@map("controles_ens")
}

// Sistema de información de la organización que se evalúa frente al ENS
model Sistema {
  id                Int           @id @default(autoincrement())
  nombre            String        @unique
  descripcion       String?
  // Clasificación libre: «Aplicación clínica», «Web corporativa», «Sistema de gestión interna»…
  tipo_sistema      String?
  // Categoría ENS del sistema (informativa; todas las evaluaciones incluyen todo el catálogo)
  categoria_general CategoriaEns?
  creado_por_id     Int?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  creado_por    Usuario?                 @relation(fields: [creado_por_id], references: [id], onDelete: SetNull)
  evaluaciones  Evaluacion[]
  declaraciones DeclaracionConformidad[]
  procesos      ProcesoNegocio[]
  // Información RGPD asociada (opcional: lo que no tiene sistema es transversal)
  actividades   ActividadRat[]
  riesgos       Riesgo[]
  incidentes    Incidente[]
  solicitudes   SolicitudDerecho[]

  @@map("sistemas")
}

model Evaluacion {
  id            Int      @id @default(autoincrement())
  sistema_id    Int
  nombre        String
  creado_por_id Int?
  created_at    DateTime @default(now())

  sistema       Sistema                  @relation(fields: [sistema_id], references: [id], onDelete: Cascade)
  creado_por    Usuario?                 @relation(fields: [creado_por_id], references: [id], onDelete: SetNull)
  controles     EvaluacionControl[]
  declaraciones DeclaracionConformidad[]

  @@index([sistema_id])
  @@map("evaluaciones")
}

// Estado de un control dentro de una evaluación. Si no existe la fila, el control está Pendiente
model EvaluacionControl {
  id             Int           @id @default(autoincrement())
  evaluacion_id  Int
  control_id     Int
  estado         EstadoControl @default(PENDIENTE)
  evidencia      String?
  responsable_id Int?
  fecha_revision DateTime?

  evaluacion  Evaluacion        @relation(fields: [evaluacion_id], references: [id], onDelete: Cascade)
  control     ControlEns        @relation(fields: [control_id], references: [id], onDelete: Restrict)
  responsable Usuario?          @relation(fields: [responsable_id], references: [id], onDelete: SetNull)
  historial   HistorialEstado[]

  @@unique([evaluacion_id, control_id])
  @@index([responsable_id])
  @@map("evaluacion_controles")
}

// Registro de cada cambio de estado (trazabilidad)
model HistorialEstado {
  id                    Int           @id @default(autoincrement())
  evaluacion_control_id Int
  estado_anterior       EstadoControl
  estado_nuevo          EstadoControl
  usuario_id            Int?
  fecha                 DateTime      @default(now())

  evaluacionControl EvaluacionControl @relation(fields: [evaluacion_control_id], references: [id], onDelete: Cascade)
  usuario           Usuario?          @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([evaluacion_control_id, fecha])
  @@map("historial_estados")
}

// Incidentes de seguridad y brechas de datos personales (arts. 33 y 34 RGPD)
model Incidente {
  id                              Int               @id @default(autoincrement())
  titulo                          String
  descripcion                     String
  fecha_deteccion                 DateTime
  fecha_ocurrencia                DateTime?
  tipo                            TipoIncidente
  categorias_datos_afectados      String
  numero_afectados_estimado       Int?
  gravedad                        GravedadIncidente
  estado                          EstadoIncidente   @default(ABIERTO)
  medidas_adoptadas               String?
  requiere_notificacion_aepd      Boolean           @default(false)
  fecha_notificacion_aepd         DateTime?
  requiere_notificacion_afectados Boolean           @default(false)
  fecha_notificacion_afectados    DateTime?
  responsable_id                  Int?
  creado_por_id                   Int?
  sistema_id                      Int?
  created_at                      DateTime          @default(now())
  updated_at                      DateTime          @updatedAt

  responsable Usuario?             @relation("IncidenteResponsable", fields: [responsable_id], references: [id], onDelete: SetNull)
  creado_por  Usuario?             @relation("IncidenteCreador", fields: [creado_por_id], references: [id], onDelete: SetNull)
  historial   HistorialIncidente[]
  sistema     Sistema?             @relation(fields: [sistema_id], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([gravedad])
  @@index([responsable_id])
  @@index([sistema_id])
  @@map("incidentes")
}

// Registro de cada cambio de estado de un incidente (trazabilidad)
model HistorialIncidente {
  id              Int             @id @default(autoincrement())
  incidente_id    Int
  estado_anterior EstadoIncidente
  estado_nuevo    EstadoIncidente
  usuario_id      Int?
  fecha           DateTime        @default(now())

  incidente Incidente @relation(fields: [incidente_id], references: [id], onDelete: Cascade)
  usuario   Usuario?  @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([incidente_id, fecha])
  @@map("historial_incidentes")
}

// Solicitudes de ejercicio de derechos de los interesados (art. 12 RGPD)
model SolicitudDerecho {
  id                   Int             @id @default(autoincrement())
  nombre_solicitante   String
  email_solicitante    String
  telefono_solicitante String?
  tipo_derecho         TipoDerecho
  descripcion          String
  canal_entrada        CanalEntrada
  fecha_recepcion      DateTime
  // Calculada: recepción + 1 mes (o + 3 meses si el plazo se amplía), art. 12.3
  fecha_limite         DateTime
  plazo_ampliado       Boolean         @default(false)
  motivo_ampliacion    String?
  estado               EstadoSolicitud @default(RECIBIDA)
  motivo_denegacion    String?
  respuesta_enviada    String?
  fecha_respuesta      DateTime?
  responsable_id       Int?
  creado_por_id        Int?
  // Sistema en el que se ejerce el derecho (vacío si la solicitud es genérica)
  sistema_id           Int?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  responsable Usuario?                    @relation("SolicitudResponsable", fields: [responsable_id], references: [id], onDelete: SetNull)
  creado_por  Usuario?                    @relation("SolicitudCreador", fields: [creado_por_id], references: [id], onDelete: SetNull)
  historial   HistorialSolicitudDerecho[]
  sistema     Sistema?                    @relation(fields: [sistema_id], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([tipo_derecho])
  @@index([fecha_limite])
  @@index([responsable_id])
  @@index([sistema_id])
  @@map("solicitudes_derechos")
}

// Registro de cada cambio de estado de una solicitud (y de la ampliación del plazo)
model HistorialSolicitudDerecho {
  id              Int             @id @default(autoincrement())
  solicitud_id    Int
  estado_anterior EstadoSolicitud
  estado_nuevo    EstadoSolicitud
  // Nota adicional, p. ej. la ampliación del plazo con la nueva fecha límite
  detalle         String?
  usuario_id      Int?
  fecha           DateTime        @default(now())

  solicitud SolicitudDerecho @relation(fields: [solicitud_id], references: [id], onDelete: Cascade)
  usuario   Usuario?         @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([solicitud_id, fecha])
  @@map("historial_solicitudes_derechos")
}

// Encargados del tratamiento: proveedores con acceso a datos personales (art. 28 RGPD)
model Proveedor {
  id                        Int                    @id @default(autoincrement())
  nombre_empresa            String
  cif                       String?
  direccion                 String?
  persona_contacto          String?
  email_contacto            String?
  telefono_contacto         String?
  servicio_prestado         String
  categorias_datos_tratados String
  pais_tratamiento          String
  fuera_ue                  Boolean                @default(false)
  mecanismo_transferencia   MecanismoTransferencia @default(NO_APLICA)
  tiene_contrato_encargado  Boolean                @default(false)
  fecha_firma_contrato      DateTime?
  fecha_revision_contrato   DateTime?
  nivel_cumplimiento_ens    NivelEnsProveedor      @default(NO_APLICA)
  estado                    EstadoProveedor        @default(ACTIVO)
  responsable_id            Int?
  creado_por_id             Int?
  created_at                DateTime               @default(now())
  updated_at                DateTime               @updatedAt

  responsable Usuario?             @relation("ProveedorResponsable", fields: [responsable_id], references: [id], onDelete: SetNull)
  creado_por  Usuario?             @relation("ProveedorCreador", fields: [creado_por_id], references: [id], onDelete: SetNull)
  documentos  DocumentoProveedor[]

  @@index([estado])
  @@index([responsable_id])
  @@map("proveedores")
}

// PDF adjuntos a un proveedor. El archivo se guarda en uploads/ (fuera del repositorio)
model DocumentoProveedor {
  id                      Int                    @id @default(autoincrement())
  proveedor_id            Int
  nombre_documento        String
  tipo_documento          TipoDocumentoProveedor
  // Ruta relativa a la carpeta de subidas, con nombre único generado por el servidor
  ruta_archivo            String                 @unique
  nombre_archivo_original String
  tamano_bytes            Int
  subido_por_id           Int?
  fecha_subida            DateTime               @default(now())

  proveedor  Proveedor @relation(fields: [proveedor_id], references: [id], onDelete: Cascade)
  subido_por Usuario?  @relation(fields: [subido_por_id], references: [id], onDelete: SetNull)

  @@index([proveedor_id])
  @@map("documentos_proveedores")
}

// Declaración de Conformidad ENS: foto fija del checklist de una evaluación del sistema
model DeclaracionConformidad {
  id                             Int               @id @default(autoincrement())
  sistema_id                     Int
  // Nombres congelados al generar/emitir: si luego se renombran o se borran, la declaración no cambia
  sistema_nombre                 String
  generado_por_nombre            String
  emitido_por_nombre             String?
  // Evaluación de la que se tomó la foto (puede borrarse después sin afectar a la declaración)
  evaluacion_id                  Int?
  evaluacion_nombre              String
  categoria_ens                  CategoriaEns
  fecha_generacion               DateTime          @default(now())
  // Implementados / aplicables (sin contar los "No aplicable"), en %
  porcentaje_implementacion      Decimal           @db.Decimal(5, 2)
  numero_controles_total         Int
  numero_controles_implementados Int
  numero_controles_pendientes    Int
  numero_controles_no_aplica     Int
  observaciones                  String?
  estado                         EstadoDeclaracion @default(BORRADOR)
  version                        Int
  generado_por_id                Int?
  emitido_por_id                 Int?
  fecha_emision                  DateTime?
  created_at                     DateTime          @default(now())
  updated_at                     DateTime          @updatedAt

  sistema      Sistema                     @relation(fields: [sistema_id], references: [id], onDelete: Restrict)
  evaluacion   Evaluacion?                 @relation(fields: [evaluacion_id], references: [id], onDelete: SetNull)
  generado_por Usuario?                    @relation("DeclaracionGenerador", fields: [generado_por_id], references: [id], onDelete: SetNull)
  emitido_por  Usuario?                    @relation("DeclaracionEmisor", fields: [emitido_por_id], references: [id], onDelete: SetNull)
  detalles     DetalleDeclaracionControl[]

  @@unique([sistema_id, version])
  @@index([estado])
  @@map("declaraciones_conformidad")
}

// Estado de cada control en el momento de generar la declaración (no cambia después)
model DetalleDeclaracionControl {
  id                Int           @id @default(autoincrement())
  declaracion_id    Int
  control_nombre    String
  control_categoria CategoriaEns
  estado_control    EstadoControl
  responsable       String?
  evidencia         String?
  fecha_revision    DateTime?

  declaracion DeclaracionConformidad @relation(fields: [declaracion_id], references: [id], onDelete: Cascade)

  @@index([declaracion_id])
  @@map("detalles_declaracion_control")
}

// Documento normativo (PSI, procedimientos, instrucciones técnicas, normativas internas)
model Politica {
  id                     Int            @id @default(autoincrement())
  titulo                 String
  tipo_documento         TipoPolitica
  descripcion            String?
  // Versión vigente (la fija quien sube el documento)
  version                String
  estado                 EstadoPolitica @default(BORRADOR)
  fecha_aprobacion       DateTime?
  aprobado_por_id        Int?
  fecha_proxima_revision DateTime?
  requiere_aceptacion    Boolean        @default(false)
  creado_por_id          Int?
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt

  aprobado_por Usuario?             @relation("PoliticaAprobador", fields: [aprobado_por_id], references: [id], onDelete: SetNull)
  creado_por   Usuario?             @relation("PoliticaCreador", fields: [creado_por_id], references: [id], onDelete: SetNull)
  archivos     ArchivoPolitica[]
  aceptaciones AceptacionPolitica[]

  @@index([estado])
  @@map("politicas")
}

// PDF de cada versión de una política; las anteriores quedan como históricas
model ArchivoPolitica {
  id                      Int      @id @default(autoincrement())
  politica_id             Int
  version                 String
  historico               Boolean  @default(false)
  ruta_archivo            String   @unique
  nombre_archivo_original String
  tamano_bytes            Int
  subido_por_id           Int?
  fecha_subida            DateTime @default(now())

  politica   Politica @relation(fields: [politica_id], references: [id], onDelete: Cascade)
  subido_por Usuario? @relation(fields: [subido_por_id], references: [id], onDelete: SetNull)

  @@unique([politica_id, version])
  @@map("archivos_politicas")
}

// Registro de lectura y aceptación de una versión concreta por un usuario
model AceptacionPolitica {
  id               Int      @id @default(autoincrement())
  politica_id      Int
  version_aceptada String
  usuario_id       Int
  fecha_aceptacion DateTime @default(now())

  politica Politica @relation(fields: [politica_id], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([politica_id, version_aceptada, usuario_id])
  @@index([usuario_id])
  @@map("aceptaciones_politicas")
}

// Proceso de negocio evaluado en el BIA
model ProcesoNegocio {
  id                          Int               @id @default(autoincrement())
  sistema_id                  Int?
  nombre                      String
  descripcion                 String?
  departamento_responsable    String
  criticidad                  CriticidadProceso
  // Recovery Time Objective: horas máximas admisibles de interrupción
  rto_horas                   Decimal           @db.Decimal(8, 2)
  // Recovery Point Objective: máxima pérdida de datos admisible, en horas
  rpo_horas                   Decimal           @db.Decimal(8, 2)
  impacto_economico           String?
  impacto_legal_reputacional  String?
  recursos_minimos_necesarios String?
  estrategia_continuidad      String?
  estado_revision             EstadoRevisionBia @default(PENDIENTE_ANALISIS)
  responsable_id              Int?
  fecha_ultimo_analisis       DateTime?
  creado_por_id               Int?
  created_at                  DateTime          @default(now())
  updated_at                  DateTime          @updatedAt

  sistema     Sistema?            @relation(fields: [sistema_id], references: [id], onDelete: SetNull)
  responsable Usuario?            @relation("ProcesoResponsable", fields: [responsable_id], references: [id], onDelete: SetNull)
  creado_por  Usuario?            @relation("ProcesoCreador", fields: [creado_por_id], references: [id], onDelete: SetNull)
  pruebas     PruebaContinuidad[]

  @@index([criticidad])
  @@index([estado_revision])
  @@map("procesos_negocio")
}

// Simulacros y pruebas periódicas del plan de continuidad de un proceso
model PruebaContinuidad {
  id               Int                   @id @default(autoincrement())
  proceso_id       Int
  fecha_prueba     DateTime
  tipo_prueba      TipoPruebaContinuidad
  resultado        ResultadoPrueba
  observaciones    String?
  realizado_por_id Int?
  created_at       DateTime              @default(now())

  proceso       ProcesoNegocio @relation(fields: [proceso_id], references: [id], onDelete: Cascade)
  realizado_por Usuario?       @relation(fields: [realizado_por_id], references: [id], onDelete: SetNull)

  @@index([proceso_id, fecha_prueba])
  @@map("pruebas_continuidad")
}

// Datos de la organización (una sola fila): se muestran en la cabecera de todas las pantallas
model Organizacion {
  id                      Int           @id @default(autoincrement())
  nombre                  String
  cif                     String?
  sector                  String?
  direccion               String?
  codigo_postal           String?
  localidad               String?
  provincia               String?
  telefono                String?
  email                   String?
  web                     String?
  // Categoría ENS global de la organización
  categoria_ens           CategoriaEns?
  dpd_nombre              String?
  dpd_email               String?
  responsable_informacion String?
  responsable_seguridad   String?
  responsable_sistema     String?
  updated_at              DateTime      @updatedAt

  @@map("organizacion")
}
