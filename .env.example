# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# Conexión a PostgreSQL que usa la aplicación (obligatoria). En Neon, la del pooler
# (host con «-pooler»).
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_bd?schema=public"

# Conexión directa para las migraciones de Prisma (opcional). Si no se define, en Neon se
# deriva de DATABASE_URL quitando «-pooler» del host (ver prisma.config.js).
DIRECT_URL=""

# Secreto para firmar la cookie de sesión (obligatoria: sin ella la app no arranca).
# Usa una cadena larga y aleatoria, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="cambia-esto"

# Puerto HTTP (opcional, por defecto 3000)
PORT=3000

# Entorno (opcional). Con «production»: cookie de sesión solo por HTTPS, confianza en el proxy
# y bloqueo de «npm run db:ejemplo» y de «npm test».
NODE_ENV=development

# Carpeta donde se guardan los PDF subidos (opcional, por defecto uploads/ en la raíz)
UPLOADS_DIR=""

# Solo para «npm run seed»: credenciales del administrador inicial.
# Sin SEED_ADMIN_PASSWORD se genera una contraseña aleatoria y se muestra una vez.
SEED_ADMIN_EMAIL="admin@organizacion.es"
SEED_ADMIN_PASSWORD=""

# Solo para «npm test»: dirección de la aplicación en marcha (opcional, por defecto
# http://localhost:3000)
TEST_URL=""
