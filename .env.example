DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_bd?schema=public"
SESSION_SECRET="cambia-esto"
PORT=3000

# Solo para «npm run prisma:seed»: credenciales del administrador inicial.
# Sin SEED_ADMIN_PASSWORD se genera una contraseña aleatoria y se muestra una vez.
SEED_ADMIN_EMAIL="admin@organizacion.es"
SEED_ADMIN_PASSWORD=""
