  "description": "TFM RGPD / ENS",
  "main": "app.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/output.css --watch",
    "start": "node app.js",
    "dev": "node --watch-path=app.js --watch-path=config --watch-path=controllers --watch-path=lib --watch-path=middlewares --watch-path=routes app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "prisma:seed": "prisma db seed",
    "db:copia": "node prisma/copia-seguridad.js",
    "db:restaurar": "node prisma/restaurar-copia.js",
    "db:ejemplo": "node prisma/seed-ejemplo.js",
    "db:descripciones": "node prisma/rellenar-descripciones.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
